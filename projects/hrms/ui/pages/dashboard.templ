package pages

import (
	"fmt"
	"hrms/models"
	"hrms/ui/layouts"
)

templ Dashboard(totalWorkers int, totalScheduled float64, totalPaid float64, recentPayments []models.PaymentRecord) {
	@layouts.MainLayout("Workforce Dashboard", "dashboard", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Dashboard", URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Workforce Dashboard</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Configurable workforce management, compensation structures, and custom deductions</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/workers/new" class="hrms-action-btn">+ Onboard Worker</a>
				<a href="/financials/payments/new" class="hrms-action-btn" style="background: #2d3748;">+ Schedule Payout</a>
			</div>
		</div>

		<div class="hrms-card-grid">
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Active Workers</div>
				<div style="font-size: 26px; font-weight: 700; color: #fff; margin-top: 8px;">{ fmt.Sprintf("%d", totalWorkers) }</div>
				<div style="font-size: 12px; color: #a29bfe; margin-top: 4px;">Across all employment arrangements</div>
			</div>
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Pending / Scheduled Liabilities</div>
				<div style="font-size: 26px; font-weight: 700; color: #fab1a0; margin-top: 8px;">${ fmt.Sprintf("%.2f", totalScheduled) }</div>
				<div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Awaiting dispatch to Finance</div>
			</div>
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Settled Payouts</div>
				<div style="font-size: 26px; font-weight: 700; color: #00b894; margin-top: 8px;">${ fmt.Sprintf("%.2f", totalPaid) }</div>
				<div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Disbursed through Finance OS</div>
			</div>
		</div>

		<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
				<h2 style="font-size: 16px; font-weight: 600; color: #fff;">Recent Worker Payouts</h2>
				<a href="/financials/payments" style="font-size: 12px; color: #a29bfe; text-decoration: none;">View All Payouts &rarr;</a>
			</div>
			<table class="hrms-table">
				<thead>
					<tr>
						<th>Worker</th>
						<th>Employment Type</th>
						<th>Pay Model</th>
						<th>Gross Amount</th>
						<th>Deductions</th>
						<th>Net Payable</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range recentPayments {
						<tr>
							<td><strong style="color: #fff;">{ p.WorkerName }</strong></td>
							<td><span class="hrms-badge-pill hrms-badge-contract">{ p.EmploymentType }</span></td>
							<td>{ p.PayType }</td>
							<td>${ fmt.Sprintf("%.2f", p.GrossAmount) }</td>
							<td>
								if len(p.Deductions) > 0 {
									<div style="display: flex; gap: 4px; flex-wrap: wrap;">
										for _, d := range p.Deductions {
											<span class="hrms-tag-pill" style={ fmt.Sprintf("border-color: %s;", d.CategoryColor) }>
												{ d.CategoryName }: -${ fmt.Sprintf("%.2f", d.Amount) }
											</span>
										}
									</div>
								} else {
									<span style="color: var(--text-muted);">-</span>
								}
							</td>
							<td><strong style="color: #00b894;">${ fmt.Sprintf("%.2f", p.NetPayable) }</strong></td>
							<td>
								if p.Status == "paid" {
									<span class="hrms-badge-pill hrms-badge-paid">PAID</span>
								} else {
									<span class="hrms-badge-pill hrms-badge-pending">SCHEDULED</span>
								}
							</td>
						</tr>
					}
					if len(recentPayments) == 0 {
						<tr>
							<td colspan="7" style="text-align: center; color: var(--text-muted); padding: 24px;">No payment records found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

