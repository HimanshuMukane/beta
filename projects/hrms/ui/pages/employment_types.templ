package pages

import (
	"hrms/models"
	"hrms/ui/layouts"
)

templ EmploymentTypesManager(types []models.EmploymentType) {
	@layouts.MainLayout("Employment Types", "employment_types", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Workforce", URL: "/workers"},
		{Label: "Employment Types", URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Configurable Employment Types</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Standard arrangements and custom employment types</p>
			</div>
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
			<!-- Types Table -->
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
				<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 12px;">Active Arrangements</h2>
				<table class="hrms-table">
					<thead>
						<tr>
							<th>Type Name</th>
							<th>Code</th>
							<th>Description</th>
							<th>Type Origin</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range types {
							<tr>
								<td><strong style="color: #fff;">{ t.Name }</strong></td>
								<td><code>{ t.Code }</code></td>
								<td style="color: var(--text-muted); font-size: 12px;">{ t.Description }</td>
								<td>
									if t.IsCustom {
										<span class="hrms-badge-pill hrms-badge-probation">Custom</span>
									} else {
										<span class="hrms-badge-pill hrms-badge-contract">Standard</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<!-- Add Custom Type Form -->
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px; height: fit-content;">
				<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 6px;">Add Custom Type</h2>
				<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 16px;">Define a customized worker engagement type.</p>

				<form method="POST" action="/employment-types/new">
					<div class="hrms-form-group" style="margin-bottom: 14px;">
						<label for="name">Type Name *</label>
						<input type="text" id="name" name="name" placeholder="e.g. Executive Advisor, Seasonal Fellow" required/>
					</div>
					<div class="hrms-form-group" style="margin-bottom: 14px;">
						<label for="code">System Code *</label>
						<input type="text" id="code" name="code" placeholder="e.g. executive_advisor" required/>
					</div>
					<div class="hrms-form-group" style="margin-bottom: 18px;">
						<label for="description">Description</label>
						<input type="text" id="description" name="description" placeholder="Brief explanation of terms"/>
					</div>
					<button type="submit" class="hrms-action-btn" style="width: 100%; justify-content: center;">+ Save Custom Type</button>
				</form>
			</div>
		</div>
	}
}

