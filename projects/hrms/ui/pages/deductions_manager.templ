package pages

import (
	"fmt"
	"hrms/models"
	"hrms/ui/layouts"
)

templ DeductionsManager(categories []models.DeductionCategory) {
	@layouts.MainLayout("Deduction Categories", "deductions", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Financial Management", URL: "/financials"},
		{Label: "Deduction Categories", URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Custom Deduction Categories & Tags</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Reusable deduction tags across employees, contractors, and all employment types</p>
			</div>
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
			<!-- Existing Categories List -->
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
				<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 12px;">Active Deduction Tags</h2>
				<table class="hrms-table">
					<thead>
						<tr>
							<th>Tag / Category</th>
							<th>Description</th>
							<th>Usage Count</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range categories {
							<tr>
								<td>
									<span class="hrms-tag-pill" style={ fmt.Sprintf("border-color: %s;", c.Color) }>
										{ c.Name }
									</span>
								</td>
								<td style="color: var(--text-muted); font-size: 12px;">{ c.Description }</td>
								<td><strong style="color: #fff;">{ fmt.Sprintf("%d payments", c.UsageCount) }</strong></td>
							</tr>
						}
						if len(categories) == 0 {
							<tr>
								<td colspan="3" style="text-align: center; color: var(--text-muted); padding: 20px;">No deduction categories created yet. Create your first category on the right!</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<!-- Add Category Form -->
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px; height: fit-content;">
				<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 6px;">Create Deduction Category</h2>
				<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 16px;">Categories are immediately reusable on all worker payouts and serve as filters.</p>

				<form method="POST" action="/financials/deductions/new">
					<div class="hrms-form-group" style="margin-bottom: 14px;">
						<label for="name">Category Name *</label>
						<input type="text" id="name" name="name" placeholder="e.g. Sales Commission, Advance, Tooling Fee" required/>
					</div>
					<div class="hrms-form-group" style="margin-bottom: 14px;">
						<label for="description">Description</label>
						<input type="text" id="description" name="description" placeholder="Purpose of this deduction"/>
					</div>
					<div class="hrms-form-group" style="margin-bottom: 18px;">
						<label for="color">Tag Accent Color</label>
						<select id="color" name="color">
							<option value="#6c5ce7">Purple (#6c5ce7)</option>
							<option value="#0984e3">Blue (#0984e3)</option>
							<option value="#00b894">Green (#00b894)</option>
							<option value="#e17055">Orange (#e17055)</option>
							<option value="#fdcb6e">Yellow (#fdcb6e)</option>
							<option value="#d63031">Red (#d63031)</option>
						</select>
					</div>
					<button type="submit" class="hrms-action-btn" style="width: 100%; justify-content: center;">+ Add Reusable Tag</button>
				</form>
			</div>
		</div>
	}
}

