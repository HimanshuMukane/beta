package pages

import (
	"fmt"
	"hrms/models"
	"hrms/ui/layouts"
)

templ WorkerDetail(w *models.Worker, comp *models.CompensationProfile, payments []models.PaymentRecord) {
	@layouts.MainLayout(w.FullName+" - Profile", "workers", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Workers Directory", URL: "/workers"},
		{Label: w.FullName, URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">{ w.FullName }</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">{ w.Role } &bull; { w.Department } &bull; <span class="hrms-badge-pill hrms-badge-contract">{ w.EmploymentTypeName }</span></p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href={ templ.SafeURL("/financials/payments/new?worker_id=" + w.ID) } class="hrms-action-btn">+ Record Payment</a>
			</div>
		</div>

		<div class="hrms-card-grid">
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
				<h3 style="font-size: 14px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 12px;">Contact Information</h3>
				<div style="font-size: 13px; margin-bottom: 8px;"><strong style="color: #fff;">Email:</strong> { w.Email }</div>
				<div style="font-size: 13px; margin-bottom: 8px;"><strong style="color: #fff;">Phone:</strong> { w.Phone }</div>
				<div style="font-size: 13px;"><strong style="color: #fff;">Status:</strong> <span class="hrms-badge-pill hrms-badge-active">{ w.Status }</span></div>
			</div>

			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
				<h3 style="font-size: 14px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 12px;">Configured Compensation</h3>
				if comp != nil {
					<div style="font-size: 13px; margin-bottom: 8px;"><strong style="color: #fff;">Model:</strong> { comp.PayType }</div>
					<div style="font-size: 13px; margin-bottom: 8px;"><strong style="color: #fff;">Rate:</strong> ${ fmt.Sprintf("%.2f", comp.BaseRate) } ({ comp.RecurringFrequency })</div>
					<div style="font-size: 13px;"><strong style="color: #fff;">Payout Details:</strong> { comp.PaymentDetails }</div>
				} else {
					<div style="font-size: 13px; color: var(--text-muted); margin-bottom: 12px;">No compensation profile assigned yet.</div>
				}
			</div>
		</div>

		<!-- Compensation Configuration Form -->
		<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px; margin-bottom: 24px;">
			<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px;">Update Compensation Structure</h2>
			<form method="POST" action="/workers/compensation">
				<input type="hidden" name="worker_id" value={ w.ID }/>
				<div class="hrms-form-grid">
					<div class="hrms-form-group">
						<label for="pay_type">Payment Structure *</label>
						<select id="pay_type" name="pay_type" required>
							<option value="fixed_salary">Fixed Monthly Salary</option>
							<option value="hourly">Hourly Payments</option>
							<option value="daily">Daily Wages</option>
							<option value="milestone">Milestone-Based Payments</option>
							<option value="one_time">One-Time / Task Payment</option>
							<option value="recurring">Recurring Retainer</option>
						</select>
					</div>
					<div class="hrms-form-group">
						<label for="recurring_frequency">Payment Frequency *</label>
						<select id="recurring_frequency" name="recurring_frequency">
							<option value="monthly">Monthly</option>
							<option value="quarterly">Quarterly</option>
							<option value="yearly">Yearly</option>
							<option value="per_milestone">Per Milestone / Completion</option>
						</select>
					</div>
					<div class="hrms-form-group">
						<label for="base_rate">Base Rate / Amount ($) *</label>
						<input type="number" step="0.01" id="base_rate" name="base_rate" placeholder="5000.00" required/>
					</div>
					<div class="hrms-form-group">
						<label for="payment_details">Payment / Bank Route Notes</label>
						<input type="text" id="payment_details" name="payment_details" placeholder="e.g. Wire routing, PayPal, or IBAN"/>
					</div>
				</div>
				<div style="display: flex; justify-content: flex-end;">
					<button type="submit" class="hrms-action-btn">Save Compensation Setup</button>
				</div>
			</form>
		</div>

		<!-- Payment History for this worker -->
		<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
			<h2 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 12px;">Payment & Deduction History</h2>
			<table class="hrms-table">
				<thead>
					<tr>
						<th>Period</th>
						<th>Pay Model</th>
						<th>Gross Amount</th>
						<th>Deduction Tags Applied</th>
						<th>Net Payable</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range payments {
						<tr>
							<td><strong style="color: #fff;">{ p.Period }</strong></td>
							<td>{ p.PayType }</td>
							<td>${ fmt.Sprintf("%.2f", p.GrossAmount) }</td>
							<td>
								if len(p.Deductions) > 0 {
									<div style="display: flex; gap: 4px; flex-wrap: wrap;">
										for _, d := range p.Deductions {
											<span class="hrms-tag-pill" style={ fmt.Sprintf("border-color: %s;", d.CategoryColor) }>
												{ d.CategoryName }: -${ fmt.Sprintf("%.2f", d.Amount) }
											</span>
										}
									</div>
								} else {
									<span style="color: var(--text-muted);">-</span>
								}
							</td>
							<td><strong style="color: #00b894;">${ fmt.Sprintf("%.2f", p.NetPayable) }</strong></td>
							<td>
								if p.Status == "paid" {
									<span class="hrms-badge-pill hrms-badge-paid">PAID</span>
								} else {
									<span class="hrms-badge-pill hrms-badge-pending">SCHEDULED</span>
								}
							</td>
						</tr>
					}
					if len(payments) == 0 {
						<tr>
							<td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">No payment records for this worker.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

