package pages

import (
	"hrms/models"
	"hrms/ui/layouts"
)

templ WorkersList(workers []models.Worker, selectedType string, employmentTypes []models.EmploymentType) {
	@layouts.MainLayout("Workers Directory", "workers", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Workers Directory", URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Workers Directory</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Employees, freelancers, contractors, interns, consultants, and custom workers</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/workers/new" class="hrms-action-btn">+ Onboard Worker</a>
			</div>
		</div>

		<div style="display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; padding-bottom: 4px;">
			<a href="/workers" class={ "hrms-tag-pill", templ.KV("active", selectedType == "") }>All Types</a>
			for _, t := range employmentTypes {
				<a href={ templ.SafeURL("/workers?type=" + t.Code) } class={ "hrms-tag-pill", templ.KV("active", selectedType == t.Code) }>
					{ t.Name }
				</a>
			}
		</div>

		<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
			<table class="hrms-table">
				<thead>
					<tr>
						<th>Full Name</th>
						<th>Department</th>
						<th>Role</th>
						<th>Employment Type</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, w := range workers {
						<tr>
							<td>
								<div style="font-weight: 600; color: #fff;">{ w.FullName }</div>
								<div style="font-size: 12px; color: var(--text-muted);">{ w.Email }</div>
							</td>
							<td>{ w.Department }</td>
							<td>{ w.Role }</td>
							<td>
								<span class="hrms-badge-pill hrms-badge-contract">{ w.EmploymentTypeName }</span>
							</td>
							<td>
								<span class="hrms-badge-pill hrms-badge-active">{ w.Status }</span>
							</td>
							<td>
								<div style="display: flex; gap: 6px;">
									<a href={ templ.SafeURL("/workers/detail?id=" + w.ID) } style="color: #a29bfe; font-size: 12px; text-decoration: none;">Profile &rarr;</a>
									<a href={ templ.SafeURL("/financials/payments/new?worker_id=" + w.ID) } style="color: #00b894; font-size: 12px; text-decoration: none;">Pay &rarr;</a>
								</div>
							</td>
						</tr>
					}
					if len(workers) == 0 {
						<tr>
							<td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No workers registered for this employment type.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

