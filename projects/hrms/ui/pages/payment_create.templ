package pages

import (
	"hrms/models"
	"hrms/ui/layouts"
)

templ PaymentCreate(workers []models.Worker, categories []models.DeductionCategory, preselectedWorkerID string) {
	@layouts.MainLayout("Record Worker Payout", "financials", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Financial Management", URL: "/financials"},
		{Label: "Record Payout", URL: ""},
	}) {
		<div style="max-width: 760px; margin: 0 auto; background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 24px;">
			<h1 style="font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 6px;">Schedule / Record Worker Payout</h1>
			<p style="font-size: 13px; color: var(--text-muted); margin-bottom: 24px;">Record compensation and attach custom dynamic deduction categories</p>

			<form method="POST" action="/financials/payments/new">
				<div class="hrms-form-grid">
					<div class="hrms-form-group">
						<label for="worker_id">Worker *</label>
						<select id="worker_id" name="worker_id" required>
							for _, w := range workers {
								<option value={ w.ID } selected?={ w.ID == preselectedWorkerID }>
									{ w.FullName } ({ w.EmploymentTypeName } - { w.Department })
								</option>
							}
						</select>
					</div>

					<div class="hrms-form-group">
						<label for="period">Pay Period *</label>
						<input type="text" id="period" name="period" placeholder="e.g. 2026-11" value="2026-11" required/>
					</div>

					<div class="hrms-form-group">
						<label for="pay_type">Payment Type *</label>
						<select id="pay_type" name="pay_type" required>
							<option value="Fixed Monthly Salary">Fixed Monthly Salary</option>
							<option value="Hourly Wages">Hourly Wages</option>
							<option value="Daily Wages">Daily Wages</option>
							<option value="Milestone Settlement">Milestone Settlement</option>
							<option value="One-Time Bonus / Fee">One-Time Bonus / Fee</option>
							<option value="Recurring Retainer">Recurring Retainer</option>
						</select>
					</div>

					<div class="hrms-form-group">
						<label for="gross_amount">Gross Compensation Amount ($) *</label>
						<input type="number" step="0.01" id="gross_amount" name="gross_amount" placeholder="e.g. 5000.00" required/>
					</div>
				</div>

				<!-- Custom Deduction Tag Row -->
				<div style="border-top: 1px solid var(--border-subtle); padding-top: 18px; margin-top: 12px; margin-bottom: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; color: #fff; margin-bottom: 4px;">Custom Deduction Tags & Adjustments</h3>
					<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">Attach a deduction or enter a new custom tag name (e.g. Commission, Advance, Penalty)</p>

					<div class="hrms-form-grid">
						<div class="hrms-form-group">
							<label for="deduction_category">Existing Deduction Tag</label>
							<select id="deduction_category" name="deduction_category">
								<option value="">-- None / Select Existing Tag --</option>
								for _, c := range categories {
									<option value={ c.Name }>{ c.Name }</option>
								}
							</select>
						</div>
						<div class="hrms-form-group">
							<label for="custom_tag">Or Create New Custom Tag</label>
							<input type="text" id="custom_tag" name="custom_tag" placeholder="e.g. Milestone Penalty, Commission A"/>
						</div>
						<div class="hrms-form-group">
							<label for="deduction_amount">Deduction Amount ($)</label>
							<input type="number" step="0.01" id="deduction_amount" name="deduction_amount" placeholder="0.00"/>
						</div>
						<div class="hrms-form-group">
							<label for="deduction_notes">Deduction Reason / Notes</label>
							<input type="text" id="deduction_notes" name="deduction_notes" placeholder="e.g. Installment 1 of laptop advance"/>
						</div>
					</div>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 8px;">
					<a href="/financials" class="hrms-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="hrms-action-btn">Save Payment Record</button>
				</div>
			</form>
		</div>
	}
}

