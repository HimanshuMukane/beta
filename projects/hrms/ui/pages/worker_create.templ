package pages

import (
	"hrms/models"
	"hrms/ui/layouts"
)

templ WorkerCreate(employmentTypes []models.EmploymentType) {
	@layouts.MainLayout("Onboard Worker", "workers", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Workers Directory", URL: "/workers"},
		{Label: "Onboard Worker", URL: ""},
	}) {
		<div style="max-width: 720px; margin: 0 auto; background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 24px;">
			<h1 style="font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 6px;">Onboard New Worker</h1>
			<p style="font-size: 13px; color: var(--text-muted); margin-bottom: 24px;">Register staff, freelancer, consultant, intern, or custom worker arrangement</p>

			<form method="POST" action="/workers/new">
				<div class="hrms-form-grid">
					<div class="hrms-form-group">
						<label for="full_name">Full Name *</label>
						<input type="text" id="full_name" name="full_name" placeholder="e.g. Jane Doe" required/>
					</div>
					<div class="hrms-form-group">
						<label for="email">Email Address *</label>
						<input type="email" id="email" name="email" placeholder="e.g. jane@company.com" required/>
					</div>
					<div class="hrms-form-group">
						<label for="phone">Phone Number</label>
						<input type="text" id="phone" name="phone" placeholder="e.g. +1-555-0199"/>
					</div>
					<div class="hrms-form-group">
						<label for="department">Department *</label>
						<input type="text" id="department" name="department" placeholder="e.g. Engineering, Sales, Product" required/>
					</div>
					<div class="hrms-form-group">
						<label for="role">Role / Job Title *</label>
						<input type="text" id="role" name="role" placeholder="e.g. Senior Software Engineer" required/>
					</div>
					<div class="hrms-form-group">
						<label for="employment_type">Employment Arrangement *</label>
						<select id="employment_type" name="employment_type" required>
							for _, t := range employmentTypes {
								<option value={ t.Code }>{ t.Name }</option>
							}
						</select>
					</div>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
					<a href="/workers" class="hrms-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="hrms-action-btn">Save & Onboard</button>
				</div>
			</form>
		</div>
	}
}

