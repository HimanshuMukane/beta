package pages

import (
	"fmt"
	"hrms/models"
	"hrms/ui/layouts"
)

templ FinancialsOverview(totalGross float64, totalDeductions float64, totalNet float64, categories []models.DeductionCategory, payments []models.PaymentRecord, activeTag string) {
	@layouts.MainLayout("Workforce Financials", "financials", []layouts.Breadcrumb{
		{Label: "HRMS", URL: "/"},
		{Label: "Financial Management", URL: ""},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Workforce Financial Management</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Dynamic employee deductions, compensation ledger, payment schedules, and filterable tags</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/financials/payments/new" class="hrms-action-btn">+ Record Payment</a>
				<a href="/financials/deductions" class="hrms-action-btn" style="background: #2d3748;">Manage Deduction Tags</a>
			</div>
		</div>

		<div class="hrms-card-grid">
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Gross Compensation</div>
				<div style="font-size: 26px; font-weight: 700; color: #fff; margin-top: 8px;">${ fmt.Sprintf("%.2f", totalGross) }</div>
				<div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Salaries, wages, milestones, and fees</div>
			</div>
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Applied Deductions</div>
				<div style="font-size: 26px; font-weight: 700; color: #e17055; margin-top: 8px;">-${ fmt.Sprintf("%.2f", totalDeductions) }</div>
				<div style="font-size: 12px; color: #fab1a0; margin-top: 4px;">Commissions, advances, penalties, fees</div>
			</div>
			<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Total Net Disbursed / Payable</div>
				<div style="font-size: 26px; font-weight: 700; color: #00b894; margin-top: 8px;">${ fmt.Sprintf("%.2f", totalNet) }</div>
				<div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Effective net payout liabilities</div>
			</div>
		</div>

		<!-- Reusable Tag Filters -->
		<div style="margin-bottom: 20px;">
			<div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 8px;">Filter by Deduction Category / Tag:</div>
			<div style="display: flex; gap: 8px; flex-wrap: wrap;">
				<a href="/financials" class={ "hrms-tag-pill", templ.KV("active", activeTag == "") }>All Records</a>
				for _, c := range categories {
					<a href={ templ.SafeURL("/financials?tag=" + c.Name) } class={ "hrms-tag-pill", templ.KV("active", activeTag == c.Name) } style={ fmt.Sprintf("border-color: %s;", c.Color) }>
						{ c.Name } ({ fmt.Sprintf("%d", c.UsageCount) })
					</a>
				}
			</div>
		</div>

		<!-- Payment Register Table -->
		<div style="background: var(--bg-surface, #1e293b); border: 1px solid var(--border-subtle, #334155); border-radius: 8px; padding: 20px;">
			<table class="hrms-table">
				<thead>
					<tr>
						<th>Worker Name</th>
						<th>Arrangement</th>
						<th>Period</th>
						<th>Gross Amount</th>
						<th>Custom Deduction Tags</th>
						<th>Net Payable</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range payments {
						<tr>
							<td>
								<a href={ templ.SafeURL("/workers/detail?id=" + p.WorkerID) } style="font-weight: 600; color: #fff; text-decoration: none;">{ p.WorkerName }</a>
								<div style="font-size: 11px; color: var(--text-muted);">{ p.PayType }</div>
							</td>
							<td><span class="hrms-badge-pill hrms-badge-contract">{ p.EmploymentType }</span></td>
							<td>{ p.Period }</td>
							<td>${ fmt.Sprintf("%.2f", p.GrossAmount) }</td>
							<td>
								if len(p.Deductions) > 0 {
									<div style="display: flex; gap: 4px; flex-wrap: wrap;">
										for _, d := range p.Deductions {
											<a href={ templ.SafeURL("/financials?tag=" + d.CategoryName) } class="hrms-tag-pill" style={ fmt.Sprintf("border-color: %s;", d.CategoryColor) }>
												{ d.CategoryName }: -${ fmt.Sprintf("%.2f", d.Amount) }
											</a>
										}
									</div>
								} else {
									<span style="color: var(--text-muted);">-</span>
								}
							</td>
							<td><strong style="color: #00b894;">${ fmt.Sprintf("%.2f", p.NetPayable) }</strong></td>
							<td>
								if p.Status == "paid" {
									<span class="hrms-badge-pill hrms-badge-paid">PAID</span>
								} else {
									<span class="hrms-badge-pill hrms-badge-pending">SCHEDULED</span>
								}
							</td>
							<td>
								if p.Status != "paid" {
									<form method="POST" action="/financials/payments/settle" style="display: inline;">
										<input type="hidden" name="payment_id" value={ p.ID }/>
										<button type="submit" style="background: none; border: none; color: #00b894; font-size: 12px; cursor: pointer;">Settle Payout &rarr;</button>
									</form>
								} else {
									<span style="font-size: 12px; color: var(--text-muted);">Settled</span>
								}
							</td>
						</tr>
					}
					if len(payments) == 0 {
						<tr>
							<td colspan="8" style="text-align: center; color: var(--text-muted); padding: 24px;">No payment records found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

