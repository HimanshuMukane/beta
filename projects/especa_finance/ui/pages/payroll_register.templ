package pages

import (
	"especa_finance/models"
	"especa_finance/ui/layouts"
	"core/utils"
)

templ PayrollRegister(period models.PayrollPeriod, records []models.PayrollRecord) {
	@layouts.MainLayout("Payroll Register: "+period.Name, "employees", []layouts.Breadcrumb{{Label: "Employees", URL: "/employees"}, {Label: period.Name}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Payroll Register: { period.Name }</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">{ period.StartDate } to { period.EndDate } | Status: { period.Status }</p>
			</div>
			<div>
				<a href="/employees" class="finance-action-btn" style="background: #2d3748;">← Back to Employees</a>
			</div>
		</div>

		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<table class="finance-table" style="margin-top: 0;">
				<thead>
					<tr>
						<th>Employee</th>
						<th>Department</th>
						<th>Gross Earnings</th>
						<th>Employee Deductions (PF/TDS)</th>
						<th>Net Salary Payable</th>
						<th>Employer Cost (Gross + PF)</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range records {
						<tr>
							<td><strong style="color: #fff;">{ r.EmployeeName }</strong></td>
							<td>{ r.Department }</td>
							<td><strong>{ utils.FormatINR(r.GrossAmountMinor) }</strong></td>
							<td style="color: #e17055;">{ utils.FormatINR(r.EmployeeDeductionsMinor) }</td>
							<td><strong style="color: #00b894;">{ utils.FormatINR(r.NetAmountMinor) }</strong></td>
							<td><strong style="color: #0984e3;">{ utils.FormatINR(r.TotalEmployerCostMinor) }</strong></td>
							<td><span class="finance-badge-pill finance-badge-posted">{ r.Status }</span></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
