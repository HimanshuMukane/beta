package pages

import (
	"especa_finance/models"
	"especa_finance/ui/layouts"
)

templ InvoiceCreate(clients []models.Client, products []models.Product) {
	@layouts.MainLayout("Create Invoice", "invoices", []layouts.Breadcrumb{{Label: "Invoices", URL: "/invoices"}, {Label: "New"}}) {
		<div style="max-width: 650px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Generate Client Invoice</h2>
			<form method="POST" action="/invoices/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Select Client</label>
					<select name="client_id" required>
						<option value="">-- Choose Client --</option>
						for _, c := range clients {
							<option value={ c.ID }>{ c.CompanyName } ({ c.Name })</option>
						}
					</select>
				</div>
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label>Invoice Date</label>
						<input type="date" name="invoice_date" value="2025-01-01" required/>
					</div>
					<div class="finance-form-group">
						<label>Due Date</label>
						<input type="date" name="due_date" value="2025-01-15" required/>
					</div>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Line Item Description</label>
					<input type="text" name="description" placeholder="e.g. Monthly Software License & Maintenance" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Subtotal Amount (in ₹, before GST)</label>
					<input type="number" name="subtotal" placeholder="e.g. 50000" step="1" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Tax Treatment</label>
					<select name="tax_type">
						<option value="gst_18">Standard 18% GST (9% CGST + 9% SGST)</option>
						<option value="none">Zero Tax / Exempt</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 20px;">
					<label>Notes / Payment Terms</label>
					<textarea name="notes" rows="2" placeholder="Bank details, payment instructions..."></textarea>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href="/invoices" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Generate & Post to Accounts Receivable</button>
				</div>
			</form>
		</div>
	}
}
