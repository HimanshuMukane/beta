package pages

import (
	"fmt"
	"especa_finance/ui/layouts"
	"core/utils"
	"ui/components/feedback"
)

type OverviewData struct {
	TotalRevenueMinor   int64
	TotalExpensesMinor  int64
	NetProfitMinor      int64
	MRRMinor            int64
	ARRMinor            int64
	ReceivablesMinor    int64
	PayablesMinor       int64
	PayrollExpenseMinor int64
	ProductCount        int
	EmployeeCount       int
	RecentEntries       []RecentEntry
}

type RecentEntry struct {
	Date        string
	Number      string
	Description string
	AmountMinor int64
	Type        string
}

templ Overview(data OverviewData) {
	@layouts.MainLayout("Overview Dashboard", "overview", []layouts.Breadcrumb{{Label: "Overview"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Financial Overview</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Real-time financial performance, software revenue, and operations</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/invoices/new" class="finance-action-btn">+ New Invoice</a>
				<a href="/products/new" class="finance-action-btn" style="background: #2d3748;">+ Add Product</a>
			</div>
		</div>

		<div class="finance-card-grid">
			@feedback.StatCard("Monthly Recurring Revenue (MRR)", utils.FormatINR(data.MRRMinor), "Active Software", true, "dollar")
			@feedback.StatCard("Annual Recurring Revenue (ARR)", utils.FormatINR(data.ARRMinor), "Run Rate", true, "trending-up")
			@feedback.StatCard("Total Revenue (Accrual)", utils.FormatINR(data.TotalRevenueMinor), "P&L Recognized", true, "chart")
			@feedback.StatCard("Net Profit", utils.FormatINR(data.NetProfitMinor), "Accrual Net", data.NetProfitMinor >= 0, "sparkles")
		</div>

		<div class="finance-card-grid">
			@feedback.StatCard("Outstanding Receivables", utils.FormatINR(data.ReceivablesMinor), "Awaiting Collection", false, "clock")
			@feedback.StatCard("Outstanding Payables", utils.FormatINR(data.PayablesMinor), "Vendor/Taxes Due", false, "target")
			@feedback.StatCard("Total Company Expenses", utils.FormatINR(data.TotalExpensesMinor), "Operating Cost", false, "folder")
			@feedback.StatCard("Monthly Payroll Cost", utils.FormatINR(data.PayrollExpenseMinor), fmt.Sprintf("%d Employees", data.EmployeeCount), true, "users")
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-top: 20px;">
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<h3 style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px;">Recent Journal Postings (Double-Entry Ledger)</h3>
				if len(data.RecentEntries) == 0 {
					<div style="text-align: center; padding: 40px; color: var(--text-muted);">
						No journal postings found. Create an invoice or post journal entries to see activity.
					</div>
				} else {
					<table class="finance-table">
						<thead>
							<tr>
								<th>Date</th>
								<th>Entry #</th>
								<th>Description</th>
								<th>Amount</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							for _, entry := range data.RecentEntries {
								<tr>
									<td>{ entry.Date }</td>
									<td><strong style="color: #74b9ff;">{ entry.Number }</strong></td>
									<td>{ entry.Description }</td>
									<td><strong>{ utils.FormatINR(entry.AmountMinor) }</strong></td>
									<td><span class="finance-badge-pill finance-badge-posted">POSTED</span></td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<h3 style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px;">Quick Shortcuts</h3>
				<div style="display: flex; flex-direction: column; gap: 10px;">
					<a href="/products" style="padding: 10px; background: #141824; border: 1px solid #2d3748; border-radius: 6px; text-decoration: none; color: #fff; display: flex; justify-content: space-between;">
						<span>📦 Software Products</span>
						<span style="color: var(--text-muted);">{ fmt.Sprintf("%d Active", data.ProductCount) } →</span>
					</a>
					<a href="/employees" style="padding: 10px; background: #141824; border: 1px solid #2d3748; border-radius: 6px; text-decoration: none; color: #fff; display: flex; justify-content: space-between;">
						<span>👥 Employees & Contractors</span>
						<span style="color: var(--text-muted);">{ fmt.Sprintf("%d Team", data.EmployeeCount) } →</span>
					</a>
					<a href="/accounting/statements" style="padding: 10px; background: #141824; border: 1px solid #2d3748; border-radius: 6px; text-decoration: none; color: #fff; display: flex; justify-content: space-between;">
						<span>📑 P&L and Balance Sheet</span>
						<span style="color: var(--text-muted);">View Report →</span>
					</a>
					<a href="/templates/products" style="padding: 10px; background: #141824; border: 1px solid #2d3748; border-radius: 6px; text-decoration: none; color: #fff; display: flex; justify-content: space-between;">
						<span>⚙️ Financial Calculation Templates</span>
						<span style="color: var(--text-muted);">Manage →</span>
					</a>
				</div>
			</div>
		</div>
	}
}
