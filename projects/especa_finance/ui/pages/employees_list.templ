package pages

import (
	"fmt"
	"especa_finance/models"
	"especa_finance/ui/layouts"
	"core/utils"
)

templ EmployeesList(employees []models.Employee, payrollPeriods []models.PayrollPeriod) {
	@layouts.MainLayout("Employees & Payroll", "employees", []layouts.Breadcrumb{{Label: "Employees"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Employees & Payroll</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Manage full-time staff, interns, contractors, salary components, and monthly payroll</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/payroll/process" class="finance-action-btn" style="background: #00cec9; color: #000;">⚡ Run Monthly Payroll</a>
				<a href="/employees/new" class="finance-action-btn">+ Add Employee</a>
			</div>
		</div>

		<!-- Employees table -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden; margin-bottom: 25px;">
			<div style="padding: 14px 18px; border-bottom: 1px solid #2d3748; font-weight: 600; color: #fff;">
				Active Staff & Contractors
			</div>
			if len(employees) == 0 {
				<div style="padding: 40px; text-align: center; color: var(--text-muted);">
					No employees added yet. Click "+ Add Employee" to get started.
				</div>
			} else {
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Name & Email</th>
							<th>Designation</th>
							<th>Type</th>
							<th>Department</th>
							<th>Monthly Comp</th>
							<th>Annual Cost</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, emp := range employees {
							<tr>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/employees/detail?id=%s", emp.ID)) } style="color: #fff; font-weight: 600; text-decoration: none;">
										{ emp.Name }
									</a>
									<div style="font-size: 11px; color: var(--text-muted);">{ emp.Email }</div>
								</td>
								<td>{ emp.Designation }</td>
								<td><span class="finance-badge-pill finance-badge-draft">{ emp.EmploymentType }</span></td>
								<td>{ emp.Department }</td>
								<td><strong style="color: #00b894;">{ utils.FormatINR(emp.MonthlyCompensationMinor) }</strong></td>
								<td>{ utils.FormatINR(emp.AnnualCompensationMinor) }</td>
								<td><span class="finance-badge-pill finance-badge-active">{ emp.Status }</span></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/employees/detail?id=%s", emp.ID)) } style="color: #74b9ff; font-size: 12px; text-decoration: none;">Compensation →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<!-- Payroll Periods History -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<div style="padding: 14px 18px; border-bottom: 1px solid #2d3748; font-weight: 600; color: #fff;">
				Processed Payroll Batches
			</div>
			if len(payrollPeriods) == 0 {
				<div style="padding: 30px; text-align: center; color: var(--text-muted);">
					No payroll periods processed yet. Click "Run Monthly Payroll" above to generate this month's payroll.
				</div>
			} else {
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Period Name</th>
							<th>Start Date</th>
							<th>End Date</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, pp := range payrollPeriods {
							<tr>
								<td><strong style="color: #74b9ff;">{ pp.Name }</strong></td>
								<td>{ pp.StartDate }</td>
								<td>{ pp.EndDate }</td>
								<td><span class="finance-badge-pill finance-badge-posted">{ pp.Status }</span></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/payroll/period?id=%s", pp.ID)) } style="color: #00cec9; font-size: 12px; text-decoration: none;">View Register →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}
