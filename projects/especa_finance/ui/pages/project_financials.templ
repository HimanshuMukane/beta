package pages

import (
	"fmt"
	"especa_finance/models"
	"especa_finance/ui/layouts"
	"ui/components/icons"
)

templ ProjectFinancialsList(projects []models.FinanceProject, allTags []models.Tag, selectedTag string) {
	@layouts.MainLayout("Project Financials", "projects_financials", []layouts.Breadcrumb{
		{Label: "Project Financials", URL: "/projects/financials"},
	}) {
		<div class="finance-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 24px; font-weight: 700; color: #fff; margin: 0 0 6px 0;">Project Financials & Profitability</h1>
				<p style="color: #a0aec0; margin: 0; font-size: 14px;">Track project revenue billing models, custom tagged deductions, and net profit margins.</p>
			</div>
			<div style="display: flex; gap: 10px;">
				<a href="/projects/financials/new" class="finance-action-btn" style="background: #0984e3; color: #fff; padding: 10px 16px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
					@icons.IconPlus()
					<span>New Financial Project</span>
				</a>
			</div>
		</div>

		<!-- Tag Filter Pills Bar -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
			<span style="font-size: 12px; font-weight: 700; color: #a0aec0; text-transform: uppercase;">Filter by Deduction Tag:</span>
			if selectedTag == "" {
				<a href="/projects/financials" style="padding: 4px 12px; border-radius: 20px; background: #00cec9; color: #0f141c; font-size: 12px; font-weight: 700; text-decoration: none;">All Projects</a>
			} else {
				<a href="/projects/financials" style="padding: 4px 12px; border-radius: 20px; background: #2d3748; color: #e2e8f0; font-size: 12px; text-decoration: none;">All Projects</a>
			}
			for _, t := range allTags {
				if t.Name == selectedTag {
					<a href="/projects/financials" style="padding: 4px 12px; border-radius: 20px; background: #00cec9; color: #0f141c; font-size: 12px; font-weight: 700; text-decoration: none;">
						#{ t.Name } ✕
					</a>
				} else {
					<a href={ templ.SafeURL(fmt.Sprintf("/projects/financials?tag=%s", t.Name)) } style="padding: 4px 12px; border-radius: 20px; background: #2d3748; color: #e2e8f0; font-size: 12px; text-decoration: none;">
						#{ t.Name }
					</a>
				}
			}
		</div>

		<!-- Projects Table Card -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
				<thead>
					<tr style="background: #171c26; border-bottom: 1px solid #2d3748; color: #a0aec0;">
						<th style="padding: 14px 18px;">Project & Client</th>
						<th style="padding: 14px 18px;">Billing Model</th>
						<th style="padding: 14px 18px; text-align: right;">Gross Revenue</th>
						<th style="padding: 14px 18px; text-align: right;">Tagged Deductions</th>
						<th style="padding: 14px 18px; text-align: right;">Net Profit</th>
						<th style="padding: 14px 18px; text-align: center;">Net Margin</th>
						<th style="padding: 14px 18px;">Active Tags</th>
						<th style="padding: 14px 18px; text-align: right;">Actions</th>
					</tr>
				</thead>
				<tbody>
					if len(projects) == 0 {
						<tr>
							<td colspan="8" style="padding: 36px; text-align: center; color: #a0aec0;">
								No projects found matching the criteria.
							</td>
						</tr>
					}
					for _, p := range projects {
						<tr style="border-bottom: 1px solid #2d3748;">
							<td style="padding: 14px 18px;">
								<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/financials", p.ID)) } style="font-weight: 600; color: #fff; text-decoration: none;">
									{ p.Title }
								</a>
								<div style="font-size: 11px; color: #a0aec0; margin-top: 2px;">{ p.ClientName }</div>
							</td>
							<td style="padding: 14px 18px;">
								if p.BillingType == "one_time" {
									<span style="padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: rgba(9, 132, 227, 0.15); color: #0984e3;">One-Time</span>
								} else if p.BillingType == "recurring" {
									<span style="padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: rgba(0, 206, 201, 0.15); color: #00cec9;">Recurring ({ p.Frequency })</span>
								} else {
									<span style="padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: rgba(108, 92, 231, 0.15); color: #6c5ce7;">Hybrid ({ p.Frequency })</span>
								}
							</td>
							<td style="padding: 14px 18px; text-align: right; font-weight: 600; color: #fff;">
								₹{ fmt.Sprintf("%.2f", float64(p.TotalGrossMinor)/100) }
							</td>
							<td style="padding: 14px 18px; text-align: right; color: #e17055; font-weight: 600;">
								-₹{ fmt.Sprintf("%.2f", float64(p.TotalDeductions)/100) }
							</td>
							<td style="padding: 14px 18px; text-align: right; font-weight: 700; color: #00b894;">
								₹{ fmt.Sprintf("%.2f", float64(p.NetMarginMinor)/100) }
							</td>
							<td style="padding: 14px 18px; text-align: center;">
								<span style="padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; background: rgba(0, 184, 148, 0.15); color: #00b894;">
									{ fmt.Sprintf("%.1f%%", p.NetMarginPercent) }
								</span>
							</td>
							<td style="padding: 14px 18px;">
								<div style="display: flex; gap: 4px; flex-wrap: wrap;">
									for _, tag := range p.DeductionTags {
										<span style="font-size: 10px; padding: 2px 6px; border-radius: 12px; background: #2d3748; color: #e2e8f0;">
											#{ tag }
										</span>
									}
								</div>
							</td>
							<td style="padding: 14px 18px; text-align: right;">
								<div style="display: flex; justify-content: flex-end; gap: 8px;">
									<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/deductions/new", p.ID)) } style="padding: 4px 10px; border-radius: 4px; background: #e17055; color: #fff; font-size: 11px; font-weight: 600; text-decoration: none;">
										+ Deduction
									</a>
									<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/financials", p.ID)) } style="padding: 4px 10px; border-radius: 4px; background: #2d3748; color: #fff; font-size: 11px; text-decoration: none;">
										View
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ ProjectFinancialDetail(project models.FinanceProject, deductions []models.FinanceProjectDeduction, allTags []models.Tag) {
	@layouts.MainLayout(project.Title+" - Financials", "projects_financials", []layouts.Breadcrumb{
		{Label: "Project Financials", URL: "/projects/financials"},
		{Label: project.Title},
	}) {
		<div class="finance-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
			<div>
				<div style="font-size: 12px; color: #a0aec0; text-transform: uppercase; font-weight: 700;">Project Financial Ledger</div>
				<h1 style="font-size: 24px; font-weight: 700; color: #fff; margin: 4px 0 6px 0;">{ project.Title }</h1>
				<p style="color: #a0aec0; margin: 0; font-size: 14px;">Client: { project.ClientName } | Billing Model: { project.BillingType }</p>
			</div>
			<div style="display: flex; gap: 10px;">
				<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/deductions/new", project.ID)) } class="finance-action-btn" style="background: #e17055; color: #fff; padding: 10px 16px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
					@icons.IconPlus()
					<span>Add Project Deduction</span>
				</a>
			</div>
		</div>

		<!-- KPI Metric Cards -->
		<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 24px;">
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Gross Revenue</div>
				<div style="font-size: 22px; font-weight: 700; color: #fff; margin-top: 6px;">₹{ fmt.Sprintf("%.2f", float64(project.TotalGrossMinor)/100) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Total Deductions</div>
				<div style="font-size: 22px; font-weight: 700; color: #e17055; margin-top: 6px;">-₹{ fmt.Sprintf("%.2f", float64(project.TotalDeductions)/100) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Net Project Profit</div>
				<div style="font-size: 22px; font-weight: 700; color: #00b894; margin-top: 6px;">₹{ fmt.Sprintf("%.2f", float64(project.NetMarginMinor)/100) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Net Profit Margin</div>
				<div style="font-size: 22px; font-weight: 700; color: #00cec9; margin-top: 6px;">{ fmt.Sprintf("%.1f%%", project.NetMarginPercent) }</div>
			</div>
		</div>

		<!-- Deductions Section -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden; margin-bottom: 24px;">
			<div style="padding: 16px 20px; border-bottom: 1px solid #2d3748; display: flex; justify-content: space-between; align-items: center;">
				<h2 style="font-size: 16px; font-weight: 700; color: #fff; margin: 0;">Project Deductions & Expenses</h2>
				<span style="font-size: 12px; color: #a0aec0;">{ fmt.Sprintf("%d recorded", len(deductions)) }</span>
			</div>
			<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
				<thead>
					<tr style="background: #171c26; border-bottom: 1px solid #2d3748; color: #a0aec0;">
						<th style="padding: 12px 18px;">Date</th>
						<th style="padding: 12px 18px;">Description</th>
						<th style="padding: 12px 18px;">Payee / Vendor</th>
						<th style="padding: 12px 18px;">Expense Account</th>
						<th style="padding: 12px 18px;">Dynamic Tags</th>
						<th style="padding: 12px 18px; text-align: right;">Amount</th>
					</tr>
				</thead>
				<tbody>
					if len(deductions) == 0 {
						<tr>
							<td colspan="6" style="padding: 30px; text-align: center; color: #a0aec0;">
								No deductions logged for this project yet.
							</td>
						</tr>
					}
					for _, d := range deductions {
						<tr style="border-bottom: 1px solid #2d3748;">
							<td style="padding: 12px 18px; color: #a0aec0;">{ d.DeductionDate }</td>
							<td style="padding: 12px 18px; font-weight: 600; color: #fff;">{ d.Description }</td>
							<td style="padding: 12px 18px; color: #e2e8f0;">{ d.Payee }</td>
							<td style="padding: 12px 18px; color: #a0aec0;">{ d.AccountName }</td>
							<td style="padding: 12px 18px;">
								<div style="display: flex; gap: 4px; flex-wrap: wrap;">
									for _, tag := range d.Tags {
										<span style="font-size: 11px; padding: 2px 8px; border-radius: 12px; background: #2d3748; color: #e2e8f0; border-left: 3px solid #00cec9;">
											#{ tag.Name }
										</span>
									}
								</div>
							</td>
							<td style="padding: 12px 18px; text-align: right; font-weight: 700; color: #e17055;">
								-₹{ fmt.Sprintf("%.2f", float64(d.AmountMinor)/100) }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ ProjectDeductionCreate(project models.FinanceProject, accounts []models.ChartOfAccount, tags []models.Tag) {
	@layouts.MainLayout("Add Project Deduction - "+project.Title, "projects_financials", []layouts.Breadcrumb{
		{Label: "Project Financials", URL: "/projects/financials"},
		{Label: project.Title, URL: fmt.Sprintf("/projects/%s/financials", project.ID)},
		{Label: "Add Deduction"},
	}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 6px;">Add Project Deduction</h2>
			<p style="color: #a0aec0; font-size: 13px; margin: 0 0 20px 0;">Record a custom expense or payout (commission, freelance fee, material) against { project.Title }.</p>

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%s/deductions/new", project.ID)) }>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Description / Purpose</label>
					<input type="text" name="description" placeholder="e.g. Lead Sales Commission or UI Design Contractor" required style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Payee / Beneficiary</label>
						<input type="text" name="payee" placeholder="e.g. John Doe / Studio Acme" required style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					</div>
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Deduction Date</label>
						<input type="date" name="deduction_date" required style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Amount (in ₹)</label>
						<input type="number" name="amount" placeholder="e.g. 15000" step="1" required style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					</div>
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Expense Account (GL)</label>
						<select name="expense_account_id" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;">
							for _, acc := range accounts {
								<option value={ acc.ID }>{ acc.Code } - { acc.Name }</option>
							}
						</select>
					</div>
				</div>

				<div class="finance-form-group" style="margin-bottom: 24px;">
					<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Deduction Tags (comma-separated or on-the-fly)</label>
					<input type="text" name="tags" placeholder="e.g. Commission, Sales-Q1, Freelance" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					<div style="font-size: 11px; color: #718096; margin-top: 4px;">Existing tags will be reused automatically, new tags will be created immediately.</div>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/financials", project.ID)) } style="padding: 10px 16px; border-radius: 6px; background: #2d3748; color: #fff; text-decoration: none; font-weight: 600;">Cancel</a>
					<button type="submit" style="padding: 10px 18px; border-radius: 6px; background: #e17055; color: #fff; border: none; font-weight: 600; cursor: pointer;">Post Deduction</button>
				</div>
			</form>
		</div>
	}
}

templ ProjectCreate(clients []models.Client) {
	@layouts.MainLayout("Create Financial Project", "projects_financials", []layouts.Breadcrumb{
		{Label: "Project Financials", URL: "/projects/financials"},
		{Label: "New Project"},
	}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 6px;">Create Project Financial Workspace</h2>
			<p style="color: #a0aec0; font-size: 13px; margin: 0 0 20px 0;">Configure billing model (one-time, recurring, or hybrid) and revenue profile.</p>

			<form method="POST" action="/projects/financials/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Project Title</label>
					<input type="text" name="title" placeholder="e.g. Enterprise Cloud ERP Migration" required style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
				</div>

				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Client</label>
					<select name="client_id" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;">
						for _, c := range clients {
							<option value={ c.ID }>{ c.Name } ({ c.CompanyName })</option>
						}
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Billing Model</label>
						<select name="billing_type" id="billing_type_select" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;">
							<option value="one_time">One-Time Fee</option>
							<option value="recurring">Recurring Retainer / License</option>
							<option value="hybrid">Hybrid (Upfront + Subscription)</option>
						</select>
					</div>
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Billing Frequency</label>
						<select name="frequency" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;">
							<option value="none">None (One-time)</option>
							<option value="monthly">Monthly</option>
							<option value="quarterly">Quarterly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 24px;">
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Upfront Amount (₹)</label>
						<input type="number" name="upfront_amount" placeholder="0" step="1" value="0" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					</div>
					<div class="finance-form-group">
						<label style="display: block; color: #a0aec0; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Recurring Amount (₹)</label>
						<input type="number" name="recurring_amount" placeholder="0" step="1" value="0" style="width: 100%; padding: 10px; background: #171c26; border: 1px solid #2d3748; border-radius: 6px; color: #fff;"/>
					</div>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href="/projects/financials" style="padding: 10px 16px; border-radius: 6px; background: #2d3748; color: #fff; text-decoration: none; font-weight: 600;">Cancel</a>
					<button type="submit" style="padding: 10px 18px; border-radius: 6px; background: #0984e3; color: #fff; border: none; font-weight: 600; cursor: pointer;">Save Project</button>
				</div>
			</form>
		</div>
	}
}

