package pages

import (
	"especa_finance/ui/layouts"
)

templ ClientCreate() {
	@layouts.MainLayout("Add Client", "clients", []layouts.Breadcrumb{{Label: "Clients", URL: "/clients"}, {Label: "New"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Add New Client Company</h2>
			<form method="POST" action="/clients/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Company Name</label>
					<input type="text" name="company_name" placeholder="e.g. Grand Vista Hotels Ltd" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Contact Person Name</label>
					<input type="text" name="name" placeholder="e.g. Rajesh Sharma" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Email Address</label>
					<input type="email" name="email" placeholder="billing@grandvistahotels.com" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Phone Number</label>
					<input type="text" name="phone" placeholder="+91 9876543210"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>GSTIN (Optional)</label>
					<input type="text" name="gstin" placeholder="27AAACG0000A1Z5"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Billing Address</label>
					<textarea name="billing_address" rows="3" placeholder="Full legal billing address..."></textarea>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
					<a href="/clients" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Save Client</button>
				</div>
			</form>
		</div>
	}
}
