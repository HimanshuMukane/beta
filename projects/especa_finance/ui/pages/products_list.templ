package pages

import (
	"fmt"
	"especa_finance/models"
	"especa_finance/ui/layouts"
	"core/utils"
)

templ ProductsList(products []models.Product) {
	@layouts.MainLayout("Products & Licensing", "products", []layouts.Breadcrumb{{Label: "Products"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Software Products & Offerings</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Manage software licenses, client associations, contracts, and revenue</p>
			</div>
			<div>
				<a href="/products/new" class="finance-action-btn">+ Add Product</a>
			</div>
		</div>

		if len(products) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No products found yet.</p>
				<a href="/products/new" class="finance-action-btn">+ Create First Product</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Code</th>
							<th>Product Name</th>
							<th>Category</th>
							<th>Clients</th>
							<th>MRR</th>
							<th>ARR</th>
							<th>One-Time</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range products {
							<tr>
								<td><strong style="color: #00cec9;">{ p.Code }</strong></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/products/detail?id=%s", p.ID)) } style="color: #fff; font-weight: 600; text-decoration: none;">
										{ p.Name }
									</a>
									<div style="font-size: 11px; color: var(--text-muted);">{ p.Description }</div>
								</td>
								<td><span class="finance-badge-pill finance-badge-draft">{ p.Category }</span></td>
								<td><strong>{ fmt.Sprintf("%d", p.ClientCount) }</strong></td>
								<td><strong style="color: #00b894;">{ utils.FormatINR(p.MonthlyRevenue) }</strong></td>
								<td><strong style="color: #0984e3;">{ utils.FormatINR(p.AnnualRevenue) }</strong></td>
								<td>{ utils.FormatINR(p.OneTimeRevenue) }</td>
								<td><span class="finance-badge-pill finance-badge-active">{ p.Status }</span></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/products/detail?id=%s", p.ID)) } style="color: #74b9ff; font-size: 12px; text-decoration: none;">View Detail →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
