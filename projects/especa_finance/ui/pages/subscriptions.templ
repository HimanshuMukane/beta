package pages

import (
	"fmt"
	"especa_finance/models"
	"especa_finance/ui/layouts"
)

templ SubscriptionsList(subscriptions []models.FinanceSubscription, mrrMinor int64, arrMinor int64) {
	@layouts.MainLayout("Subscriptions & Recurring Billing", "subscriptions", []layouts.Breadcrumb{
		{Label: "Subscriptions", URL: "/subscriptions"},
	}) {
		<div class="finance-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 24px; font-weight: 700; color: #fff; margin: 0 0 6px 0;">Recurring Subscriptions & Retainers</h1>
				<p style="color: #a0aec0; margin: 0; font-size: 14px;">Automated recurring billing profiles across Monthly, Quarterly, and Yearly schedules.</p>
			</div>
		</div>

		<!-- Metrics Bar -->
		<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 24px;">
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Active Subscriptions</div>
				<div style="font-size: 24px; font-weight: 700; color: #fff; margin-top: 6px;">{ fmt.Sprintf("%d", len(subscriptions)) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Monthly Recurring Revenue (MRR)</div>
				<div style="font-size: 24px; font-weight: 700; color: #00cec9; margin-top: 6px;">₹{ fmt.Sprintf("%.2f", float64(mrrMinor)/100) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
				<div style="font-size: 12px; color: #a0aec0; font-weight: 600;">Annual Recurring Revenue (ARR)</div>
				<div style="font-size: 24px; font-weight: 700; color: #00b894; margin-top: 6px;">₹{ fmt.Sprintf("%.2f", float64(arrMinor)/100) }</div>
			</div>
		</div>

		<!-- Table -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
				<thead>
					<tr style="background: #171c26; border-bottom: 1px solid #2d3748; color: #a0aec0;">
						<th style="padding: 14px 18px;">Project & Client</th>
						<th style="padding: 14px 18px;">Frequency</th>
						<th style="padding: 14px 18px; text-align: right;">Amount</th>
						<th style="padding: 14px 18px;">Anchor Date</th>
						<th style="padding: 14px 18px;">Next Billing Date</th>
						<th style="padding: 14px 18px; text-align: center;">Status</th>
					</tr>
				</thead>
				<tbody>
					if len(subscriptions) == 0 {
						<tr>
							<td colspan="6" style="padding: 36px; text-align: center; color: #a0aec0;">
								No recurring subscriptions currently configured.
							</td>
						</tr>
					}
					for _, s := range subscriptions {
						<tr style="border-bottom: 1px solid #2d3748;">
							<td style="padding: 14px 18px;">
								<div style="font-weight: 600; color: #fff;">{ s.ProjectTitle }</div>
								<div style="font-size: 11px; color: #a0aec0; margin-top: 2px;">{ s.ClientName }</div>
							</td>
							<td style="padding: 14px 18px;">
								<span style="padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: rgba(0, 206, 201, 0.15); color: #00cec9; text-transform: capitalize;">
									{ s.Frequency }
								</span>
							</td>
							<td style="padding: 14px 18px; text-align: right; font-weight: 700; color: #fff;">
								₹{ fmt.Sprintf("%.2f", float64(s.AmountMinor)/100) }
							</td>
							<td style="padding: 14px 18px; color: #a0aec0;">{ s.BillingCycleAnchor }</td>
							<td style="padding: 14px 18px; color: #00cec9; font-weight: 600;">{ s.NextBillingDate }</td>
							<td style="padding: 14px 18px; text-align: center;">
								<span style="padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; background: rgba(0, 184, 148, 0.15); color: #00b894; text-transform: uppercase;">
									{ s.Status }
								</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

