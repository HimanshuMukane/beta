package pages

import (
	"especa_finance/ui/layouts"
)

templ EmployeeCreate() {
	@layouts.MainLayout("Add Employee", "employees", []layouts.Breadcrumb{{Label: "Employees", URL: "/employees"}, {Label: "New"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Add New Employee / Contractor</h2>
			<form method="POST" action="/employees/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Full Name</label>
					<input type="text" name="name" placeholder="e.g. Amit Patel" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Email Address</label>
					<input type="email" name="email" placeholder="amit@techcorp.com" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Phone Number</label>
					<input type="text" name="phone" placeholder="+91 9876543210"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Employment Type</label>
					<select name="employment_type">
						<option value="full_time">Full-Time Employee</option>
						<option value="part_time">Part-Time Employee</option>
						<option value="intern">Intern</option>
						<option value="freelancer">Freelancer</option>
						<option value="contractor">Contractor</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Designation</label>
					<input type="text" name="designation" placeholder="e.g. Senior Backend Engineer" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Department</label>
					<input type="text" name="department" placeholder="e.g. Engineering" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Joining Date</label>
					<input type="date" name="joining_date" value="2025-01-01" required/>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
					<a href="/employees" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Save Employee</button>
				</div>
			</form>
		</div>
	}
}
