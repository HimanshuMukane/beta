package layouts

templ DashboardLayout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/globals.css"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<link rel="stylesheet" href="/static/css/dashboard.css"/>
			<script src="/static/js/auth.js"></script>
		</head>
		<body>
			<div class="app-root">
				<div class="app-body">
					<!-- Collapsible Sidebar Matching Reference Exactly -->
					<aside id="sidebar" class="app-sidebar">
						<div class="sidebar-top-section">
							<!-- Workspace Header -->
							<div class="sidebar-brand-row">
								<div class="brand-info">
									<div class="brand-orb"></div>
									<span class="brand-text">Kentucky LLC <span class="brand-dots">···</span></span>
								</div>
							</div>

							<!-- Search Box -->
							<div class="sidebar-search-box" data-tooltip="Search anything..." data-shortcut="/">
								<span class="search-icon">🔍</span>
								<input type="text" placeholder="Search anything..."/>
								<span class="sidebar-search-slash">/</span>
							</div>

							<!-- Nav Menu Items -->
							<nav class="sidebar-nav-list">
								<a class="nav-item" data-tooltip="Dashboard" data-shortcut="⌘ D">
									<div class="nav-item-left">
										<span class="nav-icon">🏠</span>
										<span class="nav-label">Dashboard</span>
									</div>
								</a>

								<a class="nav-item" data-tooltip="Tasks" data-shortcut="⌘ T">
									<div class="nav-item-left">
										<span class="nav-icon">☑️</span>
										<span class="nav-label">Tasks</span>
									</div>
									<span class="nav-arrow">›</span>
								</a>

								<a class="nav-item" data-tooltip="Customers" data-shortcut="⌘ C">
									<div class="nav-item-left">
										<span class="nav-icon">👤</span>
										<span class="nav-label">Customers</span>
									</div>
									<span class="nav-arrow">›</span>
								</a>

								<a class="nav-item active" data-tooltip="Invoices" data-shortcut="⌘ I">
									<div class="nav-item-left">
										<span class="nav-icon" style="color: var(--accent-active-text);">📄</span>
										<span class="nav-label">Invoices</span>
									</div>
								</a>

								<a class="nav-item" data-tooltip="Reports" data-shortcut="⌘ R">
									<div class="nav-item-left">
										<span class="nav-icon">📊</span>
										<span class="nav-label">Reports</span>
									</div>
								</a>

								<div style="height: 10px;"></div>

								<a class="nav-item" data-tooltip="Settings" data-shortcut="⌘ ,">
									<div class="nav-item-left">
										<span class="nav-icon">🎚️</span>
										<span class="nav-label">Settings</span>
									</div>
								</a>

								<a class="nav-item" data-tooltip="Invite users" data-shortcut="⌘ U">
									<div class="nav-item-left">
										<span class="nav-icon">👥+</span>
										<span class="nav-label">Invite users</span>
									</div>
								</a>
							</nav>

							<div class="sidebar-divider"></div>

							<!-- Favorites List -->
							<div class="favorites-section">
								<div class="favorites-header">
									<span>⌄</span>
									<span>Favorites</span>
								</div>

								<div class="sidebar-nav-list" style="margin-top: 4px;">
									<a class="favorite-item" data-tooltip="Nextgen.ai" data-shortcut="">
										<span class="fav-circle" style="background: linear-gradient(135deg, #ff7675, #fab1a0);"></span>
										<span class="favorite-name">Nextgen.ai</span>
									</a>
									<a class="favorite-item" data-tooltip="Stacks.com" data-shortcut="">
										<span class="fav-circle" style="background: linear-gradient(135deg, #74b9ff, #0984e3);"></span>
										<span class="favorite-name">Stacks.com</span>
									</a>
									<a class="favorite-item" data-tooltip="Aether.ai" data-shortcut="">
										<span class="fav-circle" style="background: linear-gradient(135deg, #00cec9, #55efc4);"></span>
										<span class="favorite-name">Aether.ai</span>
									</a>
									<a class="favorite-item" data-tooltip="Cloudchat.com" data-shortcut="">
										<span class="fav-circle" style="background: linear-gradient(135deg, #a8e6cf, #dcedc1);"></span>
										<span class="favorite-name">Cloudchat.com</span>
									</a>
									<a class="favorite-item" data-tooltip="Console.org" data-shortcut="">
										<span class="fav-circle" style="background: linear-gradient(135deg, #ff8b94, #ffaaa5);"></span>
										<span class="favorite-name">Console.org</span>
									</a>
								</div>
							</div>
						</div>

						<!-- Profile Bottom Footer -->
						<div class="sidebar-profile-footer" data-tooltip="Lily Senate" data-shortcut="PRO">
							<div class="profile-left">
								<div class="profile-avatar"></div>
								<span class="profile-name">Lily Senate</span>
								<span class="badge-pro">PRO</span>
							</div>
							<span class="profile-dots">···</span>
						</div>
					</aside>

					<!-- Main Content Area with Top Navbar that adjusts with sidebar width -->
					<main class="main-viewport">
						<!-- Top Navbar: size dynamically adjusts as sidebar expands/collapses -->
						<nav class="top-nav-bar">
							<div class="top-nav-left">
								<!-- Sidebar Toggle on the Left Corner of Navbar -->
								<button id="sidebar-toggle-btn" class="nav-toggle-btn" title="Toggle Sidebar (Expand / Collapse)">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
										<line x1="9" y1="3" x2="9" y2="21"></line>
									</svg>
								</button>

								<!-- Workspace Switcher Pill -->
								<button class="ws-switcher-pill">
									<span class="ws-pill-badge">H</span>
									<span class="ws-pill-text">Himanshu Mukane's Workspace</span>
									<svg class="ws-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="6 9 12 15 18 9"></polyline>
									</svg>
								</button>

								<!-- Panel toggle icon -->
								<button class="super-icon-btn" title="Toggle panels">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
										<line x1="9" y1="3" x2="9" y2="21"></line>
									</svg>
								</button>
							</div>

							<div class="top-nav-right">
								<!-- Icon Actions -->
								<button class="super-action-icon-btn" title="Tasks">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<polyline points="9 12 11 14 15 10"></polyline>
									</svg>
								</button>

								<button class="super-action-icon-btn" title="Meet / Video">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="23 7 16 12 23 17 23 7"></polygon>
										<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
									</svg>
								</button>

								<button class="super-action-icon-btn" title="Notifications / Voice">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
										<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
										<line x1="12" y1="19" x2="12" y2="23"></line>
										<line x1="8" y1="23" x2="16" y2="23"></line>
									</svg>
								</button>

								<!-- User Profile Avatar with Online indicator & dropdown arrow -->
								<div class="super-avatar-wrap">
									<div class="super-avatar">
										<span>HM</span>
										<span class="avatar-status-dot"></span>
									</div>
									<svg class="super-avatar-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="6 9 12 15 18 9"></polyline>
									</svg>
								</div>

								<!-- Global Search Bar with Shortcut -->
								<div class="super-search-box">
									<svg class="super-search-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="11" cy="11" r="8"></circle>
										<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
									</svg>
									<span class="super-search-label">Search</span>
									<kbd class="super-search-kbd">⌘ K</kbd>
								</div>

								<!-- AI Chats Pill Button with 4-color gradient icon -->
								<button class="super-ai-chats-btn">
									<span class="ai-chats-text">AI Chats</span>
									<span class="ai-sparkle-quad">
										<span class="ai-dot ai-dot-1"></span>
										<span class="ai-dot ai-dot-2"></span>
										<span class="ai-dot ai-dot-3"></span>
										<span class="ai-dot ai-dot-4"></span>
									</span>
								</button>
							</div>
						</nav>

						<!-- Subnav Bar: Breadcrumbs & Page Actions (formerly top-nav-bar) -->
						<div class="subnav-bar">
							<div class="subnav-left">
								<!-- Breadcrumb trail -->
								<div class="breadcrumb-trail">
									<span style="color: #74b9ff;">📁</span>
									<span>Especa's Space</span>
									<span style="color: var(--text-dim);">/</span>
									<span>📂 Projects</span>
									<span style="color: var(--text-dim);">/</span>
									<span class="breadcrumb-item-active">
										<span>⚡ Frontend Project</span>
										<span style="font-size: 10px; color: var(--text-dim);">▼</span>
										<span style="color: var(--text-dim); margin-left: 4px;">☆</span>
									</span>
								</div>
							</div>

							<div class="subnav-actions">
								<button id="theme-btn" class="breadcrumb-action-btn" title="Toggle Theme">☀️ Theme</button>
								<button class="breadcrumb-action-btn">👓 Agents</button>
								<button class="breadcrumb-action-btn">⚡ Automate</button>
								<button class="breadcrumb-action-btn">🧠 Brain³</button>
								<button class="breadcrumb-action-btn">🔗 Share</button>
							</div>
						</div>

						<!-- Slot for page contents (views, tables, etc.) -->
						<div class="page-content-viewport">
							{ children... }
						</div>
					</main>
				</div>

				<!-- Floating Tooltip for Collapsed Sidebar Items -->
				<div id="sidebar-tooltip" class="custom-sidebar-tooltip">
					<span id="tooltip-text">Dashboard</span>
					<div id="tooltip-shortcut-container" class="tooltip-kbd-group"></div>
				</div>
			</div>

			<script>
				// Sidebar Toggle (Persisted in localStorage)
				const sidebar = document.getElementById('sidebar');
				const toggleBtn = document.getElementById('sidebar-toggle-btn');
				const tooltip = document.getElementById('sidebar-tooltip');
				const tooltipText = document.getElementById('tooltip-text');
				const tooltipShortcut = document.getElementById('tooltip-shortcut-container');

				const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
				if (isCollapsed) {
					sidebar.classList.add('is-collapsed');
				}

				if (toggleBtn) {
					toggleBtn.addEventListener('click', () => {
						sidebar.classList.toggle('is-collapsed');
						const collapsed = sidebar.classList.contains('is-collapsed');
						localStorage.setItem('sidebar-collapsed', collapsed);
						hideTooltip();
					});
				}

				// Custom Tooltip for Collapsed Mode
				function showTooltip(el, e) {
					if (!sidebar.classList.contains('is-collapsed')) {
						hideTooltip();
						return;
					}
					const title = el.getAttribute('data-tooltip');
					const shortcut = el.getAttribute('data-shortcut');
					if (!title) return;

					tooltipText.textContent = title;
					tooltipShortcut.innerHTML = '';

					if (shortcut) {
						shortcut.split(' ').forEach(k => {
							const kbd = document.createElement('span');
							kbd.className = 'tooltip-kbd';
							kbd.textContent = k;
							tooltipShortcut.appendChild(kbd);
						});
					}

					const rect = el.getBoundingClientRect();
					tooltip.style.left = (rect.right + 10) + 'px';
					tooltip.style.top = (rect.top + (rect.height / 2) - 15) + 'px';
					tooltip.style.display = 'flex';
				}

				function hideTooltip() {
					tooltip.style.display = 'none';
				}

				// Attach tooltip events to items
				const tooltipTargets = document.querySelectorAll('[data-tooltip]');
				tooltipTargets.forEach(el => {
					el.addEventListener('mouseenter', (e) => showTooltip(el, e));
					el.addEventListener('mouseleave', hideTooltip);
				});

				// Theme Toggle (Dark / Light Compatible)
				const themeBtn = document.getElementById('theme-btn');
				const html = document.documentElement;
				const currentTheme = localStorage.getItem('theme') || 'dark';
				html.setAttribute('data-theme', currentTheme);

				if (themeBtn) {
					themeBtn.addEventListener('click', () => {
						const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
						html.setAttribute('data-theme', next);
						localStorage.setItem('theme', next);
						themeBtn.textContent = next === 'dark' ? '☀️ Theme' : '🌙 Theme';
					});
				}
			</script>
		</body>
	</html>
}
