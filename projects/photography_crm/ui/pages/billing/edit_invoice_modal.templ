package pages

templ EditInvoiceModal() {
	<div id="invoice-modal" class="invoice-editor-modal">
		<div class="invoice-editor-card">
			<div class="invoice-editor-header">
				<div style="display: flex; align-items: center; gap: 12px;">
					<button type="button" class="crm-page-btn" onclick="closeInvoiceModal()" style="border-radius: 50%; width: 28px; height: 28px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">←</button>
					<div>
						<h2 style="font-size: 14px; font-weight: 700; margin: 0;">Edit Invoice</h2>
						<p style="font-size: 11px; color: var(--text-muted); margin: 0;">Update and modify existing invoice details.</p>
					</div>
				</div>
				<div style="display: flex; align-items: center; gap: 10px;">
					<div class="ws-switcher-pill" style="padding: 4px 10px; font-size: 12px;">
						<span class="ws-pill-badge" style="background: #1e293b; color: #fff; width: 18px; height: 18px; font-size: 10px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">E</span>
						<span>especia</span>
					</div>
					<div style="display: flex; align-items: center; gap: 4px;">
						<button type="button" class="crm-page-btn" style="font-size: 12px; padding: 5px 10px;">Action ▾</button>
						<button type="button" class="c-btn c-btn-primary" style="padding: 5px 14px; font-size: 12px;" onclick="closeInvoiceModal()">Update</button>
					</div>
				</div>
			</div>

			<div class="invoice-editor-body">

				<div class="invoice-editor-main">
					<div style="display: flex; align-items: center; gap: 8px;">
						<h3 style="font-size: 15px; font-weight: 700; margin: 0;" id="invoice-modal-id"># ESPE/INVOICE/101</h3>
						<button type="button" class="billing-icon-btn" style="padding: 2px;">✏️</button>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
						<div>
							<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Invoice Name <span style="color: #ff6b6b;">*</span></label>
							<input type="text" id="modal-invoice-name" class="crm-search-input" style="width: 100%; font-size: 12px;" value="Invoice - Kavya Rajendran Wedding Wedding"/>
						</div>
						<div>
							<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Invoice Date</label>
							<input type="date" id="modal-invoice-date" class="crm-search-input" style="width: 100%; font-size: 12px;" value="2026-11-01"/>
						</div>
					</div>

					<div class="invoice-section-card">
						<div class="invoice-table-header">
							<div>Service Group &amp; Services</div>
							<div>Qty</div>
							<div>Service Cost</div>
							<div>Sub Total</div>
							<div style="text-align: right;">Actions</div>
						</div>

						<div class="invoice-service-row">
							<div>
								<select class="crm-search-input" style="width: 100%; font-size: 12px;">
									<option>Delivery</option>
									<option>Photography Full Day</option>
									<option>Cinematography Drone</option>
								</select>
							</div>
							<div>
								<input type="number" class="crm-search-input" style="width: 100%; font-size: 12px; padding: 4px;" value="1"/>
							</div>
							<div>
								<span style="font-size: 11px; color: var(--text-muted);">INR</span>
								<input type="number" class="crm-search-input" style="width: 60px; font-size: 12px; padding: 4px; display: inline-block;" value="0"/>
							</div>
							<div style="font-size: 12px; font-weight: 600;">
								INR 0
							</div>
							<div style="text-align: right;">
								<button type="button" class="crm-page-btn" style="font-size: 11px; padding: 3px 8px;">✓ Session Planning</button>
							</div>
						</div>

						<div class="invoice-child-service">
							<div style="display: flex; align-items: center; gap: 8px;">
								<span style="font-size: 12px;">Album 150 pages</span>
								<span class="status-pill pill-gray" style="font-size: 10px;">Custom</span>
							</div>
							<div style="display: flex; align-items: center; gap: 6px;">
								<button type="button" class="stepper-btn">+</button>
								<span style="font-size: 12px; font-weight: 600; min-width: 14px; text-align: center;">1</span>
								<button type="button" class="stepper-btn">−</button>
							</div>
						</div>

						<div class="invoice-child-service">
							<div style="display: flex; align-items: center; gap: 8px;">
								<span style="font-size: 12px;">2 Frame</span>
								<span class="status-pill pill-gray" style="font-size: 10px;">Custom</span>
							</div>
							<div style="display: flex; align-items: center; gap: 6px;">
								<button type="button" class="stepper-btn">+</button>
								<span style="font-size: 12px; font-weight: 600; min-width: 14px; text-align: center;">1</span>
								<button type="button" class="stepper-btn">−</button>
							</div>
						</div>

						<div style="display: flex; gap: 12px; margin-top: 10px;">
							<button type="button" class="crm-page-btn" style="font-size: 11px; color: var(--accent-active-text);">+ Add Service</button>
							<button type="button" class="crm-page-btn" style="font-size: 11px; color: var(--accent-active-text);">+ Add Custom</button>
						</div>
					</div>

					<div class="add-service-group-box">
						+ Add Service Group
					</div>

					<div class="invoice-notes-row">
						<div>
							<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Note</label>
							<textarea class="crm-search-input" style="width: 100%; height: 70px; resize: none; font-size: 12px;" placeholder="Add payment notes, bank reference or terms..."></textarea>

							<div style="margin-top: 12px;">
								<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Payment Due</label>
								<input type="date" class="crm-search-input" style="width: 160px; font-size: 12px;" value="2026-12-01"/>
							</div>
						</div>

						<div class="invoice-totals-section">
							<div>Sub Total: <strong style="font-size: 13px;">₹0</strong></div>
							<div style="color: var(--text-muted);">Percentage(10)%: - ₹0</div>
							<button type="button" class="crm-page-btn" style="font-size: 11px; color: #10b981; border: none; padding: 0;">Add Tax</button>
							<div style="font-size: 15px; font-weight: 700; margin-top: 4px;">Total ₹0</div>

							<div style="margin-top: 14px; border-top: 1px solid var(--border-color); padding-top: 8px; width: 100%; text-align: right;">
								<a href="#" style="font-size: 11px; color: #10b981; text-decoration: none; font-weight: 600;">Make Payment</a>
								<div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Nov 01, 2026 12:00 PM : ₹30,000</div>
								<div style="font-size: 11px; margin-top: 4px;">Paid Amount : <strong>₹30,000</strong></div>
								<div style="font-size: 11px; color: #ff6b6b; margin-top: 2px;">Balance Amount : -₹30,000</div>
							</div>
						</div>
					</div>
				</div>

				<div class="invoice-editor-sidebar">
					<div>
						<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Client Name</label>
						<input type="text" id="modal-client-name" class="crm-search-input" style="width: 100%; font-size: 12px;" value="Kavya Rajendran"/>
					</div>

					<div>
						<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Projects Name</label>
						<input type="text" id="modal-project-name" class="crm-search-input" style="width: 100%; font-size: 12px;" value="Kavya Rajendran Wedding"/>
					</div>

					<div>
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
							<label style="font-size: 11px; font-weight: 600; color: var(--text-muted); margin: 0;">Invoice Template <span style="color: #ff6b6b;">*</span></label>
							<button type="button" class="billing-icon-btn" style="padding: 0;">✏️</button>
						</div>
						<div class="crm-search-input" style="width: 100%; font-size: 12px; background: var(--bg-surface);">
							Standard Invoice - Doc...
						</div>
					</div>

					<div>
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
							<label style="font-size: 11px; font-weight: 600; color: var(--text-muted); margin: 0;">Change Package</label>
							<button type="button" class="billing-icon-btn" style="padding: 0;">✏️</button>
						</div>
						<div class="crm-search-input" style="width: 100%; font-size: 12px; background: var(--bg-surface);">
							Sample Wedding Packa...
						</div>
					</div>

					<div style="margin-top: 8px;">
						<label style="display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: var(--text-main); cursor: pointer;">
							<span>Include Customer Deliverables</span>
							<input type="checkbox" checked style="accent-color: #10b981;"/>
						</label>
					</div>

					<div style="margin-top: 8px; border-top: 1px solid var(--border-color); padding-top: 12px;">
						<label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Share Payment Reminder</label>
						<button type="button" class="c-btn c-btn-primary" style="font-size: 11px; padding: 5px 12px;">Notify</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

