package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

type PaymentRow struct {
	ID            string
	PaymentDate   string
	ClientName    string
	ClientInitials string
	Type          string
	Amount        string
	Status        string
	CreatedOn     string
}

templ Payments() {
	@layouts.DashboardLayout("Billings - Aperture CRM", "billing_payments", []layouts.BreadcrumbItem{
		{Label: "Billing", URL: "/billing"},
		{Label: "Payments"},
	}) {
		<div class="billing-page-container">
			@BillingSubnav("payments")

			<div class="billing-action-bar">
				<div class="billing-action-bar-left">
					<button type="button" class="billing-icon-btn" onclick="togglePaymentFilters()">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="4" y1="6" x2="20" y2="6"></line>
							<line x1="7" y1="12" x2="17" y2="12"></line>
							<line x1="10" y1="18" x2="14" y2="18"></line>
						</svg>
						<span>Filters</span>
					</button>
					<div id="payment-filter-input-wrap" style="display: none;">
						<input type="text" placeholder="Filter payments..." class="crm-search-input" onkeyup="filterPaymentsTable(this.value)" style="height: 28px; font-size: 11px;"/>
					</div>
				</div>

				@ColumnsDropdown()
			</div>

			<div class="crm-table-container">
				<table class="crm-table" id="payments-main-table">
					<thead>
						<tr>
							<th class="col-id">ID</th>
							<th class="col-date">Payment Date</th>
							<th class="col-client">Client name</th>
							<th class="col-type">Type</th>
							<th class="col-amount">Payment Amount</th>
							<th class="col-status">Payment Status</th>
							<th class="col-download" style="text-align: center;">Download</th>
							<th class="col-created">Created On</th>
						</tr>
					</thead>
					<tbody>
						<tr onclick="openInvoiceModal('ESPE/INVOICE/101', 'Kavya Rajendran', '₹30,000')" style="cursor: pointer;">
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">ESPE/INVOICE/101</td>
							<td class="col-date" style="color: var(--text-muted);">Nov 01, 2026 12:00 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #1e3a5f; color: #93c5fd;">KR</span>
									<span style="font-weight: 600; color: var(--text-main);">Kavya Rajendran</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Invoice</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹30,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(254, 240, 199, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">Payment Received</span>
							</td>
							<td class="col-download" style="text-align: center;" onclick="event.stopPropagation();">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;" title="Download receipt">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Nov 01, 2026</td>
						</tr>
						<tr onclick="openInvoiceModal('ESPE/INVOICE/100', 'Kora Fashion Apparel', '₹1,50,000')" style="cursor: pointer;">
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">ESPE/INVOICE/100</td>
							<td class="col-date" style="color: var(--text-muted);">Oct 28, 2026 03:30 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #4a1d96; color: #d8b4fe;">KF</span>
									<span style="font-weight: 600; color: var(--text-main);">Kora Fashion Apparel</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Invoice</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹1,50,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(254, 240, 199, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">Payment Received</span>
							</td>
							<td class="col-download" style="text-align: center;" onclick="event.stopPropagation();">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Oct 28, 2026</td>
						</tr>
						<tr onclick="openInvoiceModal('ESPE/INVOICE/099', 'Olivia & James Thornton', '₹45,000')" style="cursor: pointer;">
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">ESPE/INVOICE/099</td>
							<td class="col-date" style="color: var(--text-muted);">Oct 12, 2026 10:15 AM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #14532d; color: #86efac;">OJ</span>
									<span style="font-weight: 600; color: var(--text-main);">Olivia &amp; James Thornton</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Retainer</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹45,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Settled</span>
							</td>
							<td class="col-download" style="text-align: center;" onclick="event.stopPropagation();">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Oct 12, 2026</td>
						</tr>
					</tbody>
				</table>
				@crmComponents.Pagination(1, 3, 24)
			</div>
		</div>

		@EditInvoiceModal()

		<script>
			function toggleColumnsDropdown(e) {
				e.stopPropagation();
				const menu = document.getElementById('edit-columns-popover');
				if (menu) menu.classList.toggle('is-open');
			}

			function togglePaymentFilters() {
				const wrap = document.getElementById('payment-filter-input-wrap');
				if (wrap) {
					wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
					if (wrap.style.display === 'block') {
						wrap.querySelector('input')?.focus();
					}
				}
			}

			function filterPaymentsTable(val) {
				const term = val.toLowerCase();
				const rows = document.querySelectorAll('#payments-main-table tbody tr');
				rows.forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
				});
			}

			function filterColumnList(val) {
				const term = val.toLowerCase();
				const items = document.querySelectorAll('#column-checkbox-list .column-item');
				items.forEach(item => {
					item.style.display = item.innerText.toLowerCase().includes(term) ? 'flex' : 'none';
				});
			}

			function clearColumnsSelection() {
				const checkboxes = document.querySelectorAll('#column-checkbox-list input[type="checkbox"]');
				checkboxes.forEach(cb => cb.checked = false);
				updateColumnsCount();
			}

			function updateColumnsCount() {
				const checkboxes = document.querySelectorAll('#column-checkbox-list input[type="checkbox"]');
				let checkedCount = 0;
				checkboxes.forEach(cb => { if (cb.checked) checkedCount++; });
				const countEl = document.getElementById('columns-selected-count');
				if (countEl) countEl.innerText = checkedCount + ' Selected';
			}

			function applyColumnsSelection() {
				const checkboxes = document.querySelectorAll('#column-checkbox-list input[type="checkbox"]');
				checkboxes.forEach(cb => {
					const colClass = cb.getAttribute('data-col');
					const els = document.querySelectorAll('.' + colClass);
					els.forEach(el => {
						el.style.display = cb.checked ? '' : 'none';
					});
				});
				document.getElementById('edit-columns-popover')?.classList.remove('is-open');
			}

			document.querySelectorAll('#column-checkbox-list input[type="checkbox"]').forEach(cb => {
				cb.addEventListener('change', updateColumnsCount);
			});

			document.addEventListener('click', function(e) {
				const menu = document.getElementById('edit-columns-popover');
				if (menu && !menu.contains(e.target) && !e.target.closest('.billing-icon-btn')) {
					menu.classList.remove('is-open');
				}
			});

			function exportDataCSV() {
				const rows = Array.from(document.querySelectorAll('#payments-main-table tr'));
				const csv = rows.map(r => Array.from(r.children).map(c => '"' + c.innerText.replace(/"/g, '""') + '"').join(',')).join('\\n');
				const blob = new Blob([csv], { type: 'text/csv' });
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'payments-ledger.csv';
				a.click();
			}

			function openInvoiceModal(id, client, amount) {
				const modal = document.getElementById('invoice-modal');
				if (!modal) return;
				if (id) {
					document.getElementById('invoice-modal-id').innerText = '# ' + id;
				}
				if (client) {
					document.getElementById('modal-client-name').value = client;
					document.getElementById('modal-invoice-name').value = 'Invoice - ' + client + ' Wedding';
					document.getElementById('modal-project-name').value = client + ' Wedding';
				}
				modal.classList.add('is-open');
			}

			function closeInvoiceModal() {
				document.getElementById('invoice-modal')?.classList.remove('is-open');
			}

			document.getElementById('invoice-modal')?.addEventListener('click', function(e) {
				if (e.target === this) {
					closeInvoiceModal();
				}
			});
		</script>
	}
}
