package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ CancelledTransactions() {
	@layouts.DashboardLayout("Cancelled - Aperture CRM", "billing_cancelled", []layouts.BreadcrumbItem{
		{Label: "Billing", URL: "/billing"},
		{Label: "Cancelled"},
	}) {
		<div class="billing-page-container">
			@BillingSubnav("cancelled")

			<div class="billing-action-bar">
				<div class="billing-action-bar-left">
					<button type="button" class="billing-icon-btn" onclick="toggleCancelledFilters()">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="4" y1="6" x2="20" y2="6"></line>
							<line x1="7" y1="12" x2="17" y2="12"></line>
							<line x1="10" y1="18" x2="14" y2="18"></line>
						</svg>
						<span>Filters</span>
					</button>
					<div id="cancelled-filter-input-wrap" style="display: none;">
						<input type="text" placeholder="Filter cancelled..." class="crm-search-input" onkeyup="filterCancelledTable(this.value)" style="height: 28px; font-size: 11px;"/>
					</div>
				</div>

				@ColumnsDropdown()
			</div>

			<div class="crm-table-container">
				<table class="crm-table" id="cancelled-main-table">
					<thead>
						<tr>
							<th class="col-id">ID</th>
							<th class="col-date">Payment Date</th>
							<th class="col-client">Client name</th>
							<th class="col-type">Type</th>
							<th class="col-amount">Payment Amount</th>
							<th class="col-status">Payment Status</th>
							<th class="col-download" style="text-align: center;">Download</th>
							<th class="col-created">Created On</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">TX-9904</td>
							<td class="col-date" style="color: var(--text-muted);">Oct 31, 2026 04:12 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #374151; color: #d1d5db;">AP</span>
									<span style="font-weight: 600; color: var(--text-main);">Arthur Pendelton</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Stripe Intent</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹18,500</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">Failed</span>
							</td>
							<td class="col-download" style="text-align: center;">
								<span style="color: var(--text-dim); font-size: 11px;">—</span>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Oct 31, 2026</td>
						</tr>
						<tr>
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">INV-2026-079</td>
							<td class="col-date" style="color: var(--text-muted);">Sep 12, 2026 01:20 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #1e293b; color: #cbd5e1;">SN</span>
									<span style="font-weight: 600; color: var(--text-main);">Studio Noir Brands</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Voided Invoice</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹21,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3);">Voided</span>
							</td>
							<td class="col-download" style="text-align: center;">
								<span style="color: var(--text-dim); font-size: 11px;">—</span>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Sep 12, 2026</td>
						</tr>
					</tbody>
				</table>
				@crmComponents.Pagination(1, 1, 2)
			</div>
		</div>

		<script>
			function toggleColumnsDropdown(e) {
				e.stopPropagation();
				const menu = document.getElementById('edit-columns-popover');
				if (menu) menu.classList.toggle('is-open');
			}

			function toggleCancelledFilters() {
				const wrap = document.getElementById('cancelled-filter-input-wrap');
				if (wrap) {
					wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
					if (wrap.style.display === 'block') wrap.querySelector('input')?.focus();
				}
			}

			function filterCancelledTable(val) {
				const term = val.toLowerCase();
				const rows = document.querySelectorAll('#cancelled-main-table tbody tr');
				rows.forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
				});
			}

			function exportDataCSV() {
				const rows = Array.from(document.querySelectorAll('#cancelled-main-table tr'));
				const csv = rows.map(r => Array.from(r.children).map(c => '"' + c.innerText.replace(/"/g, '""') + '"').join(',')).join('\\n');
				const blob = new Blob([csv], { type: 'text/csv' });
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'cancelled-transactions.csv';
				a.click();
			}
		</script>
	}
}
