package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ Invoices() {
	@layouts.DashboardLayout("Invoices - Aperture CRM", "billing_invoices", []layouts.BreadcrumbItem{
		{Label: "Billing", URL: "/billing"},
		{Label: "Invoices"},
	}) {
		<div class="billing-page-container">
			@BillingSubnav("invoices")

			<div class="billing-action-bar">
				<div class="billing-action-bar-left">
					<button type="button" class="billing-icon-btn" onclick="toggleInvoiceFilters()">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="4" y1="6" x2="20" y2="6"></line>
							<line x1="7" y1="12" x2="17" y2="12"></line>
							<line x1="10" y1="18" x2="14" y2="18"></line>
						</svg>
						<span>Filters</span>
					</button>
					<div id="invoice-filter-input-wrap" style="display: none;">
						<input type="text" placeholder="Filter invoices..." class="crm-search-input" onkeyup="filterInvoicesTable(this.value)" style="height: 28px; font-size: 11px;"/>
					</div>
					<button type="button" class="c-btn c-btn-primary" style="font-size: 11px; padding: 4px 10px;" onclick="openInvoiceModal('ESPE/INVOICE/102', '', '')">+ New Invoice</button>
				</div>

				@ColumnsDropdown()
			</div>

			<div class="crm-table-container">
				<table class="crm-table" id="invoices-main-table">
					<thead>
						<tr>
							<th class="col-id">ID</th>
							<th class="col-date">Payment Date</th>
							<th class="col-client">Client name</th>
							<th class="col-type">Type</th>
							<th class="col-amount">Payment Amount</th>
							<th class="col-status">Payment Status</th>
							<th class="col-download" style="text-align: center;">Download</th>
							<th class="col-created">Created On</th>
						</tr>
					</thead>
					<tbody>
						<tr onclick="openInvoiceModal('ESPE/INVOICE/101', 'Kavya Rajendran', '₹30,000')" style="cursor: pointer;">
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">ESPE/INVOICE/101</td>
							<td class="col-date" style="color: var(--text-muted);">Nov 01, 2026 12:00 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #1e3a5f; color: #93c5fd;">KR</span>
									<span style="font-weight: 600; color: var(--text-main);">Kavya Rajendran</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Invoice</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹30,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(254, 240, 199, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">Payment Received</span>
							</td>
							<td class="col-download" style="text-align: center;" onclick="event.stopPropagation();">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Nov 01, 2026</td>
						</tr>
						<tr onclick="openInvoiceModal('ESPE/INVOICE/098', 'David Sterling', '₹85,000')" style="cursor: pointer;">
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">ESPE/INVOICE/098</td>
							<td class="col-date" style="color: var(--text-muted);">Oct 01, 2026 11:00 AM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #7f1d1d; color: #fca5a5;">DS</span>
									<span style="font-weight: 600; color: var(--text-main);">David Sterling</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Invoice</td>
							<td class="col-amount" style="font-weight: 600; color: var(--text-main);">₹85,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">Overdue</span>
							</td>
							<td class="col-download" style="text-align: center;" onclick="event.stopPropagation();">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Oct 01, 2026</td>
						</tr>
					</tbody>
				</table>
				@crmComponents.Pagination(1, 2, 18)
			</div>
		</div>

		@EditInvoiceModal()

		<script>
			function toggleColumnsDropdown(e) {
				e.stopPropagation();
				const menu = document.getElementById('edit-columns-popover');
				if (menu) menu.classList.toggle('is-open');
			}

			function toggleInvoiceFilters() {
				const wrap = document.getElementById('invoice-filter-input-wrap');
				if (wrap) {
					wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
					if (wrap.style.display === 'block') wrap.querySelector('input')?.focus();
				}
			}

			function filterInvoicesTable(val) {
				const term = val.toLowerCase();
				const rows = document.querySelectorAll('#invoices-main-table tbody tr');
				rows.forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
				});
			}

			function exportDataCSV() {
				const rows = Array.from(document.querySelectorAll('#invoices-main-table tr'));
				const csv = rows.map(r => Array.from(r.children).map(c => '"' + c.innerText.replace(/"/g, '""') + '"').join(',')).join('\\n');
				const blob = new Blob([csv], { type: 'text/csv' });
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'invoices.csv';
				a.click();
			}

			function openInvoiceModal(id, client, amount) {
				const modal = document.getElementById('invoice-modal');
				if (!modal) return;
				if (id) document.getElementById('invoice-modal-id').innerText = '# ' + id;
				if (client) {
					document.getElementById('modal-client-name').value = client;
					document.getElementById('modal-invoice-name').value = 'Invoice - ' + client + ' Wedding';
					document.getElementById('modal-project-name').value = client + ' Wedding';
				}
				modal.classList.add('is-open');
			}

			function closeInvoiceModal() {
				document.getElementById('invoice-modal')?.classList.remove('is-open');
			}

			document.getElementById('invoice-modal')?.addEventListener('click', function(e) {
				if (e.target === this) closeInvoiceModal();
			});
		</script>
	}
}
