package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ Refunds() {
	@layouts.DashboardLayout("Refunds - Aperture CRM", "billing_refunds", []layouts.BreadcrumbItem{
		{Label: "Billing", URL: "/billing"},
		{Label: "Refunded"},
	}) {
		<div class="billing-page-container">
			@BillingSubnav("refunded")

			<div class="billing-action-bar">
				<div class="billing-action-bar-left">
					<button type="button" class="billing-icon-btn" onclick="toggleRefundsFilters()">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="4" y1="6" x2="20" y2="6"></line>
							<line x1="7" y1="12" x2="17" y2="12"></line>
							<line x1="10" y1="18" x2="14" y2="18"></line>
						</svg>
						<span>Filters</span>
					</button>
					<div id="refunds-filter-input-wrap" style="display: none;">
						<input type="text" placeholder="Filter refunds..." class="crm-search-input" onkeyup="filterRefundsTable(this.value)" style="height: 28px; font-size: 11px;"/>
					</div>
					<button type="button" class="c-btn c-btn-primary" style="font-size: 11px; padding: 4px 10px;">+ Process Refund</button>
				</div>

				@ColumnsDropdown()
			</div>

			<div class="crm-table-container">
				<table class="crm-table" id="refunds-main-table">
					<thead>
						<tr>
							<th class="col-id">ID</th>
							<th class="col-date">Payment Date</th>
							<th class="col-client">Client name</th>
							<th class="col-type">Type</th>
							<th class="col-amount">Payment Amount</th>
							<th class="col-status">Payment Status</th>
							<th class="col-download" style="text-align: center;">Download</th>
							<th class="col-created">Created On</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">REF-2026-004</td>
							<td class="col-date" style="color: var(--text-muted);">Sep 18, 2026 05:40 PM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #1e3a5f; color: #93c5fd;">SW</span>
									<span style="font-weight: 600; color: var(--text-main);">Samantha Wright</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Partial Retainer</td>
							<td class="col-amount" style="font-weight: 600; color: #ff7675;">-₹4,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Processed</span>
							</td>
							<td class="col-download" style="text-align: center;">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Sep 18, 2026</td>
						</tr>
						<tr>
							<td class="col-id" style="font-weight: 700; color: var(--text-main);">REF-2026-003</td>
							<td class="col-date" style="color: var(--text-muted);">Aug 04, 2026 09:15 AM</td>
							<td class="col-client">
								<div style="display: flex; align-items: center; gap: 8px;">
									<span class="client-avatar-badge" style="background: #701a75; color: #f5d0fe;">LG</span>
									<span style="font-weight: 600; color: var(--text-main);">Liam Gallagher</span>
								</div>
							</td>
							<td class="col-type" style="color: var(--text-muted);">Cancellation Refund</td>
							<td class="col-amount" style="font-weight: 600; color: #ff7675;">-₹8,000</td>
							<td class="col-status">
								<span class="status-pill" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Processed</span>
							</td>
							<td class="col-download" style="text-align: center;">
								<button class="crm-page-btn" style="font-size: 11px; padding: 2px 8px;">PDF</button>
							</td>
							<td class="col-created" style="color: var(--text-muted); font-size: 11px;">Aug 04, 2026</td>
						</tr>
					</tbody>
				</table>
				@crmComponents.Pagination(1, 1, 2)
			</div>
		</div>

		<script>
			function toggleColumnsDropdown(e) {
				e.stopPropagation();
				const menu = document.getElementById('edit-columns-popover');
				if (menu) menu.classList.toggle('is-open');
			}

			function toggleRefundsFilters() {
				const wrap = document.getElementById('refunds-filter-input-wrap');
				if (wrap) {
					wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
					if (wrap.style.display === 'block') wrap.querySelector('input')?.focus();
				}
			}

			function filterRefundsTable(val) {
				const term = val.toLowerCase();
				const rows = document.querySelectorAll('#refunds-main-table tbody tr');
				rows.forEach(row => {
					row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
				});
			}

			function exportDataCSV() {
				const rows = Array.from(document.querySelectorAll('#refunds-main-table tr'));
				const csv = rows.map(r => Array.from(r.children).map(c => '"' + c.innerText.replace(/"/g, '""') + '"').join(',')).join('\\n');
				const blob = new Blob([csv], { type: 'text/csv' });
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'refunds.csv';
				a.click();
			}
		</script>
	}
}
