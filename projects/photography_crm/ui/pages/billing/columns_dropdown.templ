package pages

templ ColumnsDropdown() {
	<div class="billing-action-bar-right">
		<button type="button" class="billing-icon-btn" onclick="toggleColumnsDropdown(event)">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
			</svg>
			<span>Edit Columns</span>
		</button>
		<button type="button" class="billing-icon-btn" onclick="exportDataCSV()">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
				<polyline points="7 10 12 15 17 10"></polyline>
				<line x1="12" y1="15" x2="12" y2="3"></line>
			</svg>
			<span>Export</span>
		</button>
		<div id="edit-columns-popover" class="columns-dropdown">
			<div class="columns-search-box">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input type="text" placeholder="Search..." class="columns-search-input" onkeyup="filterColumnList(this.value)"/>
			</div>
			<div class="columns-list" id="column-checkbox-list">
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-id"/> <span>ID</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-date"/> <span>Payment Date</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-client"/> <span>Client name</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-type"/> <span>Type</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-amount"/> <span>Payment Amount</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-status"/> <span>Payment Status</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-download"/> <span>Download</span></label>
				<label class="column-item"><span class="column-drag-handle">⠿</span> <input type="checkbox" checked data-col="col-created"/> <span>Created On</span></label>
			</div>
			<div class="columns-footer">
				<span class="columns-count" id="columns-selected-count">8 Selected</span>
				<button type="button" class="columns-clear-btn" onclick="clearColumnsSelection()">Clear</button>
				<button type="button" class="columns-apply-btn" onclick="applyColumnsSelection()">Apply</button>
			</div>
		</div>
	</div>
}

