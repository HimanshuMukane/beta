package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

templ ClientDetails(id string) {
	@layouts.DashboardLayout("Client Profile - Olivia & James Thornton", "client_details", []layouts.BreadcrumbItem{
		{Label: "Clients", URL: "/clients"},
		{Label: "Olivia & James Thornton"},
	}) {
		@crmComponents.PageHeader("Olivia & James Thornton", "Client since March 2025 • Lifetime Value: $5,800.00") {
			<a href="/orders?action=new&client=Olivia+Thornton" class="c-btn c-btn-primary">
				@components.IconPlus()
				<span>New Order</span>
			</a>
			<a href="/sessions?action=book&client=Olivia+Thornton" class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">
				@components.IconCamera()
				<span>Book Session</span>
			</a>
			<a href="/clients" class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">
				<span>← Clients</span>
			</a>
		}

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
			<div style="display: flex; flex-direction: column; gap: 24px;">

				<div class="crm-table-container" style="padding: 24px;">
					<h3 style="font-size: 15px; font-weight: 600; margin-bottom: 16px;">Contact Information</h3>
					<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Email</div>
							<div style="font-size: 13px; font-weight: 500;">olivia.thornton@gmail.com</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Phone</div>
							<div style="font-size: 13px; font-weight: 500;">+1 (555) 234-9811</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Client Category</div>
							<div style="font-size: 13px; font-weight: 500;"><span class="status-pill pill-purple">Wedding & Couples</span></div>
						</div>
					</div>
				</div>

				<div class="crm-table-container">
					<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
						<h3 style="font-size: 14px; font-weight: 600;">Client Orders & Packages</h3>
						<span style="font-size: 12px; color: var(--text-muted);">2 Orders Total</span>
					</div>
					<table class="crm-table">
						<thead>
							<tr>
								<th>Order ID</th>
								<th>Package / Description</th>
								<th>Date</th>
								<th>Amount</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td style="font-weight: 600;"><a href="/orders/details?id=ORD-942" style="color: var(--accent-active-text); text-decoration: none;">ORD-942</a></td>
								<td>Full Wedding Day Documentation + Album</td>
								<td style="color: var(--text-muted);">Oct 10, 2026</td>
								<td style="font-weight: 600;">$3,400.00</td>
								<td>@crmComponents.StatusPill("Confirmed", "blue")</td>
							</tr>
							<tr>
								<td style="font-weight: 600;"><a href="/orders/details?id=ORD-890" style="color: var(--accent-active-text); text-decoration: none;">ORD-890</a></td>
								<td>Pre-Wedding Golden Hour Portrait Shoot</td>
								<td style="color: var(--text-muted);">Apr 14, 2025</td>
								<td style="font-weight: 600;">$2,400.00</td>
								<td>@crmComponents.StatusPill("Completed", "green")</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<div style="display: flex; flex-direction: column; gap: 16px;">
				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Client Summary</h3>
					<div style="display: flex; flex-direction: column; gap: 12px; font-size: 12.5px;">
						<div style="display: flex; justify-content: space-between;">
							<span style="color: var(--text-muted);">Lead Source</span>
							<span style="font-weight: 500;">Instagram DM</span>
						</div>
						<div style="display: flex; justify-content: space-between;">
							<span style="color: var(--text-muted);">Assigned Lead</span>
							<span style="font-weight: 500;">Himanshu M.</span>
						</div>
						<div style="display: flex; justify-content: space-between;">
							<span style="color: var(--text-muted);">Active Contract</span>
							<span style="color: #00cec9; font-weight: 600;">Signed (Ver 2.1)</span>
						</div>
						<div style="display: flex; justify-content: space-between;">
							<span style="color: var(--text-muted);">Total Shoots</span>
							<span style="font-weight: 600;">2 Booked</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
