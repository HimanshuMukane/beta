package pages

import (
	"chi-mysql-server/ui/layouts"
)

type ProjectRow struct {
	ID             string
	ProjectName    string
	ProjectInitials string
	ClientName     string
	ClientInitials string
	ProjectManager string
	ManagerInitial string
	ProjectType    string
	SessionsCount  int
	TasksDone      int
	TasksProgress  int
	TasksTotal     int
	Deliverables   int
	Status         string
	Stage          string
}

templ Projects(filter string) {
	@layouts.DashboardLayout("Projects - Aperture CRM", "projects", []layouts.BreadcrumbItem{
		{Label: "Projects"},
	}) {
		<div class="projects-layout">

			<div class="projects-toolbar">
				<div class="projects-toolbar-left">

					<div class="projects-view-toggle">
						<button class="projects-view-btn active" type="button" title="List View">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="8" y1="6" x2="21" y2="6"></line>
								<line x1="8" y1="12" x2="21" y2="12"></line>
								<line x1="8" y1="18" x2="21" y2="18"></line>
								<line x1="3" y1="6" x2="3.01" y2="6"></line>
								<line x1="3" y1="12" x2="3.01" y2="12"></line>
								<line x1="3" y1="18" x2="3.01" y2="18"></line>
							</svg>
							<span>List</span>
						</button>
						<button class="projects-view-btn" type="button" title="Board View">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="3" width="7" height="18" rx="1"></rect>
								<rect x="14" y="3" width="7" height="11" rx="1"></rect>
							</svg>
							<span>Board</span>
						</button>
					</div>

					<button class="projects-toolbar-btn" type="button">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
						</svg>
						<span>Filters</span>
					</button>

					<button class="projects-toolbar-btn" type="button">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 20h9"></path>
							<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
						</svg>
						<span>Edit Columns</span>
					</button>

					<button class="projects-toolbar-btn" type="button" title="Search">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
					</button>

					<button class="projects-toolbar-btn" type="button" title="Date Range">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
							<line x1="16" y1="2" x2="16" y2="6"></line>
							<line x1="8" y1="2" x2="8" y2="6"></line>
							<line x1="3" y1="10" x2="21" y2="10"></line>
						</svg>
					</button>
				</div>

				<div class="projects-toolbar-right">
					<div class="projects-count-display">
						<span class="projects-count-num">1</span>
						<span class="projects-count-label">Project Count</span>
					</div>
					<a href="/projects/details?id=new" class="projects-new-btn">New Project</a>
				</div>
			</div>

			<div class="crm-table-container">
				<table class="crm-table">
					<thead>
						<tr>
							<th style="width: 140px;">
								<span style="display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
									ID
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="6 9 12 15 18 9"></polyline>
									</svg>
								</span>
							</th>
							<th>Project Name</th>
							<th>Client Name</th>
							<th>Project Manager</th>
							<th>Project Type</th>
							<th>Sessions</th>
							<th>Tasks</th>
							<th>Deliverables</th>
							<th>Status</th>
							<th>Stage</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="font-weight: 700; color: var(--text-main);">
								<a href="/projects/details?id=ESPE-EVENT-101" style="color: inherit; text-decoration: none;">ESPE/EVENT/101</a>
							</td>
							<td>
								<div class="project-name-cell">
									<span class="project-avatar project-avatar-blue">KW</span>
									<a href="/projects/details?id=ESPE-EVENT-101" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Kavya Rajendran Wedding</a>
								</div>
							</td>
							<td>
								<div class="project-name-cell">
									<span class="project-avatar project-avatar-dark">KR</span>
									<span style="font-weight: 500; color: var(--text-main);">Kavya Rajendran</span>
								</div>
							</td>
							<td>
								<div class="project-manager-cell">
									<span class="project-avatar project-avatar-dark" style="width: 24px; height: 24px; font-size: 10px;">E</span>
									<span style="color: var(--text-main); font-size: 12.5px;">especa</span>
								</div>
							</td>
							<td style="color: var(--text-muted); font-size: 12.5px;">Wedding</td>
							<td style="color: var(--text-main); font-weight: 500; font-size: 12.5px;">2</td>
							<td>
								<div class="project-progress-wrapper">
									<span>0</span>
									<span class="project-progress-pill progress-pill-red">0%</span>
									<span>22</span>
								</div>
							</td>
							<td style="color: var(--text-main); font-weight: 500; font-size: 12.5px;">4</td>
							<td>
								<span class="project-status-pill">New</span>
							</td>
							<td>
								<span class="project-stage-pill">Booked</span>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	}
}
