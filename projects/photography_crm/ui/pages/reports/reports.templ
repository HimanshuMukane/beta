package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

templ Reports() {
	@layouts.DashboardLayout("Studio Analytics & Financial Reports", "reports", []layouts.BreadcrumbItem{
		{Label: "Reports"},
	}) {
		@crmComponents.PageHeader("Performance & Analytics", "Revenue metrics, conversion tracking, shooter margins, and booking channels.") {
			<button class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">
				@components.IconFileText()
				<span>Export PDF</span>
			</button>
			<button class="c-btn c-btn-primary">
				@components.IconBarChart3()
				<span>Customize Report</span>
			</button>
		}

		<div class="crm-filter-bar">
			<div class="crm-filter-tabs">
				<span class="crm-filter-tab active">Current Year (2026)</span>
				<span class="crm-filter-tab">Previous Year (2025)</span>
				<span class="crm-filter-tab">Trailing 12 Months</span>
			</div>

			<div style="display: flex; gap: 8px;">
				<select class="crm-select">
					<option>This Quarter (Q4)</option>
					<option>Last Quarter (Q3)</option>
					<option>Last 30 Days</option>
					<option>Custom Date Range</option>
				</select>
			</div>
		</div>

		<div class="crm-stats-grid">
			@crmComponents.StatCard("Net Studio Profit", "$59,400", "+24.5% vs 2025", true, "trending-up")
			@crmComponents.StatCard("Booking Conversion Rate", "68.4%", "+4.2% overall", true, "target")
			@crmComponents.StatCard("Highest Channel ROI", "Instagram DM", "48% of total bookings", true, "sparkles")
			@crmComponents.StatCard("Average Shoot Margin", "78.2%", "After assistant & lab cost", true, "dollar")
		</div>

		<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">

			<div class="crm-table-container">
				<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
					<h3 style="font-size: 14px; font-weight: 600;">Lead Source Attribution & Conversion</h3>
				</div>
				<table class="crm-table">
					<thead>
						<tr>
							<th>Source</th>
							<th>Inquiries</th>
							<th>Booked</th>
							<th>Conversion</th>
							<th>Revenue</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="font-weight: 500;">Instagram DM & Bio</td>
							<td>42</td>
							<td>24</td>
							<td><strong style="color: #00cec9;">57.1%</strong></td>
							<td style="font-weight: 600;">$38,200</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">WhatsApp Direct</td>
							<td>28</td>
							<td>19</td>
							<td><strong style="color: #00cec9;">67.8%</strong></td>
							<td style="font-weight: 600;">$24,600</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">Word of Mouth / Referral</td>
							<td>15</td>
							<td>13</td>
							<td><strong style="color: #00cec9;">86.6%</strong></td>
							<td style="font-weight: 600;">$29,800</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">Google Search & Maps</td>
							<td>18</td>
							<td>7</td>
							<td><strong style="color: #00cec9;">38.8%</strong></td>
							<td style="font-weight: 600;">$11,400</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="crm-table-container">
				<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
					<h3 style="font-size: 14px; font-weight: 600;">Top Packages by Revenue</h3>
				</div>
				<table class="crm-table">
					<thead>
						<tr>
							<th>Package Name</th>
							<th>Shoots</th>
							<th>Total Revenue</th>
							<th>Avg Margin</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="font-weight: 500;">Heritage Wedding Documentation</td>
							<td>12</td>
							<td style="font-weight: 600;">$42,000</td>
							<td style="color: #00cec9; font-weight: 600;">81.2%</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">Editorial Portrait Session</td>
							<td>19</td>
							<td style="font-weight: 600;">$28,500</td>
							<td style="color: #00cec9; font-weight: 600;">74.5%</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">Commercial Lookbook Production</td>
							<td>8</td>
							<td style="font-weight: 600;">$24,800</td>
							<td style="color: #00cec9; font-weight: 600;">72.0%</td>
						</tr>
						<tr>
							<td style="font-weight: 500;">Maternity & Newborn Fine Art</td>
							<td>14</td>
							<td style="font-weight: 600;">$16,800</td>
							<td style="color: #00cec9; font-weight: 600;">85.0%</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="crm-table-container">
			<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
				<h3 style="font-size: 14px; font-weight: 600;">Photographer & Crew Performance</h3>
			</div>
			<table class="crm-table">
				<thead>
					<tr>
						<th>Photographer</th>
						<th>Shoots Completed</th>
						<th>Client Satisfaction</th>
						<th>Turnaround Time</th>
						<th>Total Billed</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td style="font-weight: 600;">Himanshu M. (Lead)</td>
						<td>24</td>
						<td style="color: #fdcb6e;">★ 4.98 (42 reviews)</td>
						<td>4.2 days avg</td>
						<td style="font-weight: 600;">$54,200</td>
					</tr>
					<tr>
						<td style="font-weight: 600;">Aniket K. (Associate)</td>
						<td>18</td>
						<td style="color: #fdcb6e;">★ 4.92 (28 reviews)</td>
						<td>5.1 days avg</td>
						<td style="font-weight: 600;">$32,400</td>
					</tr>
					<tr>
						<td style="font-weight: 600;">Dishita V. (Portrait Specialist)</td>
						<td>15</td>
						<td style="color: #fdcb6e;">★ 4.95 (19 reviews)</td>
						<td>3.8 days avg</td>
						<td style="font-weight: 600;">$26,800</td>
					</tr>
				</tbody>
			</table>
		</div>
	}
}
