package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ OrderDetails(id string) {
	@layouts.DashboardLayout("Order #ORD-942 - Aperture CRM", "order_details", []layouts.BreadcrumbItem{
		{Label: "Orders", URL: "/orders"},
		{Label: "ORD-942"},
	}) {
		@crmComponents.PageHeader("Order #ORD-942", "Placed on Oct 10, 2026 for Olivia & James Thornton") {
			<a href="/billing/invoices?action=new&order=ORD-942" class="c-btn c-btn-primary">📄 Generate Invoice</a>
			<button class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">📧 Email Receipt</button>
			<a href="/orders" class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">← Orders</a>
		}

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
			<div style="display: flex; flex-direction: column; gap: 24px;">

				<div class="crm-table-container">
					<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
						<h3 style="font-size: 14px; font-weight: 600;">Pricing Breakdown & Line Items</h3>
					</div>
					<table class="crm-table">
						<thead>
							<tr>
								<th>Item / Package</th>
								<th>Qty</th>
								<th>Unit Price</th>
								<th style="text-align: right;">Amount</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<div style="font-weight: 600;">Handcrafted Italian Leather Album (12x12)</div>
									<div style="font-size: 11px; color: var(--text-muted);">40 Pages, Lustre Ultra-thick flush mount</div>
								</td>
								<td>1</td>
								<td>$650.00</td>
								<td style="text-align: right; font-weight: 600;">$650.00</td>
							</tr>
							<tr>
								<td>
									<div style="font-weight: 600;">Museum Quality Framed Canvas Print (24x36)</div>
									<div style="font-size: 11px; color: var(--text-muted);">Solid oak floating frame</div>
								</td>
								<td>1</td>
								<td>$350.00</td>
								<td style="text-align: right; font-weight: 600;">$350.00</td>
							</tr>
						</tbody>
					</table>

					<div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; align-items: flex-end; gap: 6px;">
						<div style="display: flex; gap: 40px; font-size: 13px;">
							<span style="color: var(--text-muted);">Subtotal:</span>
							<strong>$1,000.00</strong>
						</div>
						<div style="display: flex; gap: 40px; font-size: 13px;">
							<span style="color: var(--text-muted);">Sales Tax (0%):</span>
							<strong>$0.00</strong>
						</div>
						<div style="display: flex; gap: 40px; font-size: 15px; margin-top: 4px; border-top: 1px solid var(--border-row); padding-top: 6px;">
							<span style="color: var(--text-main); font-weight: 600;">Total Amount:</span>
							<strong style="color: var(--accent-active-text);">$1,000.00</strong>
						</div>
					</div>
				</div>

				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Associated Project</h3>
					<div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; background: var(--bg-surface-subtle); border-radius: 6px;">
						<div>
							<div style="font-weight: 600; font-size: 13px;">The Thornton Nuptials (PRJ-102)</div>
							<div style="font-size: 11px; color: var(--text-muted);">Villa Monticello, Lake Como • Wedding Photography</div>
						</div>
						<a href="/projects/details?id=PRJ-102" class="crm-page-btn" style="text-decoration: none;">View Project ›</a>
					</div>
				</div>
			</div>

			<div style="display: flex; flex-direction: column; gap: 24px;">
				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Client Summary</h3>
					<div style="font-size: 13px; font-weight: 600;">Olivia & James Thornton</div>
					<div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">olivia.thornton@gmail.com</div>
					<div style="font-size: 11px; color: var(--text-muted);">+1 (555) 234-9811</div>
					<a href="/clients/details?id=1" style="display: inline-block; font-size: 11.5px; color: var(--accent-active-text); text-decoration: none; margin-top: 8px;">View Full Profile ›</a>
				</div>

				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Payment Status</h3>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 12.5px;">
						<span style="color: var(--text-muted);">Total:</span>
						<span>$1,000.00</span>
					</div>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 12.5px;">
						<span style="color: var(--text-muted);">Paid to date:</span>
						<span style="color: #00cec9; font-weight: 600;">$500.00 (Deposit)</span>
					</div>
					<div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 12.5px;">
						<span style="color: var(--text-muted);">Balance Due:</span>
						<span style="color: #ff7675; font-weight: 600;">$500.00</span>
					</div>
					<button class="c-btn c-btn-primary" style="width: 100%;">Record Payment</button>
				</div>
			</div>
		</div>
	}
}

