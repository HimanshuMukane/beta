package pages

import (
	"ui/layouts"
	"ui/components/feedback"
	"ui/components/icons"
)

templ ContractTemplatesSettings() {
	@layouts.DashboardLayout("Contract Templates - Settings", "settings_contract_templates", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Contract Templates"},
	}) {
		@feedback.PageHeader("Contract & Agreement Templates", "Maintain legal templates, copyright ownership clauses, liability limits, and placeholder variables.")

		@layouts.SettingsLayout("contract_templates") {
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
				<div>
					<h2 style="font-size: 16px; font-weight: 600; color: var(--text-main);">Legal Agreement Templates</h2>
					<p style="font-size: 12px; color: var(--text-muted);">Manage standard templates, signatures, and legal contracts.</p>
				</div>
				<a href="/settings/contract-templates/create" class="c-btn c-btn-primary">+ New Agreement</a>
			</div>

			<div class="crm-table-container">
				<table class="crm-table">
					<thead>
						<tr>
							<th>Contract Title</th>
							<th>Applicable Category</th>
							<th>Signature Required</th>
							<th>Last Revised</th>
							<th style="text-align: right;">Action</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>
								<a href="/settings/contract-templates/edit?id=1" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Birthday Contract</a>
								<div style="font-size: 11px; color: var(--text-muted);">Standard Birthday Event Coverage</div>
							</td>
							<td><span class="status-pill pill-purple">Birthday / Event</span></td>
							<td><span class="status-pill pill-green">Yes</span></td>
							<td style="color: var(--text-muted);">Oct 28, 2026</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/contract-templates/edit?id=1" class="crm-page-btn" style="text-decoration: none;">Edit Clauses</a>
									<button class="feedback-icon-btn delete" title="Delete Contract" onclick="confirm('Are you sure you want to delete this contract template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
						<tr>
							<td>
								<a href="/settings/contract-templates/edit?id=2" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Master Wedding Photography & Deliverables Contract</a>
								<div style="font-size: 11px; color: var(--text-muted);">Full-day Wedding & Film Agreement</div>
							</td>
							<td><span class="status-pill pill-purple">Wedding</span></td>
							<td><span class="status-pill pill-green">Yes</span></td>
							<td style="color: var(--text-muted);">Aug 14, 2026</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/contract-templates/edit?id=2" class="crm-page-btn" style="text-decoration: none;">Edit Clauses</a>
									<button class="feedback-icon-btn delete" title="Delete Contract" onclick="confirm('Are you sure you want to delete this contract template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
						<tr>
							<td>
								<a href="/settings/contract-templates/edit?id=3" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Commercial Licensing & Advertising Usage Release</a>
								<div style="font-size: 11px; color: var(--text-muted);">Corporate & Advertising License</div>
							</td>
							<td><span class="status-pill pill-blue">Commercial</span></td>
							<td><span class="status-pill pill-green">Yes</span></td>
							<td style="color: var(--text-muted);">Sep 02, 2026</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/contract-templates/edit?id=3" class="crm-page-btn" style="text-decoration: none;">Edit Clauses</a>
									<button class="feedback-icon-btn delete" title="Delete Contract" onclick="confirm('Are you sure you want to delete this contract template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		}
	}
}
