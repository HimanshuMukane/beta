package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ InvoiceTemplatesSettings() {
	@layouts.DashboardLayout("Invoice PDF Templates - Settings", "settings", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Invoice PDF"},
	}) {
		@crmComponents.PageHeader("Invoice PDF Templates", "Configure invoice branding, payment bank details, tax ID display, and footer notes.")

		@layouts.SettingsLayout("invoice_templates") {
			<div style="margin-bottom: 20px;">
				<h2 style="font-size: 16px; font-weight: 600;">Invoice Template Configuration</h2>
				<p style="font-size: 12px; color: var(--text-muted);">Legal information printed on official PDF receipts and invoices.</p>
			</div>

			<div style="display: flex; flex-direction: column; gap: 16px; max-width: 650px;">
				<div>
					<label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Studio Legal Tax / VAT ID</label>
					<input type="text" value="US-EIN 84-2910391" class="crm-search-input" style="width: 100%;"/>
				</div>

				<div>
					<label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Wire Transfer / Remittance Instructions</label>
					<textarea class="crm-search-input" style="width: 100%; height: 70px; resize: none;">Beneficiary: Aperture Fine Art Studio LLC&#10;Bank: Silicon Valley Bank / First Republic&#10;Routing: 121000358 | Account: 9821039841</textarea>
				</div>

				<div>
					<label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Invoice Footer Note</label>
					<input type="text" value="Thank you for trusting Aperture Studio with your timeless memories." class="crm-search-input" style="width: 100%;"/>
				</div>

				<button class="c-btn c-btn-primary" style="align-self: flex-start; margin-top: 10px;">Save Invoice Template</button>
			</div>
		}
	}
}

