package pages

import (
	"ui/layouts"
	"ui/components/icons"
)

templ ContractTemplateEditor(isEdit bool, id string) {
	@layouts.DashboardLayout("Contract Template Editor - Settings", "settings_contract_templates", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Contract Templates", URL: "/settings/contract-templates"},
		{Label: "Editor"},
	}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div style="display: flex; align-items: center; gap: 12px;">
				<a href="/settings/contract-templates" class="crm-page-btn" style="text-decoration: none;">← Back</a>
				<h1 style="font-size: 18px; font-weight: 700; color: var(--text-main); margin: 0;">
					if isEdit {
						Edit Contract Template
					} else {
						Create Contract Template
					}
				</h1>
			</div>

			<div style="display: flex; align-items: center; gap: 10px;">
				if isEdit {
					<button class="crm-page-btn" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.4); display: inline-flex; align-items: center; gap: 6px;" onclick="if(confirm('Are you sure you want to delete this contract?')) { window.location.href='/settings/contract-templates'; }">
						@icons.IconTrash2()
						<span>Delete Contract</span>
					</button>
				}
				<button class="c-btn c-btn-primary" style="background: #059669; border-color: #059669;">Save Contract</button>
			</div>
		</div>

		<div class="contract-editor-shell">
			<div class="contract-header-grid">

				<div class="contract-name-field">
					<label class="session-field-label" style="font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 6px; display: block;">Contract Name</label>
					<input type="text" class="session-input" value="Birthday Contract" placeholder="Contract Name" style="background: var(--bg-surface-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 8px 12px; font-size: 13px; color: var(--text-main); width: 100%; outline: none;"/>
				</div>

				<div class="contract-sig-toggle">
					<div class="sig-toggle-text">
						<span class="sig-toggle-title">My Signature Required</span>
						<span class="sig-toggle-sub">Set whether your signature is required to complete the contract.</span>
					</div>
					<label class="switch-label">
						<input type="checkbox" checked/>
						<span class="switch-slider"></span>
					</label>
				</div>
			</div>

			<div class="rich-editor-container">

				<div class="rich-editor-toolbar">
					<select class="editor-tool-select" onchange="document.execCommand('formatBlock', false, this.value)">
						<option value="p" selected>Paragraph</option>
						<option value="h3">Heading 1</option>
						<option value="h4">Heading 2</option>
						<option value="blockquote">Quote</option>
					</select>

					<div class="editor-toolbar-separator"></div>

					<button type="button" class="editor-tool-btn" onclick="document.execCommand('formatBlock', false, 'p')" title="Paragraph">¶</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('bold', false, null)" title="Bold"><b>B</b></button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('italic', false, null)" title="Italic"><i>I</i></button>

					<div class="editor-toolbar-separator"></div>

					<button type="button" class="editor-tool-btn" onclick="document.execCommand('justifyLeft', false, null)" title="Align Left">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="17" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="17" y1="18" x2="3" y2="18"></line></svg>
					</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('justifyCenter', false, null)" title="Align Center">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="10" x2="6" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="18" y1="18" x2="6" y2="18"></line></svg>
					</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('justifyRight', false, null)" title="Align Right">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" y1="10" x2="7" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="7" y2="18"></line></svg>
					</button>

					<div class="editor-toolbar-separator"></div>

					<button type="button" class="editor-tool-btn" onclick="document.execCommand('hiliteColor', false, '#fef08a')" title="Highlight" aria-label="Highlight">
						@icons.IconBrush()
					</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('strikeThrough', false, null)" title="Strikethrough"><s>S</s></button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('insertUnorderedList', false, null)" title="Bullet List">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
					</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('insertOrderedList', false, null)" title="Numbered List">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><text x="2" y="7" font-size="7" fill="currentColor">1</text><text x="2" y="13" font-size="7" fill="currentColor">2</text><text x="2" y="19" font-size="7" fill="currentColor">3</text></svg>
					</button>
					<button type="button" class="editor-tool-btn" onclick="document.execCommand('insertHorizontalRule', false, null)" title="Divider">—</button>
					<button type="button" class="editor-tool-btn" onclick="navigator.clipboard.writeText(document.getElementById('contract-rich-editor').innerText); alert('Contract text copied!')" title="Copy Content" aria-label="Copy">
						@icons.IconCopy()
					</button>

					<div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
						<button type="button" class="editor-pill-btn" onclick="insertVariable('Custom Field')">Insert Field</button>
						<select class="editor-tool-select" onchange="if(this.value){ insertVariable(this.value); this.value=''; }">
							<option value="">Insert Variable ▾</option>
							<option value="Client Name">Client Name</option>
							<option value="Client Mobile No.">Client Mobile No.</option>
							<option value="Client Mail">Client Mail</option>
							<option value="Event Name">Event Name</option>
							<option value="Event Type">Event Type</option>
							<option value="Event Start Date">Event Start Date</option>
							<option value="Event Address">Event Address</option>
							<option value="Studio Name">Studio Name</option>
							<option value="Studio Support No.">Studio Support No.</option>
							<option value="Studio Support Mail">Studio Support Mail</option>
							<option value="Package Details">Package Details</option>
							<option value="Total Amount">Total Amount</option>
							<option value="Deposit Amount">Deposit Amount</option>
							<option value="Balance Amount">Balance Amount</option>
							<option value="Due Duration">Due Duration</option>
							<option value="Cancellation Window">Cancellation Window</option>
						</select>
					</div>
				</div>

				<div class="rich-editor-content" id="contract-rich-editor" contenteditable="true">
					<h4>Client Information:</h4>
					<p>Client Name: <span class="editor-variable">Client Name</span></p>
					<p>Client Mobile No.: <span class="editor-variable">Client Mobile No.</span></p>
					<p>Client Mail: <span class="editor-variable">Client Mail</span></p>

					<h4>Event Details:</h4>
					<p>Event Name: <span class="editor-variable">Event Name</span></p>
					<p>Event Type: <span class="editor-variable">Event Type</span></p>
					<p>Event Date: <span class="editor-variable">Event Start Date</span></p>
					<p>Event Address: <span class="editor-variable">Event Address</span></p>

					<h4>Studio Information:</h4>
					<p>Studio Name: <span class="editor-variable">Studio Name</span></p>
					<p>Support Contact: <span class="editor-variable">Studio Support No.</span></p>
					<p>Support Email: <span class="editor-variable">Studio Support Mail</span></p>

					<h4>Photography Services:</h4>
					<ol>
						<li>The Photographer agrees to provide birthday photography services on <span class="editor-variable">Event Start Date</span> at <span class="editor-variable">Event Address</span>.</li>
						<li>The package includes <span class="editor-variable">Package Details</span>.</li>
					</ol>

					<h4>Payment Terms:</h4>
					<ol>
						<li>Total fee: <span class="editor-variable">Total Amount</span>. A non-refundable deposit of <span class="editor-variable">Deposit Amount</span> is due upon signing.</li>
						<li>Remaining balance of <span class="editor-variable">Balance Amount</span> is due <span class="editor-variable">Due Duration</span> before the event.</li>
					</ol>

					<h4>Cancellation Policy:</h4>
					<ol>
						<li>Deposit is non-refundable upon cancellation.</li>
						<li>If cancelled within <span class="editor-variable">Cancellation Window</span>, full payment is required.</li>
					</ol>

					<h4>Copyright and Usage Rights:</h4>
					<ol>
						<li>Photographer retains copyright to all images.</li>
					</ol>
				</div>
			</div>
		</div>

		<script>
			function insertVariable(name) {
				const editor = document.getElementById('contract-rich-editor');
				editor.focus();
				const span = '<span class="editor-variable">' + name + '</span>&nbsp;';
				document.execCommand('insertHTML', false, span);
			}
		</script>
	}
}
