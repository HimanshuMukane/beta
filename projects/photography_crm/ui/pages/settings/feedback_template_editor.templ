package pages

import (
	"ui/layouts"
	"ui/components/icons"
)

templ FeedbackTemplateEditor(isEdit bool, id string) {
	@layouts.DashboardLayout("Edit Feedback Template - Settings", "settings_feedback_templates", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Feedbacks", URL: "/settings/feedback-templates"},
		{Label: "Edit Template"},
	}) {

		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div style="display: flex; align-items: center; gap: 12px;">
				<a href="/settings/feedback-templates" class="crm-page-btn" style="text-decoration: none;">← Back</a>
				<h1 style="font-size: 18px; font-weight: 700; color: var(--text-main); margin: 0;">
					if isEdit {
						Edit Feedback Template
					} else {
						New Feedback Template
					}
				</h1>
			</div>

			<div style="display: flex; align-items: center; gap: 10px;">
				if isEdit {
					<button class="crm-page-btn" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.4); display: inline-flex; align-items: center; gap: 6px;" onclick="if(confirm('Are you sure you want to delete this feedback template?')) { window.location.href='/settings/feedback-templates'; }">
						@icons.IconTrash2()
						<span>Delete Feedback</span>
					</button>
				}
				<button class="c-btn c-btn-primary" style="background: #0f4c5c; border-color: #0f4c5c; padding: 7px 20px;">Save</button>
			</div>
		</div>

		<div class="feedback-editor-shell">

			<div>
				<label class="session-field-label" style="font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px; display: block;">Feedback Template Name</label>
				<input type="text" class="session-input" value="Birthday Shoot Feedback" placeholder="Feedback Template Name" style="background: var(--bg-surface-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 8px 12px; font-size: 13px; color: var(--text-main); max-width: 400px; width: 100%; outline: none;"/>
			</div>

			<div>
				<h3 style="font-size: 15px; font-weight: 700; color: var(--text-main); margin-bottom: 16px;">Feedback Questions</h3>

				<div id="questions-list">

					<div class="feedback-question-card" id="question-1">
						<div class="feedback-question-header">
							<span class="feedback-question-title">How likely are you to recommend our birthday photography services to others?</span>
							<div class="feedback-question-actions">
								<button class="feedback-icon-btn" title="Edit Question" onclick="editQuestionTitle('question-1')">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
								</button>
								<button class="feedback-icon-btn delete" title="Remove Question" onclick="removeQuestion('question-1')">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
								</button>
							</div>
						</div>
						<div class="star-rating-preview">
							@icons.IconStar()
							@icons.IconStar()
							@icons.IconStar()
							@icons.IconStar()
							@icons.IconStar()
						</div>
					</div>

					<div class="feedback-question-card" id="question-2">
						<div class="feedback-question-header">
							<span class="feedback-question-title">Would you like to leave a testimonial or review for us?</span>
							<div class="feedback-question-actions">
								<button class="feedback-icon-btn" title="Edit Question" onclick="editQuestionTitle('question-2')">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
								</button>
								<button class="feedback-icon-btn delete" title="Remove Question" onclick="removeQuestion('question-2')">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
								</button>
							</div>
						</div>
						<div class="text-answer-preview"></div>
					</div>
				</div>

				<div style="position: relative; display: inline-block; margin-top: 16px;">
					<button type="button" class="add-segment-btn" id="add-question-btn" onclick="toggleQuestionMenu(event)">
						<span>+ Add Question</span>
					</button>

					<div class="question-type-dropdown-box" id="question-type-menu" style="display: none; top: 100%; left: 0; margin-top: 4px;">
						<button type="button" class="question-type-option" onclick="addQuestion('star')">Star Rating</button>
						<button type="button" class="question-type-option" onclick="addQuestion('text')">Text</button>
					</div>
				</div>
			</div>
		</div>

		<script>
			let questionCount = 2;

			function toggleQuestionMenu(e) {
				e.stopPropagation();
				const menu = document.getElementById('question-type-menu');
				menu.style.display = (menu.style.display === 'none' || !menu.style.display) ? 'block' : 'none';
			}

			window.addEventListener('click', function(e) {
				const menu = document.getElementById('question-type-menu');
				if (menu && !e.target.closest('#add-question-btn')) {
					menu.style.display = 'none';
				}
			});

			function removeQuestion(id) {
				const el = document.getElementById(id);
				if (el) el.remove();
			}

			function editQuestionTitle(id) {
				const el = document.getElementById(id);
				if (!el) return;
				const titleEl = el.querySelector('.feedback-question-title');
				const newTitle = prompt('Enter question text:', titleEl.textContent);
				if (newTitle) titleEl.textContent = newTitle;
			}

			function addQuestion(type) {
				questionCount++;
				const qId = 'question-' + questionCount;
				const container = document.getElementById('questions-list');
				const card = document.createElement('div');
				card.className = 'feedback-question-card';
				card.id = qId;

				const title = type === 'star' ? 'Rate your overall experience' : 'Share your thoughts or comments';

				const preview = type === 'star'
					? '<div class="star-rating-preview"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></div>'
					: '<div class="text-answer-preview"></div>';

				card.innerHTML = `
					<div class="feedback-question-header">
						<span class="feedback-question-title">${title}</span>
						<div class="feedback-question-actions">
							<button class="feedback-icon-btn" title="Edit Question" onclick="editQuestionTitle('${qId}')">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
							</button>
							<button class="feedback-icon-btn delete" title="Remove Question" onclick="removeQuestion('${qId}')">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
							</button>
						</div>
					</div>
					${preview}
				`;

				container.appendChild(card);
				document.getElementById('question-type-menu').style.display = 'none';
			}
		</script>
	}
}
