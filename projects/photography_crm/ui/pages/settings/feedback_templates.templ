package pages

import (
	"ui/layouts"
	"ui/components/feedback"
	"ui/components/icons"
)

templ FeedbackTemplatesSettings() {
	@layouts.DashboardLayout("Feedback Form Templates - Settings", "settings_feedback_templates", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Feedbacks"},
	}) {
		@feedback.PageHeader("Client Feedback & Review Templates", "Set up post-delivery satisfaction surveys, 5-star rating requests, and testimonial permissions.")

		@layouts.SettingsLayout("feedback_templates") {
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
				<div>
					<h2 style="font-size: 16px; font-weight: 600; color: var(--text-main);">Feedback & Review Surveys</h2>
					<p style="font-size: 12px; color: var(--text-muted);">Manage feedback forms, questions, star ratings, and reviews.</p>
				</div>
				<a href="/settings/feedback-templates/create" class="c-btn c-btn-primary">+ New Feedback</a>
			</div>

			<div class="crm-table-container">
				<table class="crm-table">
					<thead>
						<tr>
							<th>Survey / Template Name</th>
							<th>Questions</th>
							<th>Response Rate</th>
							<th>Avg Score</th>
							<th>Status</th>
							<th style="text-align: right;">Action</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>
								<a href="/settings/feedback-templates/edit?id=1" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Birthday Shoot Feedback</a>
								<div style="font-size: 11px; color: var(--text-muted);">Rating & Testimonial Questions</div>
							</td>
							<td>2 Questions (Star Rating, Text)</td>
							<td style="font-weight: 600;">88%</td>
							<td style="color: #fdcb6e; font-weight: 600; display: flex; align-items: center; gap: 4px;">
								@icons.IconStar()
								<span>5.0</span>
							</td>
							<td>@feedback.StatusPill("Active", "green")</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/feedback-templates/edit?id=1" class="crm-page-btn" style="text-decoration: none;">Manage</a>
									<button class="feedback-icon-btn delete" title="Delete Feedback" onclick="confirm('Are you sure you want to delete this feedback template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
						<tr>
							<td>
								<a href="/settings/feedback-templates/edit?id=2" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Post-Wedding Client Experience Survey</a>
								<div style="font-size: 11px; color: var(--text-muted);">Promptness, Art Direction, Gallery Quality</div>
							</td>
							<td>4 Questions (Star Ratings, Text)</td>
							<td style="font-weight: 600;">82%</td>
							<td style="color: #fdcb6e; font-weight: 600; display: flex; align-items: center; gap: 4px;">
								@icons.IconStar()
								<span>4.96</span>
							</td>
							<td>@feedback.StatusPill("Active", "green")</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/feedback-templates/edit?id=2" class="crm-page-btn" style="text-decoration: none;">Manage</a>
									<button class="feedback-icon-btn delete" title="Delete Feedback" onclick="confirm('Are you sure you want to delete this feedback template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
						<tr>
							<td>
								<a href="/settings/feedback-templates/edit?id=3" style="font-weight: 600; color: var(--text-main); text-decoration: none;">Commercial Client Quality Review</a>
								<div style="font-size: 11px; color: var(--text-muted);">Turnaround Speed, Color Accuracy, Licensing Clarity</div>
							</td>
							<td>3 Questions (Text & Score)</td>
							<td style="font-weight: 600;">74%</td>
							<td style="color: #fdcb6e; font-weight: 600; display: flex; align-items: center; gap: 4px;">
								@icons.IconStar()
								<span>4.91</span>
							</td>
							<td>@feedback.StatusPill("Active", "green")</td>
							<td style="text-align: right;">
								<div style="display: inline-flex; align-items: center; gap: 8px;">
									<a href="/settings/feedback-templates/edit?id=3" class="crm-page-btn" style="text-decoration: none;">Manage</a>
									<button class="feedback-icon-btn delete" title="Delete Feedback" onclick="confirm('Are you sure you want to delete this feedback template?')" aria-label="Delete">
										@icons.IconTrash2()
									</button>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		}
	}
}
