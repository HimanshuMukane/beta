package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ OrderPresetsSettings() {
	@layouts.DashboardLayout("Orders Configuration - Settings", "settings_order_presets", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Orders"},
	}) {
		@crmComponents.PageHeader("Orders Line Items & Expenses", "Configure all studio Orders items with pricing and expenses for easy billing.") {
			<button class="c-btn c-btn-primary" onclick="openAddOrderItemRow()">+ Add Item</button>
		}

		<div class="crm-table-container" style="padding: 20px 24px;">
			<div style="margin-bottom: 16px;">
				<h2 style="font-size: 16px; font-weight: 700; color: var(--text-main);">Orders</h2>
				<p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
					Config all studio Orders items with pricing and expenses for easy billing. If any line item is deleted, it must be immediately replaced with another relevant line item.
				</p>
			</div>

			<table class="service-group-table">
				<thead>
					<tr>
						<th style="width: 32%;">Item Name</th>
						<th style="width: 18%;">Quantity</th>
						<th style="width: 24%;">Amount</th>
						<th style="width: 22%;">Expense</th>
						<th style="width: 4%;"></th>
					</tr>
				</thead>
				<tbody id="orders-config-tbody">
					<tr>
						<td><input type="text" class="service-row-input" value="Passport Photo"/></td>
						<td><input type="number" class="service-row-input" value="1"/></td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="number" class="service-amount-input" value="200"/>
							</div>
						</td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="number" class="service-amount-input" value="300"/>
							</div>
						</td>
						<td><button class="service-remove-btn" title="Remove line item">⊖</button></td>
					</tr>

					<tr>
						<td><input type="text" class="service-row-input" value="Frame 10 * 12"/></td>
						<td><input type="number" class="service-row-input" value="1"/></td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="number" class="service-amount-input" value="1200"/>
							</div>
						</td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="number" class="service-amount-input" value="500"/>
							</div>
						</td>
						<td><button class="service-remove-btn" title="Remove line item">⊖</button></td>
					</tr>

					<tr>
						<td><input type="text" class="service-row-input" value="Gifts"/></td>
						<td><input type="number" class="service-row-input" value="1"/></td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="number" class="service-amount-input" value="2500"/>
							</div>
						</td>
						<td>
							<div class="service-amount-box">
								<span class="service-amount-prefix">INR</span>
								<input type="text" class="service-amount-input" placeholder="Item Expense"/>
							</div>
						</td>
						<td><button class="service-remove-btn" title="Remove line item">⊖</button></td>
					</tr>
				</tbody>
			</table>

			<div style="margin-top: 18px; display: flex; justify-content: space-between; align-items: center;">
				<button class="crm-page-btn" onclick="openAddOrderItemRow()" style="color: var(--accent-active-text);">
					+ Add Item
				</button>
				<button class="c-btn c-btn-primary">Save Orders Config</button>
			</div>
		</div>

		<script>
			function openAddOrderItemRow() {
				const tbody = document.getElementById('orders-config-tbody');
				if (!tbody) return;
				const tr = document.createElement('tr');
				tr.innerHTML = `
					<td><input type="text" class="service-row-input" placeholder="Item Name"/></td>
					<td><input type="number" class="service-row-input" value="1"/></td>
					<td>
						<div class="service-amount-box">
							<span class="service-amount-prefix">INR</span>
							<input type="number" class="service-amount-input" value="100"/>
						</div>
					</td>
					<td>
						<div class="service-amount-box">
							<span class="service-amount-prefix">INR</span>
							<input type="text" class="service-amount-input" placeholder="Item Expense"/>
						</div>
					</td>
					<td><button class="service-remove-btn" onclick="this.closest('tr').remove()">⊖</button></td>
				`;
				tbody.appendChild(tr);
			}
		</script>
	}
}
