package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ QuotationTemplatesSettings() {
	@layouts.DashboardLayout("Quotation PDF Templates - Settings", "settings", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Quotation PDF"},
	}) {
		@crmComponents.PageHeader("Quotation PDF & Proposal Templates", "Design editorial quotation layouts, typography, and cover letter branding.")

		@layouts.SettingsLayout("quotation_templates") {
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
				<div>
					<h2 style="font-size: 16px; font-weight: 600;">PDF Proposal Themes</h2>
					<p style="font-size: 12px; color: var(--text-muted);">Select layout theme, custom accent colors, and photo splash styles.</p>
				</div>
				<button class="c-btn c-btn-primary">+ New Template</button>
			</div>

			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
				<div style="border: 2px solid var(--accent-primary); border-radius: 8px; padding: 16px; background: var(--bg-surface-subtle);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
						<h3 style="font-size: 14px; font-weight: 600;">Minimalist Editorial Serif (Default)</h3>
						@crmComponents.StatusPill("Active Default", "green")
					</div>
					<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">Cormorant Garamond headers with full-bleed hero photos and detailed package deliverables breakdown.</p>
					<button class="crm-page-btn">Preview Sample PDF</button>
				</div>

				<div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; background: var(--bg-surface-subtle);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
						<h3 style="font-size: 14px; font-weight: 600;">Modern Studio Clean</h3>
						<span class="status-pill pill-gray">Alternative</span>
					</div>
					<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">Clean sans-serif design suited for commercial clients and corporate advertising agencies.</p>
					<button class="crm-page-btn">Preview Sample PDF</button>
				</div>
			</div>
		}
	}
}

