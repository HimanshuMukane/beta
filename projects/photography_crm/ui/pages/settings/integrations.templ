package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

templ IntegrationsSettings() {
	@layouts.DashboardLayout("Integrations & Channels - Settings", "settings", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Integrations"},
	}) {
		@crmComponents.PageHeader("Connected Inquiries & Messaging Channels", "Connect social media channels to receive client inquiries and unified direct messages.")

		@layouts.SettingsLayout("integrations") {
			<div style="margin-bottom: 20px;">
				<h2 style="font-size: 16px; font-weight: 600;">Messaging & Social Channels</h2>
				<p style="font-size: 12px; color: var(--text-muted);">Sync inquiries and chat threads straight to the Studio Inbox.</p>
			</div>

			<div style="display: flex; flex-direction: column; gap: 16px;">

				<div style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: var(--bg-surface-subtle); border-radius: 8px; border: 1px solid var(--border-color);">
					<div style="display: flex; gap: 14px; align-items: center;">
						<div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(37, 211, 102, 0.12); color: #25d366; display: flex; align-items: center; justify-content: center;">
							@components.IconMessageSquare()
						</div>
						<div>
							<div style="font-weight: 600; font-size: 14px;">WhatsApp Business API</div>
							<div style="font-size: 12px; color: var(--text-muted);">Sync mobile numbers +1 (555) 019-2831 to studio conversation threads</div>
						</div>
					</div>
					<div style="display: flex; gap: 10px; align-items: center;">
						@crmComponents.StatusPill("Connected", "green")
						<button class="crm-page-btn">Configure</button>
					</div>
				</div>

				<div style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: var(--bg-surface-subtle); border-radius: 8px; border: 1px solid var(--border-color);">
					<div style="display: flex; gap: 14px; align-items: center;">
						<div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(225, 48, 108, 0.12); color: #e1306c; display: flex; align-items: center; justify-content: center;">
							@components.IconCamera()
						</div>
						<div>
							<div style="font-weight: 600; font-size: 14px;">Instagram Direct Messages & Lead Ads</div>
							<div style="font-size: 12px; color: var(--text-muted);">Handle @aperture.fineart client inquiries and story replies</div>
						</div>
					</div>
					<div style="display: flex; gap: 10px; align-items: center;">
						@crmComponents.StatusPill("Connected", "green")
						<button class="crm-page-btn">Configure</button>
					</div>
				</div>

				<div style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: var(--bg-surface-subtle); border-radius: 8px; border: 1px solid var(--border-color);">
					<div style="display: flex; gap: 14px; align-items: center;">
						<div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(0, 132, 255, 0.12); color: #0084ff; display: flex; align-items: center; justify-content: center;">
							@components.IconUser()
						</div>
						<div>
							<div style="font-weight: 600; font-size: 14px;">Facebook Messenger & Page Inbox</div>
							<div style="font-size: 12px; color: var(--text-muted);">Receive inquiries from studio Facebook business page</div>
						</div>
					</div>
					<div style="display: flex; gap: 10px; align-items: center;">
						@crmComponents.StatusPill("Connected", "green")
						<button class="crm-page-btn">Configure</button>
					</div>
				</div>

				<div style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: var(--bg-surface-subtle); border-radius: 8px; border: 1px solid var(--border-color);">
					<div style="display: flex; gap: 14px; align-items: center;">
						<div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: rgba(59, 130, 246, 0.12); color: #3b82f6; display: flex; align-items: center; justify-content: center;">
							@components.IconMegaphone()
						</div>
						<div>
							<div style="font-weight: 600; font-size: 14px;">Meta Lead Ads Webhook</div>
							<div style="font-size: 12px; color: var(--text-muted);">Instant ingestion of wedding season ad campaigns into Leads</div>
						</div>
					</div>
					<div style="display: flex; gap: 10px; align-items: center;">
						@crmComponents.StatusPill("Connected", "green")
						<button class="crm-page-btn">Configure</button>
					</div>
				</div>
			</div>
		}
	}
}

