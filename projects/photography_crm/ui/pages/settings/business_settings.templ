package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

templ BusinessSettings() {
	@layouts.DashboardLayout("Business Profile - Settings", "settings_business", []layouts.BreadcrumbItem{
		{Label: "Settings", URL: "/settings"},
		{Label: "Business Profile"},
	}) {
		@crmComponents.PageHeader("Studio Business Configuration", "Manage studio branding, physical studio address, tax settings, currency, and notifications.") {
			<button class="c-btn c-btn-primary" onclick="alert('Business profile updated successfully.')">Save All Changes</button>
		}

		@layouts.SettingsLayout("business") {
			<div class="settings-modern-container">

				<div class="settings-section-card">
					<div class="settings-card-header">
						<div class="settings-card-header-left">
							<div class="settings-card-title">
								@components.IconCamera()
								<span>Studio Profile & Branding</span>
							</div>
							<div class="settings-card-subtitle">Public details printed on proposals, contracts, client portals, and watermarks.</div>
						</div>
					</div>

					<div class="settings-card-body">
						<div class="biz-layout-grid">

							<div>
								<label class="form-label-custom" style="margin-bottom: 8px;">Studio Logo & Mark</label>
								<div class="biz-logo-uploader" onclick="document.getElementById('studio-logo-input').click()">
									<div class="biz-logo-preview" style="color: var(--text-muted); display: flex; align-items: center; justify-content: center;">
										@components.IconCamera()
									</div>
									<div style="font-size: 13px; font-weight: 600; color: var(--text-main);">Upload Studio Mark</div>
									<div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">PNG, JPG or SVG up to 5MB</div>
									<button type="button" class="crm-page-btn" style="margin-top: 12px; pointer-events: none;">Select File</button>
									<input type="file" id="studio-logo-input" style="display: none;" accept="image/*"/>
								</div>
							</div>

							<div style="display: flex; flex-direction: column; gap: 16px;">
								<div class="form-grid-2col">
									<div class="form-group-custom">
										<label class="form-label-custom">
											<span>Studio Legal Name</span>
											<span class="form-label-hint">Official Registered Entity</span>
										</label>
										<input type="text" class="form-input-custom" value="Aperture Fine Art Studio LLC"/>
									</div>
									<div class="form-group-custom">
										<label class="form-label-custom">
											<span>Trading / Display Name</span>
											<span class="form-label-hint">Shown to clients</span>
										</label>
										<input type="text" class="form-input-custom" value="Aperture Photography & Films"/>
									</div>
								</div>

								<div class="form-grid-2col">
									<div class="form-group-custom">
										<label class="form-label-custom">Primary Studio Email</label>
										<input type="email" class="form-input-custom" value="hello@aperturestudio.com"/>
									</div>
									<div class="form-group-custom">
										<label class="form-label-custom">Studio Phone / WhatsApp</label>
										<input type="text" class="form-input-custom" value="+1 (555) 019-2831"/>
									</div>
								</div>

								<div class="form-grid-2col">
									<div class="form-group-custom">
										<label class="form-label-custom">Website URL</label>
										<input type="url" class="form-input-custom" value="https://aperturefineart.com"/>
									</div>
									<div class="form-group-custom">
										<label class="form-label-custom">Instagram Handle</label>
										<input type="text" class="form-input-custom" value="@aperturefineart"/>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="settings-section-card">
					<div class="settings-card-header">
						<div class="settings-card-header-left">
							<div class="settings-card-title">
								@components.IconSettings()
								<span>Location, Currency & Taxes</span>
							</div>
							<div class="settings-card-subtitle">Studio base location used for travel fee calculations and invoice currency.</div>
						</div>
					</div>

					<div class="settings-card-body" style="display: flex; flex-direction: column; gap: 16px;">
						<div class="form-group-custom">
							<label class="form-label-custom">Physical Studio Street Address</label>
							<input type="text" class="form-input-custom" value="742 Montgomery St, Suite 400"/>
						</div>

						<div class="form-grid-3col">
							<div class="form-group-custom">
								<label class="form-label-custom">City</label>
								<input type="text" class="form-input-custom" value="San Francisco"/>
							</div>
							<div class="form-group-custom">
								<label class="form-label-custom">State / Province</label>
								<input type="text" class="form-input-custom" value="California (CA)"/>
							</div>
							<div class="form-group-custom">
								<label class="form-label-custom">Postal / ZIP Code</label>
								<input type="text" class="form-input-custom" value="94111"/>
							</div>
						</div>

						<div class="form-grid-3col">
							<div class="form-group-custom">
								<label class="form-label-custom">Base Currency</label>
								<select class="crm-select" style="width: 100%;">
									<option selected>USD ($) - US Dollar</option>
									<option>EUR (€) - Euro</option>
									<option>GBP (£) - British Pound</option>
									<option>INR (₹) - Indian Rupee</option>
									<option>CAD ($) - Canadian Dollar</option>
									<option>AUD ($) - Australian Dollar</option>
								</select>
							</div>
							<div class="form-group-custom">
								<label class="form-label-custom">Tax / VAT / GST Rate (%)</label>
								<input type="number" step="0.01" class="form-input-custom" value="8.50"/>
							</div>
							<div class="form-group-custom">
								<label class="form-label-custom">Tax Identification / GST Number</label>
								<input type="text" class="form-input-custom" value="US-EIN-94820184"/>
							</div>
						</div>
					</div>
				</div>

				<div class="settings-section-card">
					<div class="settings-card-header">
						<div class="settings-card-header-left">
							<div class="settings-card-title">
								@components.IconZap()
								<span>Operational Alerts & Automation</span>
							</div>
							<div class="settings-card-subtitle">Notify team and clients on crucial booking, payment, and inquiry milestones.</div>
						</div>
					</div>

					<div class="settings-card-body">
						<div class="pref-row-card">
							<div class="pref-row-info">
								<div class="pref-row-title">Instant Lead Submission Notifications</div>
								<div class="pref-row-desc">Send immediate email and SMS alerts to the studio director when a contact form or inquiry arrives.</div>
							</div>
							<label class="switch-label">
								<input type="checkbox" checked/>
								<span class="switch-slider"></span>
							</label>
						</div>

						<div class="pref-row-card">
							<div class="pref-row-info">
								<div class="pref-row-title">Shoot Reminders (SMS & Email)</div>
								<div class="pref-row-desc">Automatically dispatch shoot call-sheet alerts to both clients and assigned crew 24 hours prior.</div>
							</div>
							<label class="switch-label">
								<input type="checkbox" checked/>
								<span class="switch-slider"></span>
							</label>
						</div>

						<div class="pref-row-card">
							<div class="pref-row-info">
								<div class="pref-row-title">Automated Payment Receipts</div>
								<div class="pref-row-desc">Emit branded PDF receipts and sync transaction balances upon receiving online payments.</div>
							</div>
							<label class="switch-label">
								<input type="checkbox" checked/>
								<span class="switch-slider"></span>
							</label>
						</div>

						<div class="pref-row-card">
							<div class="pref-row-info">
								<div class="pref-row-title">Client Gallery Download Notifications</div>
								<div class="pref-row-desc">Alert photographers when clients begin downloading their deliverables from the client portal.</div>
							</div>
							<label class="switch-label">
								<input type="checkbox"/>
								<span class="switch-slider"></span>
							</label>
						</div>
					</div>

					<div class="settings-card-footer">
						<button class="crm-page-btn" onclick="location.reload()">Cancel</button>
						<button class="c-btn c-btn-primary" onclick="alert('Business profile updated successfully.')">Save Business Settings</button>
					</div>
				</div>
			</div>
		}
	}
}
