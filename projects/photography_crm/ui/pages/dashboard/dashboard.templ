package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

type DashboardData struct {
	TotalLeads       int
	NewLeads         int
	TotalClients     int
	ActiveProjects   int
	UpcomingSessions int
	PendingPayments  string
	TotalRevenue     string
}

templ Dashboard(title string) {
	@layouts.DashboardLayout(title, "dashboard", []layouts.BreadcrumbItem{{Label: "Overview"}}) {
		@crmComponents.PageHeader("Studio Dashboard", "Welcome back, Himanshu. Here is an overview of your photography studio.") {
			<a href="/sessions?action=book" class="c-btn c-btn-primary">
				@components.IconPlus()
				<span>Book Session</span>
			</a>
			<a href="/leads?action=new" class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">
				@components.IconPlus()
				<span>New Lead</span>
			</a>
		}

		<div class="crm-stats-grid">
			@crmComponents.StatCard("Total Leads", "84", "+14% this month", true, "target")
			@crmComponents.StatCard("New Leads", "18", "+5% this week", true, "sparkles")
			@crmComponents.StatCard("Total Clients", "126", "+8% vs last quarter", true, "users")
			@crmComponents.StatCard("Active Projects", "15", "3 shoots today", true, "folder")
			@crmComponents.StatCard("Upcoming Sessions", "9", "Within next 7 days", true, "camera")
			@crmComponents.StatCard("Pending Payments", "$8,450", "4 overdue invoices", false, "clock")
			@crmComponents.StatCard("Total Revenue", "$74,200", "+22% year to date", true, "dollar")
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 24px;">

			<div class="crm-table-container" style="padding: 20px;">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
					<div>
						<h3 style="font-size: 15px; font-weight: 600; color: var(--text-main);">Revenue & Booking Conversion</h3>
						<p style="font-size: 12px; color: var(--text-muted);">Monthly studio performance across wedding, portrait, and commercial shoots</p>
					</div>
					<div class="crm-filter-tabs">
						<span class="crm-filter-tab active">6 Months</span>
						<span class="crm-filter-tab">1 Year</span>
						<span class="crm-filter-tab">All Time</span>
					</div>
				</div>

				<div style="display: flex; align-items: flex-end; justify-content: space-between; height: 180px; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 95px; background: rgba(124, 93, 250, 0.4); border-radius: 4px;"></div>
						<span style="font-size: 11px; color: var(--text-muted);">May</span>
					</div>
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 120px; background: rgba(124, 93, 250, 0.5); border-radius: 4px;"></div>
						<span style="font-size: 11px; color: var(--text-muted);">Jun</span>
					</div>
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 140px; background: rgba(124, 93, 250, 0.65); border-radius: 4px;"></div>
						<span style="font-size: 11px; color: var(--text-muted);">Jul</span>
					</div>
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 165px; background: rgba(124, 93, 250, 0.8); border-radius: 4px;"></div>
						<span style="font-size: 11px; color: var(--text-muted);">Aug</span>
					</div>
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 130px; background: rgba(124, 93, 250, 0.6); border-radius: 4px;"></div>
						<span style="font-size: 11px; color: var(--text-muted);">Sep</span>
					</div>
					<div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
						<div style="width: 32px; height: 175px; background: var(--accent-primary); border-radius: 4px; box-shadow: 0 0 12px var(--accent-primary-glow);"></div>
						<span style="font-size: 11px; color: var(--text-main); font-weight: 600;">Oct</span>
					</div>
				</div>
				<div style="display: flex; justify-content: space-around; margin-top: 14px; font-size: 12px;">
					<span style="color: var(--text-muted);">Conversion Rate: <strong style="color: #00cec9;">68.4%</strong></span>
					<span style="color: var(--text-muted);">Target Met: <strong style="color: var(--accent-active-text);">114%</strong></span>
				</div>
			</div>

			<div class="crm-table-container" style="padding: 20px;">
				<h3 style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 14px;">Today's Priority Agenda</h3>
				<div style="display: flex; flex-direction: column; gap: 12px;">
					<div style="padding: 10px; background: var(--bg-surface-subtle); border-radius: 6px; border-left: 3px solid #7c5dfa;">
						<div style="font-weight: 600; font-size: 12.5px;">Kavya Wedding Reception</div>
						<div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">06:00 PM - 10:00 PM • Leela Palace</div>
					</div>
					<div style="padding: 10px; background: var(--bg-surface-subtle); border-radius: 6px; border-left: 3px solid #00cec9;">
						<div style="font-weight: 600; font-size: 12.5px;">Lead Consultation: Marcus Vance</div>
						<div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">02:00 PM • Google Meet</div>
					</div>
					<div style="padding: 10px; background: var(--bg-surface-subtle); border-radius: 6px; border-left: 3px solid #ff7675;">
						<div style="font-weight: 600; font-size: 12.5px;">Overdue Invoice: ORD-940</div>
						<div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">$1,200 Balance • Kearney & Partners</div>
					</div>
				</div>
			</div>
		</div>
	}
}
