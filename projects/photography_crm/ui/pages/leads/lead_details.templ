package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ LeadDetails(id string) {
	@layouts.DashboardLayout("Lead Details - Jessica Parker", "lead_details", []layouts.BreadcrumbItem{
		{Label: "Leads", URL: "/leads"},
		{Label: "Jessica Parker"},
	}) {
		@crmComponents.PageHeader("Jessica Parker", "Inquiry for Destination Wedding (Villa Monticello, Lake Como)") {
			<a href="/orders?action=new&client=Jessica+Parker" class="c-btn c-btn-primary">⚡ Convert to Client / Order</a>
			<button class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">📧 Send Quotation</button>
			<a href="/leads" class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main);">← Back</a>
		}

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">

			<div style="display: flex; flex-direction: column; gap: 24px;">

				<div class="crm-table-container" style="padding: 24px;">
					<h3 style="font-size: 15px; font-weight: 600; margin-bottom: 16px;">Inquiry & Requirement Breakdown</h3>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Email Address</div>
							<div style="font-size: 13px; font-weight: 500;">jessica@luxuryweddings.com</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Phone / WhatsApp</div>
							<div style="font-size: 13px; font-weight: 500;">+1 (555) 392-1049</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Lead Source</div>
							<div style="font-size: 13px; font-weight: 500;"><span class="status-pill pill-purple">Instagram DM</span></div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Assigned Photographer</div>
							<div style="font-size: 13px; font-weight: 500;">Himanshu Mukane (Lead)</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Requested Shoot Date</div>
							<div style="font-size: 13px; font-weight: 500;">June 18, 2027 (Pre-wedding + Ceremony)</div>
						</div>
						<div>
							<div style="font-size: 11px; color: var(--text-muted);">Location</div>
							<div style="font-size: 13px; font-weight: 500;">Villa Monticello, Lake Como, Italy</div>
						</div>
					</div>

					<div style="padding: 12px; background: var(--bg-surface-subtle); border-radius: 6px; font-size: 12.5px; line-height: 1.5;">
						<strong>Notes from Bride:</strong> Looking for editorial-style candid coverage with analog 35mm film captures in addition to digital. Expecting ~120 guests. Rehearsal dinner coverage also requested.
					</div>
				</div>

				<div class="crm-table-container">
					<div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
						<h3 style="font-size: 14px; font-weight: 600;">Associated Quotations & Proposals</h3>
						<button class="crm-page-btn">+ Create Quotation</button>
					</div>
					<table class="crm-table">
						<thead>
							<tr>
								<th>Quote #</th>
								<th>Package Name</th>
								<th>Total Amount</th>
								<th>Sent Date</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td style="font-weight: 600;">QUO-2026-081</td>
								<td>Lake Como 2-Day Signature Film & Digital</td>
								<td style="font-weight: 600;">$4,500.00</td>
								<td style="color: var(--text-muted);">Oct 29, 2026</td>
								<td>@crmComponents.StatusPill("Viewed by Client", "blue")</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 15px; font-weight: 600; margin-bottom: 16px;">Activity Timeline & Conversation Log</h3>

					<div style="display: flex; flex-direction: column; gap: 16px;">
						<div style="display: flex; gap: 12px;">
							<div style="font-size: 16px;">💬</div>
							<div>
								<div style="font-size: 12.5px; font-weight: 600;">Instagram Message Received</div>
								<div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">"Hi! We adore your fine art style and want to know your availability for June 2027 in Italy."</div>
								<div style="font-size: 10.5px; color: var(--text-dim); margin-top: 4px;">Oct 28, 2026 at 14:12</div>
							</div>
						</div>

						<div style="display: flex; gap: 12px;">
							<div style="font-size: 16px;">📞</div>
							<div>
								<div style="font-size: 12.5px; font-weight: 600;">Discovery Video Call Completed</div>
								<div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Discussed schedule, film rolls stock, and travel arrangements. Jessica agreed to review proposal.</div>
								<div style="font-size: 10.5px; color: var(--text-dim); margin-top: 4px;">Oct 29, 2026 at 10:00</div>
							</div>
						</div>

						<div style="display: flex; gap: 12px;">
							<div style="font-size: 16px;">📄</div>
							<div>
								<div style="font-size: 12.5px; font-weight: 600;">Proposal QUO-2026-081 Sent</div>
								<div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Delivered via client portal and email.</div>
								<div style="font-size: 10.5px; color: var(--text-dim); margin-top: 4px;">Oct 29, 2026 at 11:30</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div style="display: flex; flex-direction: column; gap: 24px;">
				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Pipeline Stage</h3>
					<div style="display: flex; flex-direction: column; gap: 8px;">
						<select class="crm-select" style="width: 100%;">
							<option>New Inquiry</option>
							<option>Contacted</option>
							<option>Qualified</option>
							<option>Negotiation</option>
							<option selected>Ready to Book</option>
							<option>Converted (Won)</option>
							<option>Lost</option>
						</select>
						<button class="c-btn c-btn-primary" style="margin-top: 6px; width: 100%;">Update Stage</button>
					</div>
				</div>

				<div class="crm-table-container" style="padding: 20px;">
					<h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Next Follow-up</h3>
					<div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">Scheduled Call:</div>
					<div style="font-size: 13px; font-weight: 600; color: #ff7675; margin-bottom: 12px;">Today at 14:00 (In 2 hours)</div>
					<button class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main); width: 100%; margin-bottom: 8px;">✓ Mark Completed</button>
					<button class="c-btn" style="background: var(--bg-surface-subtle); color: var(--text-main); width: 100%;">⏰ Reschedule</button>
				</div>
			</div>
		</div>
	}
}

