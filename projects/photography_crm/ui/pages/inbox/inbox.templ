package pages

import (
	"chi-mysql-server/ui/layouts"
	"components"
	crmComponents "chi-mysql-server/ui/components"
)

templ Inbox(filter string) {
	@layouts.DashboardLayout("Unified Studio Inbox - Aperture CRM", "inbox", []layouts.BreadcrumbItem{
		{Label: "Inbox"},
	}) {
		@crmComponents.PageHeader("Unified Studio Inbox", "Consolidated client conversations across WhatsApp, Instagram DM, and Facebook Messenger.") {
			<button class="c-btn c-btn-primary">+ New Message</button>
		}

		<div style="display: grid; grid-template-columns: 300px 1fr 280px; gap: 16px; height: calc(100vh - 210px); min-height: 520px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden;">

			<div style="border-right: 1px solid var(--border-color); display: flex; flex-direction: column;">
				<div style="padding: 12px; border-bottom: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 8px;">
					<input type="text" placeholder="Search conversations..." class="crm-search-input" style="width: 100%;"/>
					<div class="crm-filter-tabs" style="width: 100%; justify-content: space-between;">
						<a href="/inbox?filter=all" class={ "crm-filter-tab", templ.KV("active", filter == "" || filter == "all") }>All</a>
						<a href="/inbox?filter=whatsapp" class={ "crm-filter-tab", templ.KV("active", filter == "whatsapp") }>WhatsApp</a>
						<a href="/inbox?filter=instagram" class={ "crm-filter-tab", templ.KV("active", filter == "instagram") }>Instagram</a>
						<a href="/inbox?filter=messenger" class={ "crm-filter-tab", templ.KV("active", filter == "messenger") }>Messenger</a>
					</div>
				</div>

				<div style="overflow-y: auto; flex: 1; display: flex; flex-direction: column;">

					<div style="padding: 14px; background: var(--bg-sidebar-active); border-left: 3px solid var(--accent-primary); border-bottom: 1px solid var(--border-row); cursor: pointer;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
							<span style="font-weight: 600; font-size: 13px; color: var(--text-main);">Jessica Parker</span>
							<span style="font-size: 10px; color: var(--text-dim);">14:12</span>
						</div>
						<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
							<span class="status-pill pill-purple" style="font-size: 9px; padding: 1px 5px;">Instagram</span>
							<span style="font-size: 11px; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">Does the quote include 35mm film?</span>
						</div>
					</div>

					<div style="padding: 14px; border-bottom: 1px solid var(--border-row); cursor: pointer;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
							<span style="font-weight: 600; font-size: 13px; color: var(--text-main);">Chloe Bennett</span>
							<span style="font-size: 10px; color: var(--text-dim);">Yesterday</span>
						</div>
						<div style="display: flex; align-items: center; gap: 6px;">
							<span class="status-pill pill-green" style="font-size: 9px; padding: 1px 5px;">WhatsApp</span>
							<span style="font-size: 11px; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">We loved the studio moodboard!</span>
						</div>
					</div>

					<div style="padding: 14px; border-bottom: 1px solid var(--border-row); cursor: pointer;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
							<span style="font-weight: 600; font-size: 13px; color: var(--text-main);">Marcus Vance</span>
							<span style="font-size: 10px; color: var(--text-dim);">2d ago</span>
						</div>
						<div style="display: flex; align-items: center; gap: 6px;">
							<span class="status-pill pill-blue" style="font-size: 9px; padding: 1px 5px;">Messenger</span>
							<span style="font-size: 11px; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">Please send the commercial license details.</span>
						</div>
					</div>
				</div>
			</div>

			<div style="display: flex; flex-direction: column; background: var(--bg-surface-subtle);">

				<div style="padding: 12px 18px; border-bottom: 1px solid var(--border-color); background: var(--bg-surface); display: flex; justify-content: space-between; align-items: center;">
					<div>
						<div style="font-weight: 600; font-size: 13px;">Jessica Parker</div>
						<div style="font-size: 11px; color: var(--text-muted);">Active now • Instagram Direct</div>
					</div>
					<div style="display: flex; gap: 8px;">
						<button class="crm-page-btn">📞 Call</button>
						<button class="crm-page-btn">📋 View Lead</button>
					</div>
				</div>

				<!-- Chat Messages Stream using Message, Bubble & Marker Primitives -->
				<div style="flex: 1; overflow-y: auto; padding: 20px 24px; display: flex; flex-direction: column; gap: 16px;">
					@components.Message() {
						@components.MessageAvatarSlot() {
							@components.Avatar(components.AvatarProps{
								Initials: "JP",
								BgColor:  "#7c5dfa",
								Size:     "sm",
							})
						}
						@components.MessageContent() {
							@components.MessageHeader() {
								<span>Jessica Parker • 13:58</span>
							}
							@components.Bubble(components.BubbleProps{Variant: components.BubbleVariantMuted}) {
								@components.BubbleContent() {
									Hi Himanshu! We received the quotation for Lake Como. Does the package include the second shooter for the rehearsal dinner as well?
								}
							}
						}
					}

					@components.Message(components.MessageProps{Align: components.AlignEnd}) {
						@components.MessageAvatarSlot() {
							@components.Avatar(components.AvatarProps{
								Initials: "HM",
								BgColor:  "#00cec9",
								Size:     "sm",
							})
						}
						@components.MessageContent() {
							@components.MessageHeader() {
								<span>You • 14:05</span>
							}
							@components.Bubble() {
								@components.BubbleContent() {
									Hello Jessica! Yes, the Lake Como Signature proposal includes full coverage with myself and our associate second shooter for both the rehearsal evening and the main wedding day, plus 10 rolls of medium format film!
								}
							}
							@components.MessageFooter() {
								<span>Delivered</span>
							}
						}
					}

					@components.Message() {
						@components.MessageAvatarSlot() {
							@components.Avatar(components.AvatarProps{
								Initials: "JP",
								BgColor:  "#7c5dfa",
								Size:     "sm",
							})
						}
						@components.MessageContent() {
							@components.BubbleGroup() {
								@components.Bubble(components.BubbleProps{Variant: components.BubbleVariantMuted}) {
									@components.BubbleContent() {
										That is perfect! We are ready to sign the contract once you send it over. Thank you!
									}
								}
								@components.Bubble(components.BubbleProps{Variant: components.BubbleVariantMuted}) {
									@components.BubbleContent() {
										Can we also include drone aerial coverage if weather permits?
									}
									@components.BubbleReactions() {
										<span>👍 1</span>
									}
								}
							}
							@components.MessageFooter() {
								<span>Read 14:13</span>
							}
						}
					}

					@components.Marker(components.MarkerProps{Role: "status"}) {
						@components.MarkerContent(components.MarkerContentProps{Class: "shimmer"}) {
							<span style="font-weight: 600; color: var(--text-main);">Jessica Parker</span> is typing...
						}
					}
				</div>

				<div style="padding: 12px 16px; background: var(--bg-surface); border-top: 1px solid var(--border-color); display: flex; gap: 10px; align-items: center;">
					<button class="crm-page-btn" title="Add attachment">📎</button>
					<input type="text" placeholder="Type your reply here..." class="crm-search-input" style="flex: 1;"/>
					<button class="c-btn c-btn-primary" style="padding: 6px 14px;">Send ➔</button>
				</div>
			</div>

			<div style="border-left: 1px solid var(--border-color); padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;">
				<div style="text-align: center; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
					<div style="width: 50px; height: 50px; border-radius: 50%; background: #7c5dfa; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 16px; margin: 0 auto 10px auto;">JP</div>
					<div style="font-weight: 600; font-size: 14px;">Jessica Parker</div>
					<div style="font-size: 11px; color: var(--text-muted);">jessica@luxuryweddings.com</div>
				</div>

				<div>
					<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px;">Lead Stage</div>
					@crmComponents.StatusPill("Ready to Book", "green")
				</div>

				<div>
					<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px;">Service & Budget</div>
					<div style="font-size: 12.5px; font-weight: 500;">Destination Wedding (Lake Como)</div>
					<div style="font-size: 12px; color: #00cec9; font-weight: 600; margin-top: 2px;">$4,500 Expected</div>
				</div>

				<div>
					<div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px;">Quick Actions</div>
					<div style="display: flex; flex-direction: column; gap: 6px;">
						<a href="/contracts?action=new&lead=Jessica+Parker" class="crm-page-btn" style="text-align: center; text-decoration: none;">📝 Generate Contract</a>
						<a href="/sessions?action=book&client=Jessica+Parker" class="crm-page-btn" style="text-align: center; text-decoration: none;">📅 Schedule Session</a>
					</div>
				</div>
			</div>
		</div>
	}
}

