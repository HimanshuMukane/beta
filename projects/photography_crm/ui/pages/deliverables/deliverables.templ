package pages

import (
	"chi-mysql-server/ui/layouts"
	crmComponents "chi-mysql-server/ui/components"
)

templ Deliverables(filter string) {
	@layouts.DashboardLayout("Client Deliverables - Aperture CRM", "deliverables", []layouts.BreadcrumbItem{
		{Label: "Deliverables"},
	}) {
		@crmComponents.PageHeader("Deliverables & Asset Delivery", "Track editing, high-resolution online gallery proofing, print labs, and USB deliveries.") {
			<button class="c-btn c-btn-primary">+ New Deliverable</button>
		}

		<div class="crm-filter-bar">
			<div class="crm-filter-tabs">
				<a href="/deliverables" class={ "crm-filter-tab", templ.KV("active", filter == "" || filter == "all") }>All Deliverables (22)</a>
				<a href="/deliverables?status=pending" class={ "crm-filter-tab", templ.KV("active", filter == "pending") }>Pending (5)</a>
				<a href="/deliverables?status=in_progress" class={ "crm-filter-tab", templ.KV("active", filter == "in_progress") }>In Progress (8)</a>
				<a href="/deliverables?status=ready" class={ "crm-filter-tab", templ.KV("active", filter == "ready") }>Ready to Deliver (4)</a>
				<a href="/deliverables?status=delivered" class={ "crm-filter-tab", templ.KV("active", filter == "delivered") }>Delivered (5)</a>
			</div>

			<input type="text" placeholder="Search deliverables..." class="crm-search-input"/>
		</div>

		<div class="crm-table-container">
			<table class="crm-table">
				<thead>
					<tr>
						<th>Deliverable Name</th>
						<th>Client</th>
						<th>Project</th>
						<th>Type</th>
						<th>Due Date</th>
						<th>Assigned Editor</th>
						<th>Status</th>
						<th style="text-align: right;">Action</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<div style="font-weight: 600;">Online Proofing Gallery (600+ High-Res)</div>
							<div style="font-size: 11px; color: var(--text-muted);">Cloud Gallery with Download PIN</div>
						</td>
						<td>Olivia & James Thornton</td>
						<td><a href="/projects/details?id=PRJ-102" style="color: var(--accent-active-text); text-decoration: none;">The Thornton Nuptials</a></td>
						<td><span class="status-pill pill-blue">Digital Gallery</span></td>
						<td style="color: #ff7675; font-weight: 600;">Nov 20, 2026</td>
						<td>Himanshu M.</td>
						<td>@crmComponents.StatusPill("In Progress", "blue")</td>
						<td style="text-align: right;">
							<button class="crm-page-btn">Update</button>
						</td>
					</tr>
					<tr>
						<td>
							<div style="font-weight: 600;">Handcrafted Italian Leather Album (12x12)</div>
							<div style="font-size: 11px; color: var(--text-muted);">Lab Order #L-992 • Lustre Paper</div>
						</td>
						<td>Olivia & James Thornton</td>
						<td><a href="/projects/details?id=PRJ-102" style="color: var(--accent-active-text); text-decoration: none;">The Thornton Nuptials</a></td>
						<td><span class="status-pill pill-purple">Physical Print</span></td>
						<td style="color: var(--text-muted);">Dec 15, 2026</td>
						<td>Vanshita S.</td>
						<td>@crmComponents.StatusPill("Pending Approval", "yellow")</td>
						<td style="text-align: right;">
							<button class="crm-page-btn">Update</button>
						</td>
					</tr>
					<tr>
						<td>
							<div style="font-weight: 600;">Commercial TIFF Color-Graded Assets (50)</div>
							<div style="font-size: 11px; color: var(--text-muted);">CMYK & sRGB Retouched</div>
						</td>
						<td>Kora Fashion Apparel</td>
						<td><a href="/projects/details?id=PRJ-103" style="color: var(--accent-active-text); text-decoration: none;">Spring Lookbook 2026</a></td>
						<td><span class="status-pill pill-green">Commercial Asset</span></td>
						<td style="color: var(--text-muted);">Nov 12, 2026</td>
						<td>Aniket K.</td>
						<td>@crmComponents.StatusPill("Ready to Deliver", "green")</td>
						<td style="text-align: right;">
							<button class="crm-page-btn">Send Link</button>
						</td>
					</tr>
				</tbody>
			</table>

			@crmComponents.Pagination(1, 2, 22)
		</div>
	}
}

