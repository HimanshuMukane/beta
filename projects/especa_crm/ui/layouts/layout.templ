package layouts

import (
	"ui/components/icons"
	"ui/components/navigation"
)

type Breadcrumb struct {
	Label string
	URL   string
}

templ MainLayout(title string, activeNav string, breadcrumbs []Breadcrumb) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Especa CRM</title>
			<link rel="stylesheet" href="/static/css/globals.css"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<link rel="stylesheet" href="/static/css/dashboard.css"/>
			<link rel="stylesheet" href="/static/css/crm_shared.css"/>
			<script src="/static/js/auth.js"></script>
		</head>
		<body>
			<div class="app-root">
				<div class="app-body">
					@navigation.AppSidebar(navigation.SidebarProps{
						Workspace: navigation.WorkspaceSwitcherProps{
							Name:     "Especa CRM",
							Subtitle: "Sales & Project Delivery",
							LogoBg:   "linear-gradient(135deg, #6c5ce7, #00cec9)",
						},
						Groups: []navigation.NavGroup{
							{
								Label: "Sales & Pipeline",
								Items: []navigation.NavItem{
									{Label: "Overview", URL: "/", Icon: icons.IconBarChart3(), Active: activeNav == "overview"},
									{Label: "Leads", URL: "/leads", Icon: icons.IconTarget(), Active: activeNav == "leads"},
									{Label: "Deals & Pipeline", URL: "/deals", Icon: icons.IconDollarSign(), Active: activeNav == "deals"},
									{Label: "Contacts", URL: "/contacts", Icon: icons.IconUsers(), Active: activeNav == "contacts"},
								},
							},
							{
								Label: "Project Operations",
								Items: []navigation.NavItem{
									{Label: "Projects & Workflow", URL: "/projects", Icon: icons.IconFolder(), Active: activeNav == "projects"},
									{Label: "Schedule & Calendar", URL: "/schedule", Icon: icons.IconCalendar(), Active: activeNav == "schedule"},
									{Label: "Proposals & Quotes", URL: "/quotes", Icon: icons.IconReceipt(), Active: activeNav == "quotes"},
								},
							},
						},
						User: navigation.UserProfileProps{
							Name:     "Workspace Manager",
							Email:    "manager@especacrm.io",
							Initials: "M",
						},
						ActiveNav: activeNav,
					})

					<main class="app-main sidebar-inset">
						<header class="app-topbar">
							<div style="display: flex; align-items: center; gap: 8px;">
								<button id="sidebar-toggle-btn" class="sidebar-toggle-btn" type="button" aria-label="Toggle Sidebar" title="Toggle Sidebar">
									@icons.IconSidebar()
								</button>
								<div class="breadcrumbs-list" style="display: flex; align-items: center; gap: 8px; font-size: 13px;">
									<a href="/" style="color: var(--text-muted); text-decoration: none;">CRM</a>
									for _, b := range breadcrumbs {
										<span style="color: var(--text-dim);">/</span>
										if b.URL != "" {
											<a href={ templ.SafeURL(b.URL) } style="color: var(--text-muted); text-decoration: none;">{ b.Label }</a>
										} else {
											<span style="color: var(--text-main); font-weight: 500;">{ b.Label }</span>
										}
									}
								</div>
							</div>
							<div style="display: flex; align-items: center; gap: 12px;">
								<span style="font-size: 12px; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">Tenant Workspace</span>
							</div>
						</header>

						<div class="page-content" style="padding: 24px;">
							{ children... }
						</div>
					</main>
				</div>
			</div>
			<script>
				(function() {
					const toggleBtn = document.getElementById('sidebar-toggle-btn');
					const sidebar = document.getElementById('sidebar');
					if (!toggleBtn || !sidebar) return;

					const savedState = localStorage.getItem('crm_sidebar_collapsed');
					if (savedState === 'true') {
						sidebar.classList.add('is-collapsed');
					}

					toggleBtn.addEventListener('click', function() {
						const isCollapsed = sidebar.classList.toggle('is-collapsed');
						localStorage.setItem('crm_sidebar_collapsed', isCollapsed);
					});
				})();
			</script>
		</body>
	</html>
}

