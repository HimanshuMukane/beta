package pages

import (
	"fmt"
	"core/utils"
	"especa_crm/models"
	"especa_crm/ui/layouts"
)

templ ProjectsList(projects []models.Project) {
	@layouts.MainLayout("Projects & Workflows - Especa CRM", "projects", []layouts.Breadcrumb{{Label: "Projects"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Project Operations & Workflows</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Monitor delivery schedules, milestones, and billing event triggers</p>
			</div>
			<div>
				<a href="/projects/new" class="c-btn c-btn-primary" style="text-decoration: none; padding: 8px 16px; font-size: 13px;">+ New Project</a>
			</div>
		</div>

		if len(projects) == 0 {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 12px;">No delivery projects found.</p>
				<a href="/projects/new" class="c-btn c-btn-primary" style="text-decoration: none;">Create First Project</a>
			</div>
		} else {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
				<table class="clickup-table" style="width: 100%;">
					<thead>
						<tr>
							<th>Project Title</th>
							<th>Delivery Model</th>
							<th>Billing Model</th>
							<th>Progress</th>
							<th>Start Date</th>
							<th>Target Deadline</th>
							<th>Status</th>
							<th style="text-align: right;">Action</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range projects {
							<tr>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s", p.ID)) } style="color: #fff; font-weight: 600; text-decoration: none;">
										{ p.Title }
									</a>
								</td>
								<td><span class="crm-badge-shown" style="font-size: 10px; padding: 2px 8px;">{ p.ProjectType }</span></td>
								<td style="color: #00cec9; font-size: 12px; font-weight: 500;">{ p.BillingModel }</td>
								<td>
									<div style="display: flex; align-items: center; gap: 8px;">
										<div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; width: 80px;">
											<div style={ templ.SafeCSSProperty(fmt.Sprintf("width: %d%%; height: 100%%; background: #6c5ce7;", p.Progress)) }></div>
										</div>
										<span style="font-size: 11px; color: var(--text-muted);">{ fmt.Sprintf("%d%%", p.Progress) }</span>
									</div>
								</td>
								<td style="color: var(--text-muted); font-size: 12px;">{ p.StartDate }</td>
								<td style="color: var(--text-muted); font-size: 12px;">{ p.TargetEndDate }</td>
								<td>
									if p.Status == "completed" {
										<span class="status-pill status-done">Completed</span>
									} else {
										<span class="status-pill status-inprogress">{ p.Status }</span>
									}
								</td>
								<td style="text-align: right;">
									<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s", p.ID)) } class="crm-page-btn" style="text-decoration: none; padding: 4px 10px; font-size: 11px;">Milestones & Schedule →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ ProjectCreate() {
	@layouts.MainLayout("Create Project - Especa CRM", "projects", []layouts.Breadcrumb{{Label: "Projects", URL: "/projects"}, {Label: "New Project"}}) {
		<div style="max-width: 650px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 6px;">Initialize Delivery Project</h2>
			<p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Set up schedule, milestones, and link commercial model</p>

			<form method="POST" action="/projects/new" style="display: flex; flex-direction: column; gap: 16px;">
				<div class="form-group">
					<label class="form-label" for="title">Project Title</label>
					<input class="form-input" id="title" name="title" type="text" placeholder="e.g. Enterprise Cloud Setup & Licensing" required/>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="project_type">Project Delivery Type</label>
						<select class="form-input" id="project_type" name="project_type" style="background: var(--bg-input);">
							<option value="licensing">Software / SaaS Licensing</option>
							<option value="fixed_deliverable">Fixed-Scope Client Deliverables</option>
							<option value="retainer">Retainer / Consulting</option>
							<option value="hybrid">Hybrid Engagement</option>
						</select>
					</div>
					<div class="form-group">
						<label class="form-label" for="billing_model">Billing Structure</label>
						<select class="form-input" id="billing_model" name="billing_model" style="background: var(--bg-input);">
							<option value="one_time">One-Time / Milestone-Based</option>
							<option value="recurring">Recurring (Monthly/Quarterly/Yearly)</option>
							<option value="hybrid">Hybrid (Setup + Recurring)</option>
						</select>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="recurring_frequency">Recurring Frequency</label>
						<select class="form-input" id="recurring_frequency" name="recurring_frequency" style="background: var(--bg-input);">
							<option value="none">None</option>
							<option value="monthly">Monthly</option>
							<option value="quarterly">Quarterly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
					<div class="form-group">
						<label class="form-label" for="one_time_fee">Upfront / Setup Amount (₹)</label>
						<input class="form-input" id="one_time_fee" name="one_time_fee" type="number" placeholder="250000"/>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="recurring_fee">Recurring Fee (₹)</label>
						<input class="form-input" id="recurring_fee" name="recurring_fee" type="number" placeholder="45000"/>
					</div>
					<div class="form-group">
						<label class="form-label" for="start_date">Start Date</label>
						<input class="form-input" id="start_date" name="start_date" type="date" required/>
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="target_end_date">Target End / Renewal Date</label>
					<input class="form-input" id="target_end_date" name="target_end_date" type="date" required/>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px;">
					<a href="/projects" class="c-btn c-btn-secondary" style="text-decoration: none; padding: 8px 16px;">Cancel</a>
					<button type="submit" class="c-btn c-btn-primary" style="padding: 8px 16px;">Create Project</button>
				</div>
			</form>
		</div>
	}
}

templ ProjectDetail(project models.Project, milestones []models.Milestone, events []models.BillingEvent) {
	@layouts.MainLayout(project.Title+" - Project Details", "projects", []layouts.Breadcrumb{{Label: "Projects", URL: "/projects"}, {Label: project.Title}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">{ project.Title }</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Type: { project.ProjectType } • Model: { project.BillingModel } • Schedule: { project.StartDate } to { project.TargetEndDate }</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%s/billing-event", project.ID)) }>
					<button type="submit" class="c-btn c-btn-primary" style="padding: 8px 16px; font-size: 13px; background: #00cec9; color: #000; font-weight: 600;">
						⚡ Emit Billing Event to Finance
					</button>
				</form>
			</div>
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
			<div style="display: flex; flex-direction: column; gap: 24px;">
				<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
						<h3 style="font-size: 16px; font-weight: 600; color: #fff;">Milestone Schedule & Delivery Verification</h3>
						<span style="font-size: 12px; color: var(--text-muted);">{ fmt.Sprintf("%d Milestones", len(milestones)) }</span>
					</div>

					<div style="display: flex; flex-direction: column; gap: 12px;">
						for _, m := range milestones {
							<div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 6px; padding: 14px; display: flex; justify-content: space-between; align-items: center;">
								<div>
									<div style="font-weight: 600; color: #fff; font-size: 14px;">{ m.Title }</div>
									<div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
										<span>Due: { m.DueDate }</span>
										if m.TriggersBilling {
											<span style="color: #00cec9; margin-left: 12px; font-weight: 500;">• Triggers Billing Event ({ utils.FormatINR(m.AmountMinor) })</span>
										}
									</div>
								</div>
								<div>
									if m.Status == "completed" {
										<span class="status-pill status-done">Completed</span>
									} else {
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/milestones/%s/complete", m.ID)) }>
											<button type="submit" class="c-btn c-btn-secondary" style="padding: 4px 10px; font-size: 11px;">
												✓ Mark Complete
											</button>
										</form>
									}
								</div>
							</div>
						}
					</div>
				</div>

				<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
					<h3 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px;">Dispatched Billing Events to Finance</h3>
					if len(events) == 0 {
						<p style="color: var(--text-muted); font-size: 13px;">No billing events emitted yet for this project.</p>
					} else {
						<table class="clickup-table" style="width: 100%;">
							<thead>
								<tr>
									<th>Event Type</th>
									<th>Billing Model</th>
									<th>Amount</th>
									<th>Status</th>
									<th>Emitted At</th>
								</tr>
							</thead>
							<tbody>
								for _, e := range events {
									<tr>
										<td style="font-weight: 600; color: #00cec9;">{ e.EventType }</td>
										<td>{ e.BillingModel }</td>
										<td>
											if e.OneTimeFeeMinor > 0 {
												{ utils.FormatINR(e.OneTimeFeeMinor) }
											} else {
												{ utils.FormatINR(e.RecurringFeeMinor) } ({ e.RecurringFrequency })
											}
										</td>
										<td><span class="status-pill status-done">{ e.Status }</span></td>
										<td style="color: var(--text-muted); font-size: 11px;">{ e.CreatedAt.Format("02 Jan 15:04") }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>

			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; height: fit-content;">
				<h3 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px;">Delivery Details</h3>
				<div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
					<div>
						<span style="color: var(--text-dim); display: block; margin-bottom: 4px;">Overall Progress</span>
						<div style="height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 4px;">
							<div style={ templ.SafeCSSProperty(fmt.Sprintf("width: %d%%; height: 100%%; background: #00cec9;", project.Progress)) }></div>
						</div>
						<span style="color: var(--text-muted); font-size: 11px;">{ fmt.Sprintf("%d%% Complete", project.Progress) }</span>
					</div>
					<div>
						<span style="color: var(--text-dim); display: block; margin-bottom: 2px;">One-Time Contract Value</span>
						<strong style="color: #fff;">{ utils.FormatINR(project.OneTimeFeeMinor) }</strong>
					</div>
					<div>
						<span style="color: var(--text-dim); display: block; margin-bottom: 2px;">Recurring License / Retainer</span>
						<strong style="color: #fff;">{ utils.FormatINR(project.RecurringFeeMinor) } ({ project.RecurringFrequency })</strong>
					</div>
					<div>
						<span style="color: var(--text-dim); display: block; margin-bottom: 2px;">Timeline Cadence</span>
						<span style="color: var(--text-muted);">{ project.StartDate } to { project.TargetEndDate }</span>
					</div>
				</div>
			</div>
		</div>
	}
}

templ ScheduleCalendar(milestones []models.Milestone, projects []models.Project) {
	@layouts.MainLayout("Delivery Calendar & Schedule - Especa CRM", "schedule", []layouts.Breadcrumb{{Label: "Schedule"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Milestone & Delivery Schedule</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Unified timeline across Software Licensing, Fixed Deliverables, and Retainer reviews</p>
			</div>
		</div>

		<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
			<h3 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px;">Timeline Feed & Deliverables</h3>
			<div style="display: flex; flex-direction: column; gap: 12px;">
				for _, m := range milestones {
					<div style="display: flex; align-items: center; gap: 16px; padding: 14px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 6px;">
						<div style="min-width: 110px; font-weight: 600; color: #6c5ce7; font-size: 13px;">
							📅 { m.DueDate }
						</div>
						<div style="flex: 1;">
							<div style="font-weight: 600; color: #fff; font-size: 14px;">{ m.Title }</div>
							<div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
								Project ID: { m.ProjectID }
								if m.TriggersBilling {
									<span style="color: #00cec9; margin-left: 8px;">• ⚡ Billing Trigger ({ utils.FormatINR(m.AmountMinor) })</span>
								}
							</div>
						</div>
						<div>
							if m.Status == "completed" {
								<span class="status-pill status-done">Completed</span>
							} else {
								<span class="status-pill status-todo">{ m.Status }</span>
							}
						</div>
					</div>
				}
			</div>
		</div>
	}
}

