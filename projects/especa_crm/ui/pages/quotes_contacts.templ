package pages

import (
	"fmt"
	"core/utils"
	"especa_crm/models"
	"especa_crm/ui/layouts"
)

templ QuotesList(quotes []models.Quote) {
	@layouts.MainLayout("Proposals & Quotes - Especa CRM", "quotes", []layouts.Breadcrumb{{Label: "Quotes"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Commercial Proposals & Quotes</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Structure quotes with One-Time, Recurring, or Hybrid commercial models</p>
			</div>
			<div>
				<a href="/quotes/new" class="c-btn c-btn-primary" style="text-decoration: none; padding: 8px 16px; font-size: 13px;">+ New Quote</a>
			</div>
		</div>

		if len(quotes) == 0 {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 12px;">No quotes created yet.</p>
				<a href="/quotes/new" class="c-btn c-btn-primary" style="text-decoration: none;">Create First Proposal</a>
			</div>
		} else {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
				<table class="clickup-table" style="width: 100%;">
					<thead>
						<tr>
							<th>Quote Title</th>
							<th>Billing Model</th>
							<th>Frequency</th>
							<th>One-Time Fee</th>
							<th>Recurring Fee</th>
							<th>Status</th>
							<th>Valid Until</th>
						</tr>
					</thead>
					<tbody>
						for _, q := range quotes {
							<tr>
								<td style="font-weight: 600; color: #fff;">{ q.Title }</td>
								<td><span class="crm-badge-shown" style="font-size: 10.5px; padding: 2px 8px;">{ q.BillingModel }</span></td>
								<td style="color: var(--text-muted); font-size: 12px;">{ q.RecurringFrequency }</td>
								<td style="color: #00cec9; font-weight: 600;">{ utils.FormatINR(q.OneTimeFeeMinor) }</td>
								<td style="color: #6c5ce7; font-weight: 600;">{ utils.FormatINR(q.RecurringFeeMinor) }</td>
								<td>
									if q.Status == "accepted" {
										<span class="status-pill status-done">Accepted</span>
									} else {
										<span class="status-pill status-inprogress">{ q.Status }</span>
									}
								</td>
								<td style="color: var(--text-muted); font-size: 12px;">{ q.ValidUntil }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ QuoteCreate() {
	@layouts.MainLayout("Create Proposal - Especa CRM", "quotes", []layouts.Breadcrumb{{Label: "Quotes", URL: "/quotes"}, {Label: "New Quote"}}) {
		<div style="max-width: 650px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 6px;">Create Commercial Proposal</h2>
			<p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Define billing model structure for prospect acceptance</p>

			<form method="POST" action="/quotes/new" style="display: flex; flex-direction: column; gap: 16px;">
				<div class="form-group">
					<label class="form-label" for="title">Proposal Title</label>
					<input class="form-input" id="title" name="title" type="text" placeholder="e.g. Master Services Agreement & SLA" required/>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="billing_model">Billing Structure Model</label>
						<select class="form-input" id="billing_model" name="billing_model" style="background: var(--bg-input);">
							<option value="one_time">One-Time Fee</option>
							<option value="recurring">Recurring Licensing / Retainer</option>
							<option value="hybrid">Hybrid (Setup + Recurring)</option>
						</select>
					</div>
					<div class="form-group">
						<label class="form-label" for="recurring_frequency">Recurring Frequency</label>
						<select class="form-input" id="recurring_frequency" name="recurring_frequency" style="background: var(--bg-input);">
							<option value="none">None</option>
							<option value="monthly">Monthly</option>
							<option value="quarterly">Quarterly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="one_time_fee">One-Time / Setup Fee (₹)</label>
						<input class="form-input" id="one_time_fee" name="one_time_fee" type="number" placeholder="250000"/>
					</div>
					<div class="form-group">
						<label class="form-label" for="recurring_fee">Recurring Fee (₹)</label>
						<input class="form-input" id="recurring_fee" name="recurring_fee" type="number" placeholder="45000"/>
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="valid_until">Valid Until Date</label>
					<input class="form-input" id="valid_until" name="valid_until" type="date"/>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px;">
					<a href="/quotes" class="c-btn c-btn-secondary" style="text-decoration: none; padding: 8px 16px;">Cancel</a>
					<button type="submit" class="c-btn c-btn-primary" style="padding: 8px 16px;">Generate Quote</button>
				</div>
			</form>
		</div>
	}
}

templ ContactsList(contacts []models.Contact) {
	@layouts.MainLayout("Contacts Directory - Especa CRM", "contacts", []layouts.Breadcrumb{{Label: "Contacts"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Customer & Contact Directory</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Centralized directory of client stakeholders and accounts</p>
			</div>
			<div>
				<a href="/contacts/new" class="c-btn c-btn-primary" style="text-decoration: none; padding: 8px 16px; font-size: 13px;">+ Add Contact</a>
			</div>
		</div>

		if len(contacts) == 0 {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 12px;">No contacts found.</p>
				<a href="/contacts/new" class="c-btn c-btn-primary" style="text-decoration: none;">Add Contact</a>
			</div>
		} else {
			<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
				<table class="clickup-table" style="width: 100%;">
					<thead>
						<tr>
							<th>Name</th>
							<th>Company</th>
							<th>Title</th>
							<th>Email</th>
							<th>Phone</th>
							<th>Tag</th>
							<th style="text-align: right;">Action</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range contacts {
							<tr>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/contacts/%s", c.ID)) } style="color: #fff; font-weight: 600; text-decoration: none;">
										{ c.Name }
									</a>
								</td>
								<td>{ c.CompanyName }</td>
								<td style="color: var(--text-muted); font-size: 12px;">{ c.Title }</td>
								<td style="color: var(--text-muted);">{ c.Email }</td>
								<td style="color: var(--text-muted);">{ c.Phone }</td>
								<td><span class="status-pill status-todo">{ c.Tag }</span></td>
								<td style="text-align: right;">
									<a href={ templ.SafeURL(fmt.Sprintf("/contacts/%s", c.ID)) } class="crm-page-btn" style="text-decoration: none; padding: 4px 10px; font-size: 11px;">View Profile →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ ContactCreate() {
	@layouts.MainLayout("Create Contact - Especa CRM", "contacts", []layouts.Breadcrumb{{Label: "Contacts", URL: "/contacts"}, {Label: "New Contact"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 6px;">Add Contact Person</h2>
			<p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Save stakeholder details to link with projects and deals</p>

			<form method="POST" action="/contacts/new" style="display: flex; flex-direction: column; gap: 16px;">
				<div class="form-group">
					<label class="form-label" for="name">Full Name</label>
					<input class="form-input" id="name" name="name" type="text" placeholder="e.g. Alyx Vance" required/>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="company_name">Company</label>
						<input class="form-input" id="company_name" name="company_name" type="text" placeholder="e.g. Black Mesa" required/>
					</div>
					<div class="form-group">
						<label class="form-label" for="title">Title / Role</label>
						<input class="form-input" id="title" name="title" type="text" placeholder="e.g. VP Operations"/>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="email">Email</label>
						<input class="form-input" id="email" name="email" type="email" placeholder="alyx@blackmesa.com" required/>
					</div>
					<div class="form-group">
						<label class="form-label" for="phone">Phone</label>
						<input class="form-input" id="phone" name="phone" type="text" placeholder="+1-555-0144"/>
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="tag">Category Tag</label>
					<select class="form-input" id="tag" name="tag" style="background: var(--bg-input);">
						<option value="customer">Active Customer</option>
						<option value="prospect">Prospect</option>
						<option value="vip">VIP / Enterprise</option>
						<option value="partner">Partner</option>
					</select>
				</div>

				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px;">
					<a href="/contacts" class="c-btn c-btn-secondary" style="text-decoration: none; padding: 8px 16px;">Cancel</a>
					<button type="submit" class="c-btn c-btn-primary" style="padding: 8px 16px;">Save Contact</button>
				</div>
			</form>
		</div>
	}
}

templ ContactDetail(contact models.Contact) {
	@layouts.MainLayout(contact.Name+" - Profile", "contacts", []layouts.Breadcrumb{{Label: "Contacts", URL: "/contacts"}, {Label: contact.Name}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">{ contact.Name }</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">{ contact.Title } at { contact.CompanyName }</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href={ templ.SafeURL(fmt.Sprintf("mailto:%s", contact.Email)) } class="c-btn c-btn-secondary" style="text-decoration: none; padding: 8px 16px; font-size: 13px;">
					✉️ Email
				</a>
			</div>
		</div>

		<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; max-width: 650px;">
			<h3 style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px;">Contact Details</h3>
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 13px;">
				<div>
					<span style="color: var(--text-dim); display: block; margin-bottom: 4px;">Email</span>
					<strong style="color: #fff;">{ contact.Email }</strong>
				</div>
				<div>
					<span style="color: var(--text-dim); display: block; margin-bottom: 4px;">Phone</span>
					<strong style="color: #fff;">{ contact.Phone }</strong>
				</div>
				<div>
					<span style="color: var(--text-dim); display: block; margin-bottom: 4px;">Category</span>
					<span class="status-pill status-todo">{ contact.Tag }</span>
				</div>
				<div>
					<span style="color: var(--text-dim); display: block; margin-bottom: 4px;">Organization</span>
					<strong style="color: #fff;">{ contact.CompanyName }</strong>
				</div>
			</div>
		</div>
	}
}

