package pages

templ NotFound() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>404</title>
			<link rel="stylesheet" href="/static/css/globals.css"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body class="plain-center-error">
			404
		</body>
	</html>
}

templ InternalError() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>500</title>
			<link rel="stylesheet" href="/static/css/globals.css"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body class="plain-center-error">
			500
		</body>
	</html>
}
