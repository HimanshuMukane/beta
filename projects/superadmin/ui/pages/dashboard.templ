package pages

import (
	"ui/layouts"
	"ui/components/icons"
	"ui/components/tables"
)

type TaskRow struct {
	Index      int
	Name       string
	Assignees  []Assignee
	Status     string
	StatusType string // "todo" | "inprogress" | "done"
	DueDate    string
	Priority   string
}

type Assignee struct {
	Initials string
	BgColor  string
	Name     string
}

type FavItem struct {
	Name     string
	Gradient string
}

templ Dashboard(title string, rows []TaskRow) {
	@layouts.DashboardLayout(title, "dashboard", []layouts.BreadcrumbItem{
		{Label: "Tasks Overview"},
	}) {
		<div class="view-tabs-bar">
			<a href="/" class="view-tab active">
				@icons.IconTable()
				<span>Table</span>
			</a>
			<a href="/" class="view-tab">
				@icons.IconList()
				<span>List</span>
			</a>
		</div>

		<div class="table-meta-bar">
			<div class="meta-bar-left">
				<div class="crm-badge-shown">
					@icons.IconCircleDot()
					<span>Shown</span>
				</div>
			</div>
			<div class="meta-bar-right">
				<button class="header-icon-btn" title="Filter">
					@icons.IconFilter()
				</button>
				<button class="header-icon-btn" title="Group">
					@icons.IconSlidersHorizontal()
				</button>
				<button class="header-icon-btn" title="Search">
					@icons.IconSearch()
				</button>
				<button class="btn-add-task">
					@icons.IconPlus()
					<span>Task</span>
				</button>
			</div>
		</div>

		<div class="table-workspace-container">
			@tables.Table() {
				<thead>
					<tr>
						<th style="width: 32px; text-align: center;"><input type="checkbox"/></th>
						<th style="min-width: 240px;">Name</th>
						<th style="min-width: 180px;">Assignee</th>
						<th style="min-width: 140px;">Status</th>
						<th style="min-width: 130px;">Due date</th>
						<th style="min-width: 120px;">Priority</th>
						<th style="width: 50px; text-align: right;">Action</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr>
							<td style="text-align: center;"><input type="checkbox"/></td>
							<td>
								<span style="color: var(--text-dim); margin-right: 8px; font-size: 11px;">{ templ.EscapeString(string(rune('0' + row.Index))) }</span>
								<span style="color: var(--text-dim); margin-right: 6px;">⚪</span>
								<span style="font-weight: 500; color: var(--text-main);">{ row.Name }</span>
							</td>
							<td>
								<div class="avatar-stack">
									for _, a := range row.Assignees {
										<span class="user-badge-mini" style={ "background-color: " + a.BgColor + ";" }>{ a.Initials }</span>
									}
								</div>
								<span style="font-size: 12px; color: var(--text-main); margin-left: 6px;">
									if len(row.Assignees) > 0 {
										{ row.Assignees[0].Name }
										if len(row.Assignees) > 1 {
											, { row.Assignees[1].Name }
										}
									}
								</span>
							</td>
							<td>
								<span class={ "status-pill status-" + row.StatusType }>
									<span class="status-dot-ring"></span>
									{ row.Status }
								</span>
							</td>
							<td style="color: var(--text-muted); font-size: 11.5px;">
								if row.DueDate != "" {
									{ row.DueDate }
								} else {
									<span style="color: var(--text-dim);">-</span>
								}
							</td>
							<td style="font-size: 11px;">
								if row.Priority != "" {
									<span class="priority-flag">🚩 { row.Priority }</span>
								} else {
									<span style="color: var(--text-dim);">-</span>
								}
							</td>
							<td style="text-align: right;">
								<button class="crm-page-btn" style="text-decoration: none; padding: 3px 8px; font-size: 11px;">View</button>
							</td>
						</tr>
					}
				</tbody>
			}
		</div>
	}
}
