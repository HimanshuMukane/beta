package pages

import (
	"fmt"
	"finance/models"
	"finance/ui/layouts"
	"shared"
)

templ InvoicesList(invoices []models.Invoice) {
	@layouts.MainLayout("Invoices", "invoices", []layouts.Breadcrumb{{Label: "Finance"}, {Label: "Invoices"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Invoices & Billing</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Software client invoices, GST tracking, and payment reconciliations</p>
			</div>
			<div>
				<a href="/invoices/new" class="finance-action-btn">+ New Invoice</a>
			</div>
		</div>

		if len(invoices) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No invoices generated yet.</p>
				<a href="/invoices/new" class="finance-action-btn">+ Generate First Invoice</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Invoice #</th>
							<th>Client</th>
							<th>Invoice Date</th>
							<th>Due Date</th>
							<th>Subtotal</th>
							<th>Tax (18% GST)</th>
							<th>Total Amount</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, inv := range invoices {
							<tr>
								<td><strong style="color: #74b9ff;">{ inv.InvoiceNumber }</strong></td>
								<td>{ inv.ClientName }</td>
								<td>{ inv.InvoiceDate }</td>
								<td>{ inv.DueDate }</td>
								<td>{ shared.FormatINR(inv.SubtotalMinor) }</td>
								<td>{ shared.FormatINR(inv.TaxMinor) }</td>
								<td><strong style="color: #fff;">{ shared.FormatINR(inv.TotalMinor) }</strong></td>
								<td>
									if inv.Status == "paid" {
										<span class="finance-badge-pill finance-badge-paid">PAID</span>
									} else {
										<span class="finance-badge-pill finance-badge-pending">UNPAID</span>
									}
								</td>
								<td>
									if inv.Status != "paid" {
										<a href={ templ.SafeURL(fmt.Sprintf("/payments/new?invoice_id=%s", inv.ID)) } style="color: #00cec9; font-size: 12px; text-decoration: none;">Record Payment →</a>
									} else {
										<span style="color: var(--text-muted); font-size: 12px;">Settled</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ InvoiceCreate(clients []models.Client, products []models.Product) {
	@layouts.MainLayout("Create Invoice", "invoices", []layouts.Breadcrumb{{Label: "Invoices", URL: "/invoices"}, {Label: "New"}}) {
		<div style="max-width: 650px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Generate Client Invoice</h2>
			<form method="POST" action="/invoices/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Select Client</label>
					<select name="client_id" required>
						<option value="">-- Choose Client --</option>
						for _, c := range clients {
							<option value={ c.ID }>{ c.CompanyName } ({ c.Name })</option>
						}
					</select>
				</div>
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label>Invoice Date</label>
						<input type="date" name="invoice_date" value="2025-01-01" required/>
					</div>
					<div class="finance-form-group">
						<label>Due Date</label>
						<input type="date" name="due_date" value="2025-01-15" required/>
					</div>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Line Item Description</label>
					<input type="text" name="description" placeholder="e.g. Monthly Software License & Maintenance" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Subtotal Amount (in ₹, before GST)</label>
					<input type="number" name="subtotal" placeholder="e.g. 50000" step="1" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Tax Treatment</label>
					<select name="tax_type">
						<option value="gst_18">Standard 18% GST (9% CGST + 9% SGST)</option>
						<option value="none">Zero Tax / Exempt</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 20px;">
					<label>Notes / Payment Terms</label>
					<textarea name="notes" rows="2" placeholder="Bank details, payment instructions..."></textarea>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href="/invoices" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Generate & Post to Accounts Receivable</button>
				</div>
			</form>
		</div>
	}
}

templ PaymentsList(payments []models.Payment) {
	@layouts.MainLayout("Payments & Cash Receipts", "payments", []layouts.Breadcrumb{{Label: "Finance"}, {Label: "Payments"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Recorded Cash & Bank Payments</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Actual money received or paid. Represents cash basis accounting view.</p>
			</div>
			<div>
				<a href="/payments/new" class="finance-action-btn">+ Record Payment</a>
			</div>
		</div>

		if len(payments) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No payments recorded yet.</p>
				<a href="/payments/new" class="finance-action-btn">+ Record First Payment</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Date</th>
							<th>Type</th>
							<th>Method</th>
							<th>Reference</th>
							<th>Amount</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range payments {
							<tr>
								<td>{ p.PaymentDate }</td>
								<td>
									if p.PaymentType == "incoming" {
										<span class="finance-badge-pill finance-badge-active">INCOMING (CLIENT)</span>
									} else {
										<span class="finance-badge-pill finance-badge-pending">OUTGOING (VENDOR)</span>
									}
								</td>
								<td>{ p.PaymentMethod }</td>
								<td>
									if p.Reference != nil {
										<code>{ *p.Reference }</code>
									} else {
										<span>-</span>
									}
								</td>
								<td><strong style="color: #00b894;">{ shared.FormatINR(p.AmountMinor) }</strong></td>
								<td><span class="finance-badge-pill finance-badge-posted">{ p.Status }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ PaymentCreate(invoices []models.Invoice, preselectedInvoiceID string) {
	@layouts.MainLayout("Record Payment", "payments", []layouts.Breadcrumb{{Label: "Payments", URL: "/payments"}, {Label: "Record"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Record Cash / Bank Receipt</h2>
			<form method="POST" action="/payments/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Allocate To Invoice (Optional)</label>
					<select name="invoice_id">
						<option value="">-- No specific invoice (Direct receipt) --</option>
						for _, inv := range invoices {
							<option value={ inv.ID } selected?={ inv.ID == preselectedInvoiceID }>{ inv.InvoiceNumber } - { inv.ClientName } ({ shared.FormatINR(inv.TotalMinor) })</option>
						}
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Payment Date</label>
					<input type="date" name="payment_date" value="2025-01-05" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Amount Received (in ₹)</label>
					<input type="number" name="amount" placeholder="e.g. 59000" step="1" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Payment Method</label>
					<select name="payment_method">
						<option value="bank_transfer">HDFC Bank IMPS / NEFT / RTGS</option>
						<option value="upi">UPI / QR Code</option>
						<option value="cheque">Cheque</option>
						<option value="cash">Cash</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 20px;">
					<label>Transaction Reference / UTR Number</label>
					<input type="text" name="reference" placeholder="e.g. UTR-9831827419"/>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href="/payments" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Post Cash Receipt to Bank</button>
				</div>
			</form>
		</div>
	}
}

templ BillsList(bills []models.Bill) {
	@layouts.MainLayout("Expenses & Bills", "bills", []layouts.Breadcrumb{{Label: "Finance"}, {Label: "Expenses & Bills"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Company Expenses & Vendor Bills</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">AWS, GitHub, Office Rent, Software Tools, and External Services</p>
			</div>
			<div>
				<a href="/bills/new" class="finance-action-btn">+ Record Expense</a>
			</div>
		</div>

		if len(bills) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No expense bills recorded yet.</p>
				<a href="/bills/new" class="finance-action-btn">+ Record First Bill</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Bill #</th>
							<th>Vendor Name</th>
							<th>Bill Date</th>
							<th>Due Date</th>
							<th>Total Amount</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, b := range bills {
							<tr>
								<td><code>{ b.BillNumber }</code></td>
								<td><strong style="color: #fff;">{ b.VendorName }</strong></td>
								<td>{ b.BillDate }</td>
								<td>{ b.DueDate }</td>
								<td><strong style="color: #e17055;">{ shared.FormatINR(b.TotalMinor) }</strong></td>
								<td><span class="finance-badge-pill finance-badge-pending">{ b.Status }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ BillCreate() {
	@layouts.MainLayout("Record Bill / Expense", "bills", []layouts.Breadcrumb{{Label: "Bills", URL: "/bills"}, {Label: "New"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Record Vendor Bill / Operating Expense</h2>
			<form method="POST" action="/bills/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Vendor Name</label>
					<input type="text" name="vendor_name" placeholder="e.g. Amazon Web Services / DigitalOcean" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Bill / Invoice Number</label>
					<input type="text" name="bill_number" placeholder="e.g. AWS-INV-2025-01" required/>
				</div>
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
					<div class="finance-form-group">
						<label>Bill Date</label>
						<input type="date" name="bill_date" value="2025-01-02" required/>
					</div>
					<div class="finance-form-group">
						<label>Due Date</label>
						<input type="date" name="due_date" value="2025-01-16" required/>
					</div>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Expense Category / Account</label>
					<select name="account_id">
						<option value="acc_5004">Cloud & Database Hosting Expense</option>
						<option value="acc_5005">Software Subscriptions & Tools</option>
						<option value="acc_5006">Office & Administrative Expense</option>
						<option value="acc_5003">Sales Commission Expense</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 20px;">
					<label>Amount (in ₹)</label>
					<input type="number" name="amount" placeholder="e.g. 15000" step="1" required/>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px;">
					<a href="/bills" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Post Expense & Accounts Payable</button>
				</div>
			</form>
		</div>
	}
}
