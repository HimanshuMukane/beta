package pages

import (
	"fmt"
	"finance/models"
	"finance/ui/layouts"
	"shared"
)

type AnalyticsData struct {
	TotalAccrualRevenueMinor int64
	TotalCashRevenueMinor    int64
	MRRMinor                 int64
	ARRMinor                 int64
	TotalPayrollMinor        int64
	TotalExpenseMinor        int64
	NetAccrualProfitMinor    int64
	NetCashProfitMinor       int64
}

templ AnalyticsView(data AnalyticsData) {
	@layouts.MainLayout("Financial Analytics & Reporting", "analytics", []layouts.Breadcrumb{{Label: "Analytics"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Financial Analytics & Trends</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Accrual vs Cash Basis, Software Recurring Revenue, and Cost Breakdown</p>
			</div>
		</div>

		<!-- Accrual vs Cash Basis Comparison Card -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
			<h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 15px;">Accrual vs. Cash Accounting Basis Comparison</h3>
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
				<div style="background: #141824; border: 1px solid #2d3748; border-radius: 6px; padding: 16px;">
					<h4 style="font-size: 14px; font-weight: 600; color: #74b9ff; margin-bottom: 10px;">Accrual Basis (Revenue earned, expenses incurred)</h4>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
						<span style="color: var(--text-muted);">Recognized Revenue:</span>
						<strong style="color: #00b894;">{ shared.FormatINR(data.TotalAccrualRevenueMinor) }</strong>
					</div>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
						<span style="color: var(--text-muted);">Incurred Expenses:</span>
						<strong style="color: #e17055;">{ shared.FormatINR(data.TotalExpenseMinor) }</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid #2d3748; font-weight: 700;">
						<span>Net Accrual Profit:</span>
						<span style="color: #74b9ff;">{ shared.FormatINR(data.NetAccrualProfitMinor) }</span>
					</div>
				</div>

				<div style="background: #141824; border: 1px solid #2d3748; border-radius: 6px; padding: 16px;">
					<h4 style="font-size: 14px; font-weight: 600; color: #00cec9; margin-bottom: 10px;">Cash Basis (Actual cash receipts & payments)</h4>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
						<span style="color: var(--text-muted);">Cash Receipts (Bank):</span>
						<strong style="color: #00b894;">{ shared.FormatINR(data.TotalCashRevenueMinor) }</strong>
					</div>
					<div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
						<span style="color: var(--text-muted);">Cash Payments:</span>
						<strong style="color: #e17055;">{ shared.FormatINR(data.TotalExpenseMinor) }</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid #2d3748; font-weight: 700;">
						<span>Net Cash Profit:</span>
						<span style="color: #00cec9;">{ shared.FormatINR(data.NetCashProfitMinor) }</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Recurring Metrics -->
		<div class="finance-card-grid">
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">MRR (Monthly Recurring)</div>
				<div style="font-size: 20px; font-weight: 700; color: #00b894; margin-top: 4px;">{ shared.FormatINR(data.MRRMinor) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">ARR (Annual Run Rate)</div>
				<div style="font-size: 20px; font-weight: 700; color: #0984e3; margin-top: 4px;">{ shared.FormatINR(data.ARRMinor) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Total Monthly Payroll Cost</div>
				<div style="font-size: 20px; font-weight: 700; color: #fab1a0; margin-top: 4px;">{ shared.FormatINR(data.TotalPayrollMinor) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Company Operating Margin</div>
				<div style="font-size: 20px; font-weight: 700; color: #74b9ff; margin-top: 4px;">
					if data.TotalAccrualRevenueMinor > 0 {
						{ fmt.Sprintf("%.1f%%", float64(data.NetAccrualProfitMinor)*100.0/float64(data.TotalAccrualRevenueMinor)) }
					} else {
						<span>0%</span>
					}
				</div>
			</div>
		</div>
	}
}

templ TagsAndTaxSettings(tags []models.Tag, taxes []models.TaxConfiguration) {
	@layouts.MainLayout("Tags & Tax Configuration", "tags", []layouts.Breadcrumb{{Label: "Configuration"}, {Label: "Tags & Tax"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Tags & Tax Configurations</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Manage analytics tags (non-computational) and statutory tax definitions (CGST/SGST/IGST/TDS)</p>
			</div>
		</div>

		<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
			<!-- Tags Management -->
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 20px;">
				<h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 12px;">Categorization & Analytics Tags</h3>
				<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 16px;">Tags do not control financial formulas or calculation logic.</p>

				<form method="POST" action="/settings/tags/new" style="display: flex; gap: 10px; margin-bottom: 18px;">
					<input type="text" name="name" placeholder="Tag Name (e.g. Enterprise, R&D)" style="flex: 2; background: #141824; border: 1px solid #2d3748; color: #fff; padding: 6px 10px; border-radius: 4px; font-size: 13px;" required/>
					<input type="color" name="color" value="#00cec9" style="flex: 0 0 40px; height: 32px; background: transparent; border: none; cursor: pointer;"/>
					<button type="submit" class="finance-action-btn" style="flex: 1; justify-content: center;">+ Add Tag</button>
				</form>

				<div style="display: flex; flex-wrap: wrap; gap: 8px;">
					for _, t := range tags {
						<span style={ fmt.Sprintf("display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; background: rgba(255,255,255,0.06); border: 1px solid %s; color: %s;", t.Color, t.Color) }>
							<span style={ fmt.Sprintf("width: 8px; height: 8px; border-radius: 50%%; background: %s;", t.Color) }></span>
							{ t.Name }
						</span>
					}
				</div>
			</div>

			<!-- Tax Configuration -->
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 20px;">
				<h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 12px;">Tax Treatments</h3>
				<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 16px;">Configurable statutory tax schedules and component tax items.</p>

				for _, tc := range taxes {
					<div style="background: #141824; border: 1px solid #2d3748; border-radius: 6px; padding: 14px; margin-bottom: 12px;">
						<div style="font-weight: 600; color: #fff; font-size: 14px;">{ tc.Name }</div>
						<div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">{ *tc.Description }</div>
						<div style="margin-top: 10px; display: flex; gap: 8px;">
							<span class="finance-badge-pill finance-badge-posted">CGST 9% (acc_2002)</span>
							<span class="finance-badge-pill finance-badge-posted">SGST 9% (acc_2002)</span>
						</div>
					</div>
				}
			</div>
		</div>
	}
}
