package pages

import (
	"fmt"
	"finance/models"
	"finance/ui/layouts"
	"shared"
)

templ EmployeesList(employees []models.Employee, payrollPeriods []models.PayrollPeriod) {
	@layouts.MainLayout("Employees & Payroll", "employees", []layouts.Breadcrumb{{Label: "Employees"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Employees & Payroll</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Manage full-time staff, interns, contractors, salary components, and monthly payroll</p>
			</div>
			<div style="display: flex; gap: 8px;">
				<a href="/payroll/process" class="finance-action-btn" style="background: #00cec9; color: #000;">⚡ Run Monthly Payroll</a>
				<a href="/employees/new" class="finance-action-btn">+ Add Employee</a>
			</div>
		</div>

		<!-- Employees table -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden; margin-bottom: 25px;">
			<div style="padding: 14px 18px; border-bottom: 1px solid #2d3748; font-weight: 600; color: #fff;">
				Active Staff & Contractors
			</div>
			if len(employees) == 0 {
				<div style="padding: 40px; text-align: center; color: var(--text-muted);">
					No employees added yet. Click "+ Add Employee" to get started.
				</div>
			} else {
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Name & Email</th>
							<th>Designation</th>
							<th>Type</th>
							<th>Department</th>
							<th>Monthly Comp</th>
							<th>Annual Cost</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, emp := range employees {
							<tr>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/employees/detail?id=%s", emp.ID)) } style="color: #fff; font-weight: 600; text-decoration: none;">
										{ emp.Name }
									</a>
									<div style="font-size: 11px; color: var(--text-muted);">{ emp.Email }</div>
								</td>
								<td>{ emp.Designation }</td>
								<td><span class="finance-badge-pill finance-badge-draft">{ emp.EmploymentType }</span></td>
								<td>{ emp.Department }</td>
								<td><strong style="color: #00b894;">{ shared.FormatINR(emp.MonthlyCompensationMinor) }</strong></td>
								<td>{ shared.FormatINR(emp.AnnualCompensationMinor) }</td>
								<td><span class="finance-badge-pill finance-badge-active">{ emp.Status }</span></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/employees/detail?id=%s", emp.ID)) } style="color: #74b9ff; font-size: 12px; text-decoration: none;">Compensation →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<!-- Payroll Periods History -->
		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<div style="padding: 14px 18px; border-bottom: 1px solid #2d3748; font-weight: 600; color: #fff;">
				Processed Payroll Batches
			</div>
			if len(payrollPeriods) == 0 {
				<div style="padding: 30px; text-align: center; color: var(--text-muted);">
					No payroll periods processed yet. Click "Run Monthly Payroll" above to generate this month's payroll.
				</div>
			} else {
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Period Name</th>
							<th>Start Date</th>
							<th>End Date</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, pp := range payrollPeriods {
							<tr>
								<td><strong style="color: #74b9ff;">{ pp.Name }</strong></td>
								<td>{ pp.StartDate }</td>
								<td>{ pp.EndDate }</td>
								<td><span class="finance-badge-pill finance-badge-posted">{ pp.Status }</span></td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/payroll/period?id=%s", pp.ID)) } style="color: #00cec9; font-size: 12px; text-decoration: none;">View Register →</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ EmployeeDetail(emp models.Employee, comp *models.EmployeeCompensation, components []models.EmployeeCompensationComponent, templates []models.FinancialTemplate, gross int64, deductions int64, net int64, employerCost int64) {
	@layouts.MainLayout(emp.Name, "employees", []layouts.Breadcrumb{{Label: "Employees", URL: "/employees"}, {Label: emp.Name}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<div style="display: flex; align-items: center; gap: 8px;">
					<h1 style="font-size: 22px; font-weight: 700; color: #fff;">{ emp.Name }</h1>
					<span class="finance-badge-pill finance-badge-draft">{ emp.Designation }</span>
					<span class="finance-badge-pill finance-badge-active">{ emp.EmploymentType }</span>
				</div>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Department: { emp.Department } | Joined: { emp.JoiningDate }</p>
			</div>
			<div>
				<a href="/employees" class="finance-action-btn" style="background: #2d3748;">← Back to Employees</a>
			</div>
		</div>

		<div class="finance-card-grid">
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Base Salary (Monthly)</div>
				<div style="font-size: 20px; font-weight: 700; color: #fff; margin-top: 4px;">
					if comp != nil {
						{ shared.FormatINR(comp.BaseAmountMinor) }
					} else {
						<span>₹0</span>
					}
				</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Gross Earnings</div>
				<div style="font-size: 20px; font-weight: 700; color: #00b894; margin-top: 4px;">{ shared.FormatINR(gross) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Employee Deductions (PF/TDS)</div>
				<div style="font-size: 20px; font-weight: 700; color: #e17055; margin-top: 4px;">{ shared.FormatINR(deductions) }</div>
			</div>
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 16px;">
				<div style="font-size: 12px; color: var(--text-muted);">Net Take-Home Payable</div>
				<div style="font-size: 20px; font-weight: 700; color: #74b9ff; margin-top: 4px;">{ shared.FormatINR(net) }</div>
			</div>
		</div>

		<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-top: 20px;">
			<div>
				<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px; margin-bottom: 20px;">
					<h3 style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px;">Applied Compensation Breakdown</h3>
					if len(components) == 0 {
						<p style="color: var(--text-muted); font-size: 13px;">No additional components configured. Add HRA, Allowance, PF, or Bonus on the right.</p>
					} else {
						<table class="finance-table" style="margin-top: 0;">
							<thead>
								<tr>
									<th>Component</th>
									<th>Type</th>
									<th>Calculation</th>
									<th>Monthly Amount</th>
									<th>Status</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range components {
									<tr>
										<td><strong>{ c.NameSnapshot }</strong></td>
										<td>
											if c.Classification == "gross_earning" {
												<span class="finance-badge-pill finance-badge-active">Earnings</span>
											} else if c.Classification == "payroll_deduction" {
												<span class="finance-badge-pill finance-badge-pending">Deduction</span>
											} else {
												<span class="finance-badge-pill finance-badge-posted">Employer Cost</span>
											}
										</td>
										<td>
											if c.CalculationType == "percentage" {
												<span>{ fmt.Sprintf("%.2f%% of Base", float64(c.Percentage)/100.0) }</span>
											} else {
												<span>Fixed</span>
											}
										</td>
										<td><strong>{ shared.FormatINR(c.AmountMinor) }</strong></td>
										<td><span class="finance-badge-pill finance-badge-active">{ c.Status }</span></td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>

			<div>
				<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px; margin-bottom: 20px;">
					<h3 style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px;">Configure Base Salary</h3>
					<form method="POST" action="/employees/set-base">
						<input type="hidden" name="employee_id" value={ emp.ID }/>
						<div class="finance-form-group" style="margin-bottom: 12px;">
							<label>Monthly Base Salary (₹)</label>
							<input type="number" name="amount" placeholder="e.g. 50000" step="1" required/>
						</div>
						<div class="finance-form-group" style="margin-bottom: 12px;">
							<label>Effective From</label>
							<input type="date" name="effective_from" value="2025-01-01" required/>
						</div>
						<button type="submit" class="finance-action-btn" style="width: 100%; justify-content: center;">Save Base Salary</button>
					</form>
				</div>

				if comp != nil {
					<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 18px;">
						<h3 style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 12px;">Add Compensation Component</h3>
						<form method="POST" action="/employees/add-component">
							<input type="hidden" name="employee_id" value={ emp.ID }/>
							<input type="hidden" name="compensation_id" value={ comp.ID }/>
							<div class="finance-form-group" style="margin-bottom: 12px;">
								<label>Employee Template</label>
								<select name="template_id" required>
									<option value="">-- Choose Template --</option>
									for _, t := range templates {
										<option value={ t.ID }>{ t.Name } ({ t.Classification })</option>
									}
								</select>
							</div>
							<div class="finance-form-group" style="margin-bottom: 12px;">
								<label>Value (Rupees or % if percentage template)</label>
								<input type="number" name="value" placeholder="10" step="0.1" required/>
							</div>
							<button type="submit" class="finance-action-btn" style="width: 100%; justify-content: center;">Add Component</button>
						</form>
					</div>
				}
			</div>
		</div>
	}
}

templ EmployeeCreate() {
	@layouts.MainLayout("Add Employee", "employees", []layouts.Breadcrumb{{Label: "Employees", URL: "/employees"}, {Label: "New"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">Add New Employee / Contractor</h2>
			<form method="POST" action="/employees/new">
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Full Name</label>
					<input type="text" name="name" placeholder="e.g. Amit Patel" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Email Address</label>
					<input type="email" name="email" placeholder="amit@techcorp.com" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Phone Number</label>
					<input type="text" name="phone" placeholder="+91 9876543210"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Employment Type</label>
					<select name="employment_type">
						<option value="full_time">Full-Time Employee</option>
						<option value="part_time">Part-Time Employee</option>
						<option value="intern">Intern</option>
						<option value="freelancer">Freelancer</option>
						<option value="contractor">Contractor</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Designation</label>
					<input type="text" name="designation" placeholder="e.g. Senior Backend Engineer" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Department</label>
					<input type="text" name="department" placeholder="e.g. Engineering" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Joining Date</label>
					<input type="date" name="joining_date" value="2025-01-01" required/>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
					<a href="/employees" class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Save Employee</button>
				</div>
			</form>
		</div>
	}
}

templ PayrollRegister(period models.PayrollPeriod, records []models.PayrollRecord) {
	@layouts.MainLayout("Payroll Register: "+period.Name, "employees", []layouts.Breadcrumb{{Label: "Employees", URL: "/employees"}, {Label: period.Name}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Payroll Register: { period.Name }</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">{ period.StartDate } to { period.EndDate } | Status: { period.Status }</p>
			</div>
			<div>
				<a href="/employees" class="finance-action-btn" style="background: #2d3748;">← Back to Employees</a>
			</div>
		</div>

		<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
			<table class="finance-table" style="margin-top: 0;">
				<thead>
					<tr>
						<th>Employee</th>
						<th>Department</th>
						<th>Gross Earnings</th>
						<th>Employee Deductions (PF/TDS)</th>
						<th>Net Salary Payable</th>
						<th>Employer Cost (Gross + PF)</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range records {
						<tr>
							<td><strong style="color: #fff;">{ r.EmployeeName }</strong></td>
							<td>{ r.Department }</td>
							<td><strong>{ shared.FormatINR(r.GrossAmountMinor) }</strong></td>
							<td style="color: #e17055;">{ shared.FormatINR(r.EmployeeDeductionsMinor) }</td>
							<td><strong style="color: #00b894;">{ shared.FormatINR(r.NetAmountMinor) }</strong></td>
							<td><strong style="color: #0984e3;">{ shared.FormatINR(r.TotalEmployerCostMinor) }</strong></td>
							<td><span class="finance-badge-pill finance-badge-posted">{ r.Status }</span></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
