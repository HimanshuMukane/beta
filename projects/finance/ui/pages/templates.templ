package pages

import (
	"fmt"
	"finance/models"
	"finance/ui/layouts"
	"core/utils"
)

templ ProductTemplatesList(templates []models.FinancialTemplate) {
	@layouts.MainLayout("Product Financial Templates", "product_templates", []layouts.Breadcrumb{{Label: "Product Templates"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Product Financial Templates</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Reusable rules for sales commission, hosting fees, discounts, and custom development costs</p>
			</div>
			<div>
				<a href="/templates/products/new" class="finance-action-btn">+ Create Template</a>
			</div>
		</div>

		if len(templates) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No product templates configured yet.</p>
				<a href="/templates/products/new" class="finance-action-btn">+ Create First Template</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Template Name</th>
							<th>Classification</th>
							<th>Frequency</th>
							<th>Calculation Type</th>
							<th>Default Rate / Value</th>
							<th>Calculation Base</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range templates {
							<tr>
								<td>
									<strong style="color: #fff;">{ t.Name }</strong>
									if t.Description != nil {
										<div style="font-size: 11px; color: var(--text-muted);">{ *t.Description }</div>
									}
								</td>
								<td><span class="finance-badge-pill finance-badge-pending">{ t.Classification }</span></td>
								<td>{ t.DefaultFrequency }</td>
								<td><span class="finance-badge-pill finance-badge-draft">{ t.CalculationType }</span></td>
								<td>
									if t.CalculationType == "percentage" {
										<strong>{ fmt.Sprintf("%.2f%%", float64(t.DefaultPercentage)/100.0) }</strong>
									} else {
										<strong>{ utils.FormatINR(t.DefaultAmountMinor) }</strong>
									}
								</td>
								<td><code>{ t.DefaultCalculationBase }</code></td>
								<td><span class="finance-badge-pill finance-badge-active">{ t.Status }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ EmployeeTemplatesList(templates []models.FinancialTemplate) {
	@layouts.MainLayout("Employee Financial Templates", "employee_templates", []layouts.Breadcrumb{{Label: "Employee Templates"}}) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 22px; font-weight: 700; color: #fff;">Employee Financial Templates</h1>
				<p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Reusable rules for Basic Salary, HRA, Employee PF, Employer PF, TDS, and Bonuses</p>
			</div>
			<div>
				<a href="/templates/employees/new" class="finance-action-btn">+ Create Template</a>
			</div>
		</div>

		if len(templates) == 0 {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 40px; text-align: center;">
				<p style="color: var(--text-muted); margin-bottom: 15px;">No employee templates configured yet.</p>
				<a href="/templates/employees/new" class="finance-action-btn">+ Create First Template</a>
			</div>
		} else {
			<div style="background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; overflow: hidden;">
				<table class="finance-table" style="margin-top: 0;">
					<thead>
						<tr>
							<th>Template Name</th>
							<th>Classification</th>
							<th>Frequency</th>
							<th>Calculation Type</th>
							<th>Default Rate / Value</th>
							<th>Base</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range templates {
							<tr>
								<td>
									<strong style="color: #fff;">{ t.Name }</strong>
									if t.Description != nil {
										<div style="font-size: 11px; color: var(--text-muted);">{ *t.Description }</div>
									}
								</td>
								<td>
									if t.Classification == "gross_earning" {
										<span class="finance-badge-pill finance-badge-active">Earnings</span>
									} else if t.Classification == "payroll_deduction" {
										<span class="finance-badge-pill finance-badge-pending">Deduction</span>
									} else {
										<span class="finance-badge-pill finance-badge-posted">Employer Cost</span>
									}
								</td>
								<td>{ t.DefaultFrequency }</td>
								<td><span class="finance-badge-pill finance-badge-draft">{ t.CalculationType }</span></td>
								<td>
									if t.CalculationType == "percentage" {
										<strong>{ fmt.Sprintf("%.2f%%", float64(t.DefaultPercentage)/100.0) }</strong>
									} else {
										<strong>{ utils.FormatINR(t.DefaultAmountMinor) }</strong>
									}
								</td>
								<td><code>{ t.DefaultCalculationBase }</code></td>
								<td><span class="finance-badge-pill finance-badge-active">{ t.Status }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ TemplateCreate(templateType string) {
	@layouts.MainLayout("Create Financial Template", "product_templates", []layouts.Breadcrumb{{Label: "Templates"}, {Label: "New"}}) {
		<div style="max-width: 600px; margin: 0 auto; background: #1e2430; border: 1px solid #2d3748; border-radius: 8px; padding: 24px;">
			<h2 style="font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 16px;">
				if templateType == "product" {
					<span>Create Product Financial Template</span>
				} else {
					<span>Create Employee Financial Template</span>
				}
			</h2>
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/templates/%s/new", templateType)) }>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Template Name</label>
					<input type="text" name="name" placeholder="e.g. Sales Commission or Employee PF" required/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Classification</label>
					<select name="classification" required>
						if templateType == "product" {
							<option value="revenue">Revenue</option>
							<option value="contra_revenue">Contra-revenue (Discount)</option>
							<option value="expense">Direct Expense (Commission / Hosting)</option>
						} else {
							<option value="gross_earning">Gross Earning (Basic, HRA, Allowance)</option>
							<option value="payroll_deduction">Payroll Deduction (PF Employee, TDS)</option>
							<option value="employer_contribution">Employer Contribution (PF Employer, Insurance)</option>
						}
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Calculation Type</label>
					<select name="calculation_type" required>
						<option value="fixed">Fixed Amount</option>
						<option value="percentage">Percentage</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Default Fixed Amount (in Rupees, if fixed)</label>
					<input type="number" name="amount" placeholder="0" step="1"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Default Percentage (e.g. 10.0 for 10%, if percentage)</label>
					<input type="number" name="percentage" placeholder="0" step="0.1"/>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Calculation Base</label>
					<select name="calculation_base">
						if templateType == "product" {
							<option value="base_pricing">Base Pricing Item</option>
							<option value="license_fee">License Fee</option>
							<option value="total_revenue">Total Product Revenue</option>
						} else {
							<option value="base_salary">Base Salary</option>
							<option value="gross_salary">Gross Salary</option>
						}
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Default Frequency</label>
					<select name="frequency">
						<option value="monthly">Monthly</option>
						<option value="quarterly">Quarterly</option>
						<option value="yearly">Yearly</option>
						<option value="one_time">One-time</option>
					</select>
				</div>
				<div class="finance-form-group" style="margin-bottom: 14px;">
					<label>Description</label>
					<textarea name="description" rows="2" placeholder="Notes on when and how this template applies..."></textarea>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
					<a href={ templ.SafeURL(fmt.Sprintf("/templates/%ss", templateType)) } class="finance-action-btn" style="background: #2d3748;">Cancel</a>
					<button type="submit" class="finance-action-btn">Save Template</button>
				</div>
			</form>
		</div>
	}
}
