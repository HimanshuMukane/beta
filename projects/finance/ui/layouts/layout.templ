package layouts

import (
	"components"
)

type Breadcrumb struct {
	Label string
	URL   string
}

templ MainLayout(title string, activeNav string, breadcrumbs []Breadcrumb) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - TechCorp Finance</title>
			<link rel="stylesheet" href="/static/css/globals.css"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<link rel="stylesheet" href="/static/css/dashboard.css"/>
			<link rel="stylesheet" href="/static/css/crm_shared.css"/>
			<link rel="stylesheet" href="/static/css/finance.css"/>
		</head>
		<body>
			<div class="app-root">
				<div class="app-body">
					@components.AppSidebar(components.SidebarProps{
						Workspace: components.WorkspaceSwitcherProps{
							Name:     "Finance OS",
							Subtitle: "TechCorp Software (FY 2025-26)",
							LogoBg:   "linear-gradient(135deg, #0984e3, #00cec9)",
						},
						Groups: []components.NavGroup{
							{
								Label: "General",
								Items: []components.NavItem{
									{Label: "Overview", URL: "/", Icon: components.IconBarChart3(), Active: activeNav == "overview"},
									{Label: "Products & Licensing", URL: "/products", Icon: components.IconFolder(), Active: activeNav == "products"},
									{Label: "Clients", URL: "/clients", Icon: components.IconUsers(), Active: activeNav == "clients"},
									{Label: "Employees & Payroll", URL: "/employees", Icon: components.IconUserPlus(), Active: activeNav == "employees"},
								},
							},
							{
								Label: "Finance",
								Items: []components.NavItem{
									{Label: "Invoices", URL: "/invoices", Icon: components.IconDollarSign(), Active: activeNav == "invoices"},
									{Label: "Payments & Cash", URL: "/payments", Icon: components.IconTrendingUp(), Active: activeNav == "payments"},
									{Label: "Expenses & Bills", URL: "/bills", Icon: components.IconClock(), Active: activeNav == "bills"},
								},
							},
							{
								Label: "Accounting",
								Items: []components.NavItem{
									{Label: "Chart of Accounts", URL: "/accounting/coa", Icon: components.IconSparkles(), Active: activeNav == "coa"},
									{Label: "Journal Entries", URL: "/accounting/journal", Icon: components.IconTarget(), Active: activeNav == "journal"},
									{Label: "General Ledger", URL: "/accounting/ledger", Icon: components.IconBarChart3(), Active: activeNav == "ledger"},
									{Label: "Financial Statements", URL: "/accounting/statements", Icon: components.IconFolder(), Active: activeNav == "statements"},
								},
							},
							{
								Label: "Analytics",
								Items: []components.NavItem{
									{Label: "Revenue & Profitability", URL: "/analytics", Icon: components.IconTrendingUp(), Active: activeNav == "analytics"},
								},
							},
							{
								Label: "Configuration",
								Items: []components.NavItem{
									{
										Label: "Templates",
										Icon:  components.IconTarget(),
										Active: activeNav == "product_templates" || activeNav == "employee_templates",
										Children: []components.NavSubItem{
											{Label: "Product Templates", URL: "/templates/products", Active: activeNav == "product_templates"},
											{Label: "Employee Templates", URL: "/templates/employees", Active: activeNav == "employee_templates"},
										},
									},
									{Label: "Tags & Tax Settings", URL: "/settings/tags", Icon: components.IconCamera(), Active: activeNav == "tags"},
								},
							},
						},
						User: components.UserProfileProps{
							Name:     "Himanshu",
							Email:    "himanshu@techcorp.io",
							Initials: "H",
						},
						ActiveNav: activeNav,
					})

					<main class="app-main sidebar-inset">
						<header class="app-topbar">
							<div style="display: flex; align-items: center; gap: 8px;">
								<button id="sidebar-toggle-btn" class="sidebar-toggle-btn" type="button" aria-label="Toggle Sidebar" title="Toggle Sidebar">
									@components.IconSidebar()
								</button>
								<div class="breadcrumbs-list" style="display: flex; align-items: center; gap: 8px; font-size: 13px;">
									<a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a>
									for _, b := range breadcrumbs {
										<span style="color: var(--text-dim);">/</span>
										if b.URL != "" {
											<a href={ templ.SafeURL(b.URL) } style="color: var(--text-muted); text-decoration: none;">{ b.Label }</a>
										} else {
											<span style="color: var(--text-main); font-weight: 500;">{ b.Label }</span>
										}
									}
								</div>
							</div>
							<div style="display: flex; align-items: center; gap: 12px;">
								<span style="font-size: 12px; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">TechCorp Software (FY 2025-26)</span>
							</div>
						</header>

						<div class="page-content">
							{ children... }
						</div>
					</main>
				</div>
			</div>
			<script>
				(function() {
					const toggleBtn = document.getElementById('sidebar-toggle-btn');
					const sidebar = document.getElementById('sidebar');
					if (!toggleBtn || !sidebar) return;

					const savedState = localStorage.getItem('sidebar_collapsed');
					if (savedState === 'true') {
						sidebar.classList.add('is-collapsed');
					}

					toggleBtn.addEventListener('click', function() {
						const isCollapsed = sidebar.classList.toggle('is-collapsed');
						localStorage.setItem('sidebar_collapsed', isCollapsed);
					});
				})();
			</script>
		</body>
	</html>
}
