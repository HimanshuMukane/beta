package messages

templ Message(props ...MessageProps) {
	{{ var p MessageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignStart }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="message"
		data-align={ string(p.Align) }
		class={ "cn-message", "group/message", p.Class }
	>
		{ children... }
	</div>
}
