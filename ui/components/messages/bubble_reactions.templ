package messages

templ BubbleReactions(props ...BubbleReactionsProps) {
	{{ var p BubbleReactionsProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-reactions"
		class={ "cn-bubble-reactions", p.Class }
	>
		{ children... }
	</div>
}
