package messages

func bubbleVariantClass(v BubbleVariant) string {
	switch v {
	case BubbleVariantSecondary:
		return "cn-bubble-variant-secondary"
	case BubbleVariantMuted:
		return "cn-bubble-variant-muted"
	case BubbleVariantTinted:
		return "cn-bubble-variant-tinted"
	case BubbleVariantOutline:
		return "cn-bubble-variant-outline"
	case BubbleVariantGhost:
		return "cn-bubble-variant-ghost"
	case BubbleVariantDestructive:
		return "cn-bubble-variant-destructive"
	default:
		return "cn-bubble-variant-default"
	}
}

templ Bubble(props ...BubbleProps) {
	{{ var p BubbleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble"
		data-variant={ string(p.Variant) }
		class={ "cn-bubble", "group/bubble", bubbleVariantClass(p.Variant), p.Class }
	>
		{ children... }
	</div>
}
