package tables

import (
	"ui/utils"
)

templ TableCell(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<td
		data-slot="table-cell"
		class={ utils.CN("p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&:has([data-slot=checkbox])]:pr-0", extraClass) }
	>
		{ children... }
	</td>
}
