package chart

import (
	"context"
	"fmt"
	"strings"
	"ui/utils"
)

templ Container(props ...ContainerProps) {
	{{ var p ContainerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
	id := p.ID
	if id == "" {
		id = utils.RandomID()
	}
	chartID := "chart-" + id

	ctx = context.WithValue(ctx, configCtxKey, p.Config)
	}}
	<div
		data-slot="chart"
		data-chart={ chartID }
		class={ utils.CN(
			"cn-chart flex aspect-video justify-center text-xs [&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground [&_.recharts-cartesian-grid_line[stroke='#ccc']]:stroke-border/50 [&_.recharts-curve.recharts-tooltip-cursor]:stroke-border [&_.recharts-dot[stroke='#fff']]:stroke-transparent [&_.recharts-layer]:outline-hidden [&_.recharts-polar-grid_[stroke='#ccc']]:stroke-border [&_.recharts-radial-bar-background-sector]:fill-muted [&_.recharts-rectangle.recharts-tooltip-cursor]:fill-muted [&_.recharts-reference-line_[stroke='#ccc']]:stroke-border [&_.recharts-sector]:outline-hidden [&_.recharts-sector[stroke='#fff']]:stroke-transparent [&_.recharts-surface]:outline-hidden",
			p.Class,
		) }
		{ p.Attributes... }
	>
		if block := p.Config.styleBlock(chartID); block != "" {
			@templ.Raw("<style>" + block + "</style>")
		}
		{ children... }
	</div>
}

type Datum map[string]any

type Margin struct {
	Top, Right, Bottom, Left float64
}

type CurveType string

const (
	CurveNatural  CurveType = "natural"
	CurveMonotone CurveType = "monotone"
	CurveLinear   CurveType = "linear"
	CurveStep     CurveType = "step"
)

type CartesianGridProps struct {
	Horizontal *bool
	Vertical   *bool
}

func Bool(v bool) *bool {
	return &v
}

func Float(v float64) *float64 {
	return &v
}

func Index(i int) *int {
	return &i
}

func boolOr(v *bool, def bool) bool {
	if v == nil {
		return def
	}
	return *v
}

type XAxisProps struct {
	DataKey string

	Type          string
	Hide          bool
	TickLine      bool
	AxisLine      bool
	TickMargin    float64
	MinTickGap    float64
	TickCount     int
	TickFormatter func(any) string

	Ticks []float64

	Domain []any

	AllowDataOverflow bool

	Reversed bool
}

type YAxisProps struct {
	DataKey string

	Type          string
	Hide          bool
	TickLine      bool
	AxisLine      bool
	TickMargin    float64
	TickCount     int
	Width         float64
	TickFormatter func(any) string

	Ticks []float64

	Domain []any

	AllowDataOverflow bool
}

type TooltipProps struct {

	Cursor  *bool
	Content TooltipContentProps

	DefaultIndex *int
}

type TooltipContentProps struct {
	Indicator      string
	LabelKey       string
	HideLabel      bool
	HideIndicator  bool
	NameKey        string
	Class          string
	LabelClassName     string

	Color          string
	LabelFormatter func(any) string

	Formatter func(value any, name string, item Datum, index int) templ.Component
}

type LinearGradientProps struct {
	ID             string
	X1, Y1, X2, Y2 string
	Stops          string
}

type AreaProps struct {

	Hide    bool
	DataKey string
	Type    CurveType

	Fill        string
	Stroke      string
	StackID     string
	FillOpacity float64
}

type BarProps struct {

	Hide    bool
	DataKey string
	Fill    string
	StackID string

	Radius      any
	StrokeWidth float64

	ActiveIndex *int
	ActiveBar   *RectangleProps
}

type RectangleProps struct {
	FillOpacity      float64
	Stroke           string
	StrokeDasharray  float64
	StrokeDashoffset float64
}

type CellProps struct {
	Fill string
}

type LineProps struct {

	Hide        bool
	DataKey     string
	Type        CurveType
	Stroke      string
	StrokeWidth float64

	StrokeDasharray string

	Dot *DotProps

	ActiveDot *ActiveDotProps
}

type DotProps struct {
	R           float64
	FillOpacity float64
	Fill        string
	DataFill    bool
	Icon        templ.Component
	Size        float64

	Show func(index int, row Datum) bool
}

type ActiveDotProps struct {
	R float64
}

type LabelListProps struct {

	Position    string
	Offset      float64
	FontSize    float64
	FillOpacity float64
	Class       string
	DataKey     string
	Formatter   func(any) string
}

type LegendProps struct {

	NameKey string
	Class   string

	VerticalAlign string

	HideIcon bool
}

type LineChartProps struct {

	AccessibilityLayer bool
	Data               []Datum
	Margin             *Margin
}

type PieProps struct {
	Data        []Datum
	DataKey     string
	NameKey     string
	InnerRadius float64

	OuterRadius float64
	StrokeWidth float64

	Stroke string

	Label     *PieLabelProps
	LabelLine *bool

	ActiveIndex *int
	ActiveShape []SectorProps
}

type PieLabelProps struct {

	Fill string
}

type SectorProps struct {
	InnerRadius float64
	OuterRadius float64
}

type LabelProps struct {
	Spans []LabelSpan

	DominantBaseline string
}

type LabelSpan struct {
	Text  string
	Class string

	OffsetY float64
}

type AreaChartProps struct {

	AccessibilityLayer bool
	Data               []Datum
	Margin             *Margin

	StackOffset string
}

type BarChartProps struct {

	AccessibilityLayer bool
	Data               []Datum

	Layout string
	Margin *Margin
}

type RadarChartProps struct {
	Data   []Datum
	Margin *Margin
}

type PolarGridProps struct {

	GridType string

	RadialLines *bool

	PolarRadius []float64

	Stroke      string
	StrokeWidth float64
	Class       string
}

type PolarAngleAxisProps struct {
	DataKey string

	Tick func(Datum, int) TickContent
}

type TickContent struct {
	Spans      []TickSpan
	FontSize   float64
	FontWeight string

	OffsetY float64
}

type TickSpan struct {
	Text     string
	Class    string
	FontSize float64

	Dy     string
	ResetX bool
}

type RadarProps struct {
	DataKey string
	Fill    string

	FillOpacity *float64
	Stroke      string
	StrokeWidth float64
	Dot         *DotProps
}

type RadialBarChartProps struct {
	Data []Datum

	StartAngle  float64
	EndAngle    *float64
	InnerRadius float64

	OuterRadius float64
	Margin      *Margin
}

type RadialBarProps struct {
	DataKey string
	Fill    string

	Background   bool
	CornerRadius float64
	StackID      string
	Class        string
}

type PolarRadiusAxisProps struct {

	Tick     *bool
	TickLine *bool
	AxisLine *bool
}

type PieChartProps struct{}

const (
	defaultXAxisHeight  = 30.0
	defaultLegendHeight = 28.0
)

type chartState struct {
	kind        string
	data        []Datum
	margin      *Margin
	stackOffset string
	grid        *CartesianGridProps
	layout      string
	x           *XAxisProps
	y           *YAxisProps
	tooltip     *TooltipProps
	legend      *LegendProps
	defs        []LinearGradientProps
	areas       []AreaProps
	bars        []*barState
	lines       []*lineState
	pies        []*pieState
	polarGrid   *PolarGridProps
	angleAxis   *PolarAngleAxisProps
	radars      []RadarProps
	radialBars  []*radialBarState
	radiusAxis  *PolarRadiusAxisProps
	center      *LabelProps
	startAngle  float64
	endAngle    *float64
	innerRadius float64
	outerRadius float64

	accessibilityLayer bool
}

type radialBarState struct {
	props     RadialBarProps
	labelList *LabelListProps
}

type lineState struct {
	props     LineProps
	labelList *LabelListProps
}

type pieState struct {
	props     PieProps
	label     *LabelProps
	labelList *LabelListProps
}

type barState struct {
	props      BarProps
	labelLists []LabelListProps
	cells      []CellProps
}

type ctxKey int

const (
	configCtxKey ctxKey = iota
	stateCtxKey
)

func configFrom(ctx context.Context) Config {
	if c, ok := ctx.Value(configCtxKey).(Config); ok {
		return c
	}
	return nil
}

func stateFrom(ctx context.Context) *chartState {
	if s, ok := ctx.Value(stateCtxKey).(*chartState); ok {
		return s
	}
	return nil
}

func num(v any) float64 {
	switch n := v.(type) {
	case float64:
		return n
	case float32:
		return float64(n)
	case int:
		return float64(n)
	case int64:
		return float64(n)
	}
	return 0
}

func str(v any) string {
	return fmt.Sprint(v)
}

func renderHTML(ctx context.Context, c templ.Component) string {
	if c == nil {
		return ""
	}
	var sb strings.Builder
	if err := c.Render(ctx, &sb); err != nil {
		return ""
	}
	return sb.String()
}

func applyIcons(ctx context.Context, m *Model, config Config) {
	for i := range m.Series {
		for _, s := range config {
			if s.Key == m.Series[i].Key && s.Icon != nil {
				m.Series[i].Icon = renderHTML(ctx, s.Icon)
			}
		}
	}
}

func seriesColor(key string) string {
	return "var(--color-" + key + ")"
}

func (c Config) Label(key string) string {
	for _, s := range c {
		if s.Key == key {
			return s.Label
		}
	}
	return key
}
