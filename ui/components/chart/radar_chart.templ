package chart

import (
	"context"
)

templ RadarChart(props ...RadarChartProps) {
	{{ var p RadarChartProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
	st := &chartState{kind: "radar", data: p.Data, margin: p.Margin}
	ctx = context.WithValue(ctx, stateCtxKey, st)
	}}
	@responsiveContainer() {
		{ children... }
		@chartOutput(st)
	}
}
