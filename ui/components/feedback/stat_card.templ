package feedback

import (
	"ui/components/cards"
	"ui/components/icons"
)
templ StatCard(label string, value string, trend string, isUp bool, icon string) {
	@cards.Card("crm-stat-card") {
		<div class="crm-stat-header">
			<span class="crm-stat-label">{ label }</span>
			<span class="crm-stat-icon">
				if icon == "👥" || icon == "users" {
					@icons.IconUsers()
				} else if icon == "✨" || icon == "sparkles" {
					@icons.IconSparkles()
				} else if icon == "🎯" || icon == "target" {
					@icons.IconTarget()
				} else if icon == "📁" || icon == "folder" {
					@icons.IconFolder()
				} else if icon == "📷" || icon == "camera" {
					@icons.IconCamera()
				} else if icon == "💰" || icon == "💵" || icon == "💎" || icon == "dollar" {
					@icons.IconDollarSign()
				} else if icon == "⏳" || icon == "clock" {
					@icons.IconClock()
				} else if icon == "📈" || icon == "trending-up" {
					@icons.IconTrendingUp()
				} else if icon == "📊" || icon == "chart" {
					@icons.IconBarChart3()
				} else if icon == "🆕" || icon == "user-plus" {
					@icons.IconUserPlus()
				} else {
					<span>{ icon }</span>
				}
			</span>
		</div>
		<div class="crm-stat-value">{ value }</div>
		if trend != "" {
			<div class={ "crm-stat-trend", templ.KV("trend-up", isUp), templ.KV("trend-down", !isUp) }>
				if isUp {
					<span>↑ { trend }</span>
				} else {
					<span>↓ { trend }</span>
				}
			</div>
		}
	}
}
