package feedback

import (
)

templ PageHeader(title string, description string) {
	<div class="crm-page-header">
		<div>
			<h1 class="crm-page-title">{ title }</h1>
			if description != "" {
				<p class="crm-page-desc">{ description }</p>
			}
		</div>
		<div class="crm-page-actions">
			{ children... }
		</div>
	</div>
}
