package dialogs

import (
	"ui/utils"
)

templ DialogTitle(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<h3
		data-slot="dialog-title"
		class={ utils.CN("crm-dialog-title text-base leading-none font-medium font-heading", extraClass) }
	>
		{ children... }
	</h3>
}
