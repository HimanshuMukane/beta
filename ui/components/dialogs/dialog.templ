package dialogs

import (
	"ui/utils"
)

templ Dialog(id string, class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		id={ id }
		data-slot="dialog-overlay"
		class={ utils.CN("crm-dialog-overlay fixed inset-0 isolate z-50 bg-black/60 supports-backdrop-filter:backdrop-blur-xs", extraClass) }
	>
		{ children... }
	</div>
}
