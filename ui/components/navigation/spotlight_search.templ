package navigation

import (
	"ui/components/icons"
)
templ SpotlightSearch() {
	<div id="spotlight-search-root" class="spotlight-overlay" style="display: none;" role="dialog" aria-modal="true" aria-label="Quick search">
		<div id="spotlight-box" class="spotlight-container">
			<div class="spotlight-header-row">
				<div id="spotlight-input-wrap" class="spotlight-input-wrapper">
					<span class="spotlight-input-icon">
						@icons.IconSearch()
					</span>
					<input
						type="text"
						id="spotlight-input"
						class="spotlight-field"
						placeholder="Search studio, leads, clients, orders..."
						autocomplete="off"
						spellcheck="false"
					/>
					<button type="button" id="spotlight-clear-btn" class="spotlight-clear-btn" aria-label="Clear input">
						@icons.IconX()
					</button>
				</div>
				<div id="spotlight-pills-row" class="spotlight-pills-cluster">
					<a href="/leads" class="spotlight-pill-btn" data-tooltip="Leads" aria-label="Leads">
						@icons.IconTarget()
					</a>
					<a href="/inbox" class="spotlight-pill-btn" data-tooltip="Inbox" aria-label="Inbox">
						@icons.IconMessageSquare()
					</a>
					<a href="/clients" class="spotlight-pill-btn" data-tooltip="Clients" aria-label="Clients">
						@icons.IconUsers()
					</a>
					<a href="/sessions" class="spotlight-pill-btn" data-tooltip="Sessions" aria-label="Sessions">
						@icons.IconCalendar()
					</a>
				</div>
			</div>
			<div id="spotlight-results" class="spotlight-results-panel">
				<div class="spotlight-results-scroll">
					<div class="spotlight-group-heading">Navigation & Quick Actions</div>
					<div class="spotlight-items-list" id="spotlight-items">
						<a href="/leads?action=new" class="spotlight-item" data-title="New Lead" data-category="Leads">
							<span class="spotlight-item-icon">@icons.IconPlus()</span>
							<div class="spotlight-item-content">
								<span class="spotlight-item-title">Create New Lead</span>
								<span class="spotlight-item-desc">Add inquiry to sales pipeline</span>
							</div>
							<kbd class="spotlight-item-kbd">Leads</kbd>
						</a>
						<a href="/sessions?tab=upcoming" class="spotlight-item" data-title="Upcoming Sessions" data-category="Sessions">
							<span class="spotlight-item-icon">@icons.IconCamera()</span>
							<div class="spotlight-item-content">
								<span class="spotlight-item-title">Upcoming Photo Sessions</span>
								<span class="spotlight-item-desc">Shoots scheduled this week</span>
							</div>
							<kbd class="spotlight-item-kbd">Sessions</kbd>
						</a>
						<a href="/orders" class="spotlight-item" data-title="Orders" data-category="Orders">
							<span class="spotlight-item-icon">@icons.IconReceipt()</span>
							<div class="spotlight-item-content">
								<span class="spotlight-item-title">Orders & Invoices</span>
								<span class="spotlight-item-desc">Manage client bookings and balances</span>
							</div>
							<kbd class="spotlight-item-kbd">Billing</kbd>
						</a>
						<a href="/settings" class="spotlight-item" data-title="Studio Settings" data-category="Settings">
							<span class="spotlight-item-icon">@icons.IconSettings()</span>
							<div class="spotlight-item-content">
								<span class="spotlight-item-title">Studio Settings & Team</span>
								<span class="spotlight-item-desc">Configure brand, workflow, and integrations</span>
							</div>
							<kbd class="spotlight-item-kbd">Settings</kbd>
						</a>
					</div>
				</div>
				<div class="spotlight-footer">
					<div class="spotlight-hints">
						<span><kbd class="spotlight-hint-kbd">↑</kbd><kbd class="spotlight-hint-kbd">↓</kbd> navigate</span>
						<span><kbd class="spotlight-hint-kbd">↵</kbd> select</span>
						<span><kbd class="spotlight-hint-kbd">esc</kbd> close</span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
