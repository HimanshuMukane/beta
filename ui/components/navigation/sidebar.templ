package navigation

import (
	"ui/components/icons"
)
templ AppSidebar(props SidebarProps) {
	<aside id="sidebar" class="sidebar-07 app-sidebar">
		<!-- Header / Workspace Switcher -->
		<div class="sidebar-header">
			<button class="sidebar-team-switcher" type="button" aria-haspopup="true">
				<div class="sidebar-team-logo" style={ templ.SafeCSSProperty("background: " + props.Workspace.LogoBg) }>
					if props.Workspace.LogoIcon != nil {
						@props.Workspace.LogoIcon
					} else {
						<span class="team-logo-initial">{ string([]rune(props.Workspace.Name)[0:1]) }</span>
					}
				</div>
				<div class="sidebar-team-info">
					<span class="sidebar-team-name">{ props.Workspace.Name }</span>
					if props.Workspace.Subtitle != "" {
						<span class="sidebar-team-plan">{ props.Workspace.Subtitle }</span>
					}
				</div>
				<span class="sidebar-team-chevron">
					@icons.IconChevronsUpDown()
				</span>
			</button>
		</div>

		<!-- Nav Body -->
		<div class="sidebar-content">
			for _, grp := range props.Groups {
				<div class="sidebar-group">
					if grp.Label != "" {
						<div class="sidebar-group-label">{ grp.Label }</div>
					}
					<ul class="sidebar-menu">
						for _, item := range grp.Items {
							if len(item.Children) > 0 {
								<li class="sidebar-menu-item">
									<details class="sidebar-collapsible" open?={ item.Active || hasActiveChild(item.Children) }>
										<summary class={ "sidebar-menu-button", templ.KV("active", item.Active) }>
											<span class="sidebar-menu-icon">
												if item.Icon != nil {
													@item.Icon
												}
											</span>
											<span class="sidebar-menu-label">{ item.Label }</span>
											<span class="sidebar-chevron-indicator">
												@icons.IconChevronRight()
											</span>
										</summary>
										<ul class="sidebar-submenu">
											for _, sub := range item.Children {
												<li class="sidebar-submenu-item">
													<a href={ templ.SafeURL(sub.URL) } class={ "sidebar-submenu-button", templ.KV("active", sub.Active) }>
														<span>{ sub.Label }</span>
													</a>
												</li>
											}
										</ul>
									</details>
								</li>
							} else {
								<li class="sidebar-menu-item">
									<a href={ templ.SafeURL(item.URL) } class={ "sidebar-menu-button", templ.KV("active", item.Active) }>
										<span class="sidebar-menu-icon">
											if item.Icon != nil {
												@item.Icon
											}
										</span>
										<span class="sidebar-menu-label">{ item.Label }</span>
										if item.Badge != "" {
											<span class="sidebar-badge">{ item.Badge }</span>
										}
									</a>
								</li>
							}
						}
					</ul>
				</div>
			}
		</div>

		<!-- Footer / User Profile -->
		<div class="sidebar-footer">
			<div class="sidebar-user-pill">
				<div class="sidebar-user-avatar">
					if props.User.AvatarURL != "" {
						<img src={ props.User.AvatarURL } alt={ props.User.Name } />
					} else if props.User.Initials != "" {
						<span>{ props.User.Initials }</span>
					} else {
						<span>{ string([]rune(props.User.Name)[0:1]) }</span>
					}
				</div>
				<div class="sidebar-user-info">
					<span class="sidebar-user-name">{ props.User.Name }</span>
					if props.User.Email != "" {
						<span class="sidebar-user-email">{ props.User.Email }</span>
					}
				</div>
				<button class="sidebar-user-dots" type="button" aria-label="User menu">
					@icons.IconChevronsUpDown()
				</button>
			</div>
		</div>
	</aside>
}
