package cards

import (
	"ui/utils"
)

templ CardAction(props ...CardActionProps) {
	{{ var p CardActionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="card-action"
		class={
			utils.CN(
				"col-start-2 row-span-2 row-start-1 self-start justify-self-end",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
