package cards

import (
	"ui/utils"
)

templ CardTitle(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<h3
		data-slot="card-title"
		class={ utils.CN("crm-card-title text-base leading-snug font-medium group-data-[size=sm]/card:text-sm font-heading", extraClass) }
	>
		{ children... }
	</h3>
}
