package cards

import (
	"ui/utils"
)

templ CardFooter(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		data-slot="card-footer"
		class={ utils.CN("crm-card-footer bg-muted/50 rounded-b-xl border-t p-(--card-spacing) flex items-center", extraClass) }
	>
		{ children... }
	</div>
}
