# Root Shared Environment Variables
APP_ENV=development
SERVER_PORT=8080

# Shared MySQL Host & Port
DB_HOST=127.0.0.1
DB_PORT=3306

# Application Session Security & Limen Auth Secret
SESSION_COOKIE_NAME=app_session
SESSION_SECRET=0123456789012345678901234567890123456789012345678901234567890123
LIMEN_SECRET=0123456789012345678901234567890123456789012345678901234567890123
ALLOW_TEST_DB_HEADER=true
TEST_DB_HEADER_KEY=X-Database-Env
