package components

templ Dialog(id string, class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div id={ id } class={ "crm-dialog-overlay", extraClass }>
		{ children... }
	</div>
}

