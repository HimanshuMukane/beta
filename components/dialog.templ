package components

import (
	"components/utils"
)

templ Dialog(id string, class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		id={ id }
		data-slot="dialog-overlay"
		class={ utils.CN("crm-dialog-overlay fixed inset-0 isolate z-50 bg-black/60 supports-backdrop-filter:backdrop-blur-xs", extraClass) }
	>
		{ children... }
	</div>
}

templ DialogContent(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		role="dialog"
		data-slot="dialog-content"
		class={ utils.CN("crm-dialog-content bg-popover text-popover-foreground ring-foreground/10 grid max-w-[calc(100%-2rem)] gap-4 rounded-xl p-4 text-sm ring-1 sm:max-w-md fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none", extraClass) }
	>
		{ children... }
	</div>
}

templ DialogHeader(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		data-slot="dialog-header"
		class={ utils.CN("crm-dialog-header gap-1.5 flex flex-col", extraClass) }
	>
		{ children... }
	</div>
}

templ DialogTitle(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<h3
		data-slot="dialog-title"
		class={ utils.CN("crm-dialog-title text-base leading-none font-medium font-heading", extraClass) }
	>
		{ children... }
	</h3>
}

templ DialogDescription(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<p
		data-slot="dialog-description"
		class={ utils.CN("crm-dialog-desc text-muted-foreground text-sm", extraClass) }
	>
		{ children... }
	</p>
}

templ DialogBody(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		data-slot="dialog-body"
		class={ utils.CN("crm-dialog-body py-2 flex flex-col gap-4", extraClass) }
	>
		{ children... }
	</div>
}

templ DialogFooter(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div
		data-slot="dialog-footer"
		class={ utils.CN("crm-dialog-footer bg-muted/50 -mx-4 -mb-4 rounded-b-xl border-t p-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end", extraClass) }
	>
		{ children... }
	</div>
}
