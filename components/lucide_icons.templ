package components

templ IconLayout(size int, extraClass string) {
	<svg class={ extraClass } width={ templ.EscapeString(string(rune('0' + size/10)) + string(rune('0' + size%10))) } height={ templ.EscapeString(string(rune('0' + size/10)) + string(rune('0' + size%10))) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect width="18" height="18" x="3" y="3" rx="2"></rect>
		<path d="M3 9h18"></path>
		<path d="M9 21V9"></path>
	</svg>
}

