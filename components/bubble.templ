package components

type BubbleVariant string

const (
	BubbleVariantDefault     BubbleVariant = "default"
	BubbleVariantSecondary   BubbleVariant = "secondary"
	BubbleVariantMuted       BubbleVariant = "muted"
	BubbleVariantTinted      BubbleVariant = "tinted"
	BubbleVariantOutline     BubbleVariant = "outline"
	BubbleVariantGhost       BubbleVariant = "ghost"
	BubbleVariantDestructive BubbleVariant = "destructive"
)

type BubbleProps struct {
	ID      string
	Class   string
	Variant BubbleVariant
}

type BubbleGroupProps struct {
	ID    string
	Class string
}

type BubbleContentProps struct {
	ID    string
	Class string
}

type BubbleReactionsProps struct {
	ID    string
	Class string
}

templ BubbleGroup(props ...BubbleGroupProps) {
	{{ var p BubbleGroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-group"
		class={ "cn-bubble-group", p.Class }
	>
		{ children... }
	</div>
}

func bubbleVariantClass(v BubbleVariant) string {
	switch v {
	case BubbleVariantSecondary:
		return "cn-bubble-variant-secondary"
	case BubbleVariantMuted:
		return "cn-bubble-variant-muted"
	case BubbleVariantTinted:
		return "cn-bubble-variant-tinted"
	case BubbleVariantOutline:
		return "cn-bubble-variant-outline"
	case BubbleVariantGhost:
		return "cn-bubble-variant-ghost"
	case BubbleVariantDestructive:
		return "cn-bubble-variant-destructive"
	default:
		return "cn-bubble-variant-default"
	}
}

templ Bubble(props ...BubbleProps) {
	{{ var p BubbleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble"
		data-variant={ string(p.Variant) }
		class={ "cn-bubble", "group/bubble", bubbleVariantClass(p.Variant), p.Class }
	>
		{ children... }
	</div>
}

templ BubbleContent(props ...BubbleContentProps) {
	{{ var p BubbleContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-content"
		class={ "cn-bubble-content", p.Class }
	>
		{ children... }
	</div>
}

templ BubbleReactions(props ...BubbleReactionsProps) {
	{{ var p BubbleReactionsProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-reactions"
		class={ "cn-bubble-reactions", p.Class }
	>
		{ children... }
	</div>
}
