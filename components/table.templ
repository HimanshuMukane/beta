package components

import (
	"components/utils"
)

type TableProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ Table(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div data-slot="table-container" class={ utils.CN("crm-table-container relative w-full overflow-x-auto", extraClass) }>
		<table
			data-slot="table"
			class="crm-table w-full caption-bottom text-sm"
		>
			{ children... }
		</table>
	</div>
}

templ TableHead(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<thead
		data-slot="table-header"
		class={ utils.CN("[&_tr]:border-b", extraClass) }
	>
		<tr>
			{ children... }
		</tr>
	</thead>
}

templ TableBody(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<tbody
		data-slot="table-body"
		class={ utils.CN("[&_tr:last-child]:border-0", extraClass) }
	>
		{ children... }
	</tbody>
}

templ TableFooter(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<tfoot
		data-slot="table-footer"
		class={ utils.CN("bg-muted/50 border-t font-medium [&>tr]:last:border-b-0", extraClass) }
	>
		{ children... }
	</tfoot>
}

templ TableRow(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<tr
		data-slot="table-row"
		class={ utils.CN("hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors has-aria-expanded:bg-muted/50", extraClass) }
	>
		{ children... }
	</tr>
}

templ TableCell(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<td
		data-slot="table-cell"
		class={ utils.CN("p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&:has([data-slot=checkbox])]:pr-0", extraClass) }
	>
		{ children... }
	</td>
}

templ TableHeaderCell(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<th
		data-slot="table-head"
		class={ utils.CN("text-foreground h-10 px-2 text-left align-middle font-medium whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&:has([data-slot=checkbox])]:pr-0", extraClass) }
	>
		{ children... }
	</th>
}
