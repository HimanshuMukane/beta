package components

templ Table(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<div class={ "crm-table-container", extraClass }>
		<table class="crm-table">
			{ children... }
		</table>
	</div>
}

templ TableHead(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<thead class={ extraClass }>
		<tr>
			{ children... }
		</tr>
	</thead>
}

templ TableBody(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<tbody class={ extraClass }>
		{ children... }
	</tbody>
}

templ TableRow(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<tr class={ extraClass }>
		{ children... }
	</tr>
}

templ TableCell(class ...string) {
	{{
		extraClass := ""
		if len(class) > 0 {
			extraClass = class[0]
		}
	}}
	<td class={ extraClass }>
