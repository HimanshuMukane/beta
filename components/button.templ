package components

import (
	"components/utils"
)

type ButtonVariant string
type ButtonSize string
type ButtonType string

const (
	ButtonVariantDefault     ButtonVariant = "default"
	ButtonVariantDestructive ButtonVariant = "destructive"
	ButtonVariantOutline     ButtonVariant = "outline"
	ButtonVariantSecondary   ButtonVariant = "secondary"
	ButtonVariantGhost       ButtonVariant = "ghost"
	ButtonVariantLink        ButtonVariant = "link"
)

const (
	ButtonTypeButton ButtonType = "button"
	ButtonTypeReset  ButtonType = "reset"
	ButtonTypeSubmit ButtonType = "submit"
)

const (
	ButtonSizeDefault ButtonSize = "default"
	ButtonSizeXs      ButtonSize = "xs"
	ButtonSizeSm      ButtonSize = "sm"
	ButtonSizeLg      ButtonSize = "lg"
	ButtonSizeIcon    ButtonSize = "icon"
	ButtonSizeIconXs  ButtonSize = "icon-xs"
	ButtonSizeIconSm  ButtonSize = "icon-sm"
	ButtonSizeIconLg  ButtonSize = "icon-lg"
)

type ButtonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    ButtonVariant
	Size       ButtonSize
	Href       string
	Target     string
	Disabled   bool
	Type       ButtonType
	Form       string
}

const buttonBaseClasses = "focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 rounded-lg border border-transparent bg-clip-padding text-sm font-medium focus-visible:ring-3 aria-invalid:ring-3 active:not-aria-[haspopup]:translate-y-px [&_svg:not([class*='size-'])]:size-4 group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"

func buttonVariantClasses(v ButtonVariant) string {
	switch v {
	case ButtonVariantDestructive:
		return "bg-destructive/10 hover:bg-destructive/20 focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/20 text-destructive focus-visible:border-destructive/40 dark:hover:bg-destructive/30"
	case ButtonVariantOutline:
		return "border-border bg-background hover:bg-muted hover:text-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 aria-expanded:bg-muted aria-expanded:text-foreground"
	case ButtonVariantSecondary:
		return "bg-secondary text-secondary-foreground hover:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)] aria-expanded:bg-secondary aria-expanded:text-secondary-foreground"
	case ButtonVariantGhost:
		return "hover:bg-muted hover:text-foreground dark:hover:bg-muted/50 aria-expanded:bg-muted aria-expanded:text-foreground"
	case ButtonVariantLink:
		return "text-primary underline-offset-4 hover:underline"
	default:
		return "bg-primary text-primary-foreground hover:bg-primary/80"
	}
}

func buttonSizeClasses(s ButtonSize) string {
	switch s {
	case ButtonSizeXs:
		return "h-6 gap-1 rounded-[min(var(--radius-md),10px)] px-2 text-xs in-data-[slot=button-group]:rounded-lg has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3"
	case ButtonSizeSm:
		return "h-7 gap-1 rounded-[min(var(--radius-md),12px)] px-2.5 text-[0.8rem] in-data-[slot=button-group]:rounded-lg has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3.5"
	case ButtonSizeLg:
		return "h-9 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2"
	case ButtonSizeIcon:
		return "size-8"
	case ButtonSizeIconXs:
		return "size-6 rounded-[min(var(--radius-md),10px)] in-data-[slot=button-group]:rounded-lg [&_svg:not([class*='size-'])]:size-3"
	case ButtonSizeIconSm:
		return "size-7 rounded-[min(var(--radius-md),12px)] in-data-[slot=button-group]:rounded-lg"
	case ButtonSizeIconLg:
		return "size-9"
	default:
		return "h-8 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2"
	}
}

templ ShadcnButton(props ...ButtonProps) {
	{{ var p ButtonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = ButtonTypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = ButtonVariantDefault }}
	}
	if p.Size == "" {
		{{ p.Size = ButtonSizeDefault }}
	}
	if p.Href != "" && !p.Disabled {
		<a
			if _, ok := p.Attributes["id"]; !ok && p.ID != "" {
				id={ p.ID }
			}
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			if _, ok := p.Attributes["data-slot"]; !ok {
				data-slot="button"
			}
			if _, ok := p.Attributes["role"]; !ok {
				role="button"
			}
			if _, ok := p.Attributes["tabindex"]; !ok {
				tabindex="0"
			}
			class={ utils.CN(buttonBaseClasses, buttonVariantClasses(p.Variant), buttonSizeClasses(p.Size), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			if _, ok := p.Attributes["id"]; !ok && p.ID != "" {
				id={ p.ID }
			}
			if _, ok := p.Attributes["data-slot"]; !ok {
				data-slot="button"
			}
			if _, ok := p.Attributes["tabindex"]; !ok {
				tabindex="0"
			}
			class={ utils.CN(buttonBaseClasses, buttonVariantClasses(p.Variant), buttonSizeClasses(p.Size), p.Class) }
			if _, ok := p.Attributes["type"]; !ok && p.Type != "" {
				type={ string(p.Type) }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			disabled?={ p.Disabled }
			data-disabled?={ p.Disabled }
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}

templ Button(label string, variant string) {
	<button class={ utils.CN(buttonBaseClasses, "c-btn", variant) } type="submit" data-slot="button">
		{ label }
	</button>
}

templ ButtonSm(label string, variant string) {
	<button class={ utils.CN(buttonBaseClasses, "c-btn c-btn-sm", variant) } type="button" data-slot="button">
		{ label }
	</button>
}
