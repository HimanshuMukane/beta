templ responsiveContainer() {
	<div class="recharts-responsive-container" style="width:100%;height:100%;min-width:0">
		<div style="width:0;height:0;overflow:visible">
			<div class="recharts-wrapper" style="position:relative;cursor:default">
				{ children... }
			</div>
		</div>
	</div>
}

templ chartOutput(st *chartState) {
	{{ m := buildModel(ctx, st) }}
	@templ.Raw(ModelScript(m))
	if st.legend != nil {
		@legendContent(legendItems(configFrom(ctx), m, st, st.legend), st.legend)
	}
}

