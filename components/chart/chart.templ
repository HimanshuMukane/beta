type Config []Series

type Series struct {
	Key   string
	Label string
	Color string

	Theme *SeriesTheme

	Icon templ.Component
}

type SeriesTheme struct {
	Light string
	Dark  string
}

func (c Config) styleBlock(id string) string {
	hasColor := false
	for _, s := range c {
		if s.Color != "" || s.Theme != nil {
			hasColor = true
			break
		}
	}
	if !hasColor {
		return ""
	}
	var sb strings.Builder
	for _, theme := range []struct{ Name, Prefix string }{{"light", ""}, {"dark", ".dark "}} {
		fmt.Fprintf(&sb, "%s[data-chart=%s] {\n", theme.Prefix, id)
		for _, s := range c {
			color := s.Color
			if s.Theme != nil {
				themed := s.Theme.Light
				if theme.Name == "dark" {
					themed = s.Theme.Dark
				}
				if themed != "" {
					color = themed
				}
			}
			if color != "" {
				fmt.Fprintf(&sb, "  --color-%s: %s;\n", s.Key, color)
			}
		}
		sb.WriteString("}\n")
	}
	return sb.String()
}

type ContainerProps struct {

	ID         string
	Config     Config
	Class      string
	Attributes templ.Attributes
}

type StyleProps struct {
	ID     string
	Config Config
}

templ Style(props ...StyleProps) {
	{{ var p StyleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if block := p.Config.styleBlock(p.ID); block != "" {
		@templ.Raw("<style>" + block + "</style>")
	}
}

templ Container(props ...ContainerProps) {
	{{ var p ContainerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
	id := p.ID
	if id == "" {
		id = utils.RandomID()
	}
	chartID := "chart-" + id

	ctx = context.WithValue(ctx, configCtxKey, p.Config)
	}}
	<div
		data-slot="chart"
		data-chart={ chartID }
		class={ utils.CN(
			"cn-chart flex aspect-video justify-center text-xs [&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground [&_.recharts-cartesian-grid_line[stroke='#ccc']]:stroke-border/50 [&_.recharts-curve.recharts-tooltip-cursor]:stroke-border [&_.recharts-dot[stroke='#fff']]:stroke-transparent [&_.recharts-layer]:outline-hidden [&_.recharts-polar-grid_[stroke='#ccc']]:stroke-border [&_.recharts-radial-bar-background-sector]:fill-muted [&_.recharts-rectangle.recharts-tooltip-cursor]:fill-muted [&_.recharts-reference-line_[stroke='#ccc']]:stroke-border [&_.recharts-sector]:outline-hidden [&_.recharts-sector[stroke='#fff']]:stroke-transparent [&_.recharts-surface]:outline-hidden",
			p.Class,
		) }
		{ p.Attributes... }
	>
		if block := p.Config.styleBlock(chartID); block != "" {
			@templ.Raw("<style>" + block + "</style>")
		}
		{ children... }
	</div>
}

type Datum map[string]any

type Margin struct {
	Top, Right, Bottom, Left float64
}

type CurveType string

const (
	CurveNatural  CurveType = "natural"
	CurveMonotone CurveType = "monotone"
	CurveLinear   CurveType = "linear"
	CurveStep     CurveType = "step"
)

type CartesianGridProps struct {
	Horizontal *bool
	Vertical   *bool
}

func Bool(v bool) *bool {
	return &v
}

func Float(v float64) *float64 {
	return &v
}

func Index(i int) *int {
	return &i
}

func boolOr(v *bool, def bool) bool {
	if v == nil {
		return def
	}
	return *v
}

